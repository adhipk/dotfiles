#!/usr/bin/env bash
set -euo pipefail
ORIGINAL_UMASK=$(umask)
umask 077

PROGRAM="dotfiles-uninstall"
ROOT_INPUT="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
DESTINATION="$(cd -P "${HOME:?HOME is required}" && pwd)"
STATE_HOME_INPUT="${XDG_STATE_HOME:-$DESTINATION/.local/state}"
CONFIRMATION="REMOVE DOTFILES FROM $DESTINATION"
RESTORE_CONFIRMATION="RESTORE DOTFILES TO $DESTINATION"
REMOVE_BIN="${DOTFILES_UNINSTALL_REMOVE_BIN:-rm}"
TMP=""
STATE_DIR=""
RUN_DIR=""
RUN_ID=""
LEDGER=""
RUN_ERROR=""
RUN_PHASE="execute"
RUN_FINAL=false
REPO_LOCK=""
STATE_LOCK=""
REPO_LOCK_HELD=false
STATE_LOCK_HELD=false

die() {
    RUN_ERROR="$*"
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

ledger_apply() {
    local temporary
    [[ -n "$LEDGER" && -f "$LEDGER" ]] || return 1
    temporary="$LEDGER.tmp.$$"
    jq "$@" "$LEDGER" >"$temporary" || { command rm -f "$temporary"; return 1; }
    chmod 600 "$temporary"
    mv -f "$temporary" "$LEDGER"
}

record_failure() {
    local status=$1
    [[ -n "$RUN_DIR" && -d "$RUN_DIR" ]] || return 0
    umask 077
    printf '%s\n' "${RUN_ERROR:-operation exited with status $status}" >"$RUN_DIR/failure.txt" 2>/dev/null || true
    chmod 600 "$RUN_DIR/failure.txt" 2>/dev/null || true
    if [[ -f "$LEDGER" ]]; then
        if [[ "$RUN_PHASE" == "restore" ]]; then
            ledger_apply --arg error "${RUN_ERROR:-restore exited with status $status}" \
                --argjson at "$(date +%s)" '.restoreStatus="failed" | .restoreError=$error | .restoreFailedAt=$at' >/dev/null 2>&1 || true
        else
            ledger_apply --arg error "${RUN_ERROR:-operation exited with status $status}" \
                --argjson at "$(date +%s)" '.status="failed" | .error=$error | .failedAt=$at' >/dev/null 2>&1 || true
        fi
    fi
}

cleanup() {
    local status=$?
    trap - EXIT HUP INT TERM
    if [[ "$RUN_FINAL" != true && "$status" -ne 0 ]]; then
        record_failure "$status"
    fi
    if [[ "$STATE_LOCK_HELD" == true ]]; then
        dotfiles_lock_release "$STATE_LOCK" >/dev/null 2>&1 || true
    fi
    if [[ "$REPO_LOCK_HELD" == true ]]; then
        dotfiles_lock_release "$REPO_LOCK" >/dev/null 2>&1 || true
    fi
    [[ -z "$TMP" ]] || command rm -rf "$TMP"
    exit "$status"
}

signal_exit() {
    RUN_ERROR="interrupted by $1"
    exit "$2"
}

trap cleanup EXIT
trap 'signal_exit HUP 129' HUP
trap 'signal_exit INT 130' INT
trap 'signal_exit TERM 143' TERM

[[ -d "$ROOT_INPUT" ]] || die "invalid source repository: $ROOT_INPUT"
ROOT="$(cd -P "$ROOT_INPUT" && pwd)"
LIB_DIR="$ROOT/home/dot_local/lib/dotfiles"
[[ -d "$ROOT/home" && -f "$ROOT/.chezmoiroot" ]] || die "invalid source repository: $ROOT"
[[ -r "$LIB_DIR/core.sh" && -r "$LIB_DIR/locks.sh" ]] || die "shared dotfiles lock library is unavailable"
# shellcheck source=/dev/null
source "$LIB_DIR/core.sh"
# shellcheck source=/dev/null
source "$LIB_DIR/locks.sh"

need chezmoi
need jq
need yq
need cksum
need "$REMOVE_BIN"

[[ "$DESTINATION" == /* && "$ROOT" == /* && "$STATE_HOME_INPUT" == /* ]] || die "HOME, source, and state paths must be absolute"

chezmoi_cmd() (
    # Private backup creation must not change Chezmoi's target-mode checks.
    umask "$ORIGINAL_UMASK"
    command chezmoi "$@"
)

make_temp() {
    [[ -n "$TMP" ]] || TMP=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-uninstall.XXXXXX")
    chmod 700 "$TMP"
}

# Refuse symbolic links at any existing backup/lock path component. The target
# deletion validator separately permits the final component to be a symlink.
assert_no_symlink_components() {
    local path="$1" remainder component current=""
    [[ "$path" == /* ]] || return 1
    remainder="${path#/}"
    while [[ -n "$remainder" ]]; do
        component="${remainder%%/*}"
        if [[ "$remainder" == */* ]]; then remainder="${remainder#*/}"; else remainder=""; fi
        [[ -n "$component" && "$component" != "." && "$component" != ".." ]] || return 1
        current="$current/$component"
        [[ ! -L "$current" ]] || return 1
    done
}

validate_relative() {
    local path="$1" kind="${2:-leaf}" parent relative component cursor
    [[ -n "$path" && "$path" != /* && "$path" != "." ]] || return 1
    [[ "$path" != *$'\n'* && "$path" != *$'\r'* ]] || return 1
    case "/$path/" in *'/../'*|*'/./'*|*'//'*) return 1 ;; esac

    parent=$(dirname "$path")
    cursor="$DESTINATION"
    relative="$parent"
    while [[ "$relative" != "." && -n "$relative" ]]; do
        component="${relative%%/*}"
        if [[ "$relative" == */* ]]; then relative="${relative#*/}"; else relative=""; fi
        [[ -n "$component" && "$component" != "." && "$component" != ".." ]] || return 1
        cursor="$cursor/$component"
        [[ ! -L "$cursor" ]] || return 1
    done
    if [[ "$kind" == "directory" ]]; then
        [[ ! -L "$DESTINATION/$path" ]] || return 1
    fi
}

prepare_preserved_inventory() {
    local extra_manifests="${1:-}" manifest spec relative prefix source_relative="" state_relative=""
    local -a manifests=()
    : >"$TMP/preserved-prefixes"
    : >"$TMP/preserved.jsonl"

    if [[ "$ROOT" == "$DESTINATION/"* ]]; then
        source_relative="${ROOT#"$DESTINATION/"}"
        printf '%s\n' "$source_relative" >>"$TMP/preserved-prefixes"
    fi
    printf '%s\n' projects >>"$TMP/preserved-prefixes"
    if [[ "$STATE_HOME_INPUT" == "$DESTINATION/"* ]]; then
        state_relative="${STATE_HOME_INPUT#"$DESTINATION/"}"
        printf '%s\n' "$state_relative" >>"$TMP/preserved-prefixes"
    fi

    for manifest in "$ROOT"/modules/*/module.yaml; do
        [[ -f "$manifest" ]] && manifests+=("$manifest")
    done
    if [[ -n "$extra_manifests" ]]; then
        for manifest in "$extra_manifests"/*.yaml; do
            [[ -f "$manifest" ]] && manifests+=("$manifest")
        done
    fi
    for manifest in "${manifests[@]}"; do
        [[ -f "$manifest" ]] || continue
        while IFS= read -r spec; do
            case "$spec" in
                '~/'*)
                    relative="${spec:2}"
                    prefix="$relative"
                    case "$prefix" in *'*'*) prefix="${prefix%%\**}" ;; esac
                    case "$prefix" in *'?'*) prefix="${prefix%%\?*}" ;; esac
                    case "$prefix" in *'['*) prefix="${prefix%%\[*}" ;; esac
                    prefix="${prefix%/}"
                    [[ -n "$prefix" ]] && printf '%s\n' "$prefix" >>"$TMP/preserved-prefixes"
                    ;;
            esac
            jq -cn --arg value "module state: $spec" '$value' >>"$TMP/preserved.jsonl"
        done < <(yq -r '.state.preserved[]?' "$manifest")
    done

    jq -cn --arg value "$ROOT" '$value' >>"$TMP/preserved.jsonl"
    jq -cn --arg value "$DESTINATION/projects" '$value' >>"$TMP/preserved.jsonl"
    jq -cn --arg value "$STATE_HOME_INPUT" '$value' >>"$TMP/preserved.jsonl"
    for spec in "shared Homebrew packages" "~/.tmux/plugins and other ambiguous installer side effects" "running tmux sessions and yabai/skhd services"; do
        jq -cn --arg value "$spec" '$value' >>"$TMP/preserved.jsonl"
    done
}

is_preserved() {
    local path="$1" prefix
    while IFS= read -r prefix; do
        [[ -n "$prefix" ]] || continue
        [[ "$path" == "$prefix" || "$path" == "$prefix/"* ]] && return 0
    done <"$TMP/preserved-prefixes"
    return 1
}

actual_type() {
    local target="$1"
    if [[ -L "$target" ]]; then printf 'symlink\n'
    elif [[ -f "$target" ]]; then printf 'file\n'
    elif [[ -d "$target" ]]; then printf 'directory\n'
    elif [[ -e "$target" ]]; then printf 'special\n'
    else printf 'missing\n'
    fi
}

fingerprint() {
    local target="$1" type
    type=$(actual_type "$target")
    case "$type" in
        missing) printf 'missing\n' ;;
        symlink) printf 'symlink:%s\n' "$(readlink "$target")" ;;
        file) printf 'file:%s:mode=%s\n' "$(cksum <"$target")" "$(stat_mode "$target")" ;;
        *) printf '%s\n' "$type" ;;
    esac
}

build_plan() {
    local output="$1" path target status type blockers targets changed preserved executable
    make_temp
    prepare_preserved_inventory
    : >"$TMP/targets.jsonl"
    : >"$TMP/changed.jsonl"
    : >"$TMP/blockers.jsonl"

    chezmoi_cmd -S "$ROOT" -D "$DESTINATION" managed --include=files,symlinks \
        --nul-path-separator --path-style=relative >"$TMP/leaves.nul"
    chezmoi_cmd -S "$ROOT" -D "$DESTINATION" managed --include=dirs \
        --nul-path-separator --path-style=relative >"$TMP/dirs.nul"

    while IFS= read -r -d '' path; do
        if ! validate_relative "$path" leaf; then
            jq -cn --arg path "$path" --arg reason "unsafe managed leaf path or symlinked parent" \
                '{path:$path,reason:$reason}' >>"$TMP/blockers.jsonl"
            continue
        fi
        if is_preserved "$path"; then
            jq -cn --arg path "$path" --arg reason "managed leaf overlaps preserved source, projects, or module state" \
                '{path:$path,reason:$reason}' >>"$TMP/blockers.jsonl"
            continue
        fi
        target="$DESTINATION/$path"
        type=$(actual_type "$target")
        case "$type" in
            missing) status="missing" ;;
            file|symlink)
                if chezmoi_cmd -S "$ROOT" -D "$DESTINATION" verify -- "$target" >/dev/null 2>&1; then status="clean"; else status="changed"; fi
                ;;
            *)
                status="changed"
                jq -cn --arg path "$path" --arg reason "managed leaf has unsafe actual type: $type" \
                    '{path:$path,reason:$reason}' >>"$TMP/blockers.jsonl"
                ;;
        esac
        [[ "$status" != changed ]] || jq -cn --arg path "$path" '$path' >>"$TMP/changed.jsonl"
        jq -cn --arg path "$path" --arg status "$status" --arg actualType "$type" \
            '{path:$path,type:"leaf",status:$status,actualType:$actualType}' >>"$TMP/targets.jsonl"
    done <"$TMP/leaves.nul"

    while IFS= read -r -d '' path; do
        if ! validate_relative "$path" directory; then
            jq -cn --arg path "$path" --arg reason "unsafe managed directory path or symlink" \
                '{path:$path,reason:$reason}' >>"$TMP/blockers.jsonl"
            continue
        fi
        is_preserved "$path" && continue
        jq -cn --arg path "$path" '{path:$path,type:"directory",status:"empty-only"}' >>"$TMP/targets.jsonl"
    done <"$TMP/dirs.nul"

    targets=$(jq -s '.' "$TMP/targets.jsonl")
    changed=$(jq -s '.' "$TMP/changed.jsonl")
    blockers=$(jq -s '.' "$TMP/blockers.jsonl")
    preserved=$(jq -s 'unique' "$TMP/preserved.jsonl")
    executable=$(jq -n --argjson blockers "$blockers" '$blockers | length == 0')
    jq -cn --arg operation system-uninstall --arg destination "$DESTINATION" --arg source "$ROOT" \
        --arg confirmation "$CONFIRMATION" --argjson targets "$targets" --argjson changedTargets "$changed" \
        --argjson preserved "$preserved" --argjson blockers "$blockers" --argjson executable "$executable" \
        '{schemaVersion:1,operation:$operation,destination:$destination,source:$source,targets:$targets,changedTargets:$changedTargets,backupPath:null,preserved:$preserved,blockers:$blockers,executable:$executable,confirmation:$confirmation}' >"$output"
    chmod 600 "$output"
}

show_plan() {
    local plan="$1"
    printf 'Plan: uninstall applied dotfiles from %s\n' "$DESTINATION"
    printf '  Managed targets: %s\n' "$(jq '.targets | length' "$plan")"
    printf '  Changed targets requiring backup: %s\n' "$(jq '.changedTargets | length' "$plan")"
    printf '  Safety blockers: %s\n' "$(jq '.blockers | length' "$plan")"
    printf '  Preserved by default:\n'
    jq -r '.preserved[] | "    - " + .' "$plan"
    printf '\nExact execution confirmation: %s\n' "$CONFIRMATION"
    printf 'Execution snapshots and backs up all existing managed leaves; changed leaves are always included.\n'
    printf 'Chezmoi destroy/purge/forget are never used.\n'
}

prepare_private_state() {
    [[ "$STATE_HOME_INPUT" != / ]] || die "state home must not be the filesystem root"
    assert_no_symlink_components "$STATE_HOME_INPUT" || die "state home contains a symbolic-link or unsafe component: $STATE_HOME_INPUT"
    [[ ! -L "$STATE_HOME_INPUT" ]] || die "state home must not be a symbolic link: $STATE_HOME_INPUT"
    mkdir -p "$STATE_HOME_INPUT"
    STATE_HOME="$(cd -P "$STATE_HOME_INPUT" && pwd)"
    if [[ "$STATE_HOME_INPUT" == "$DESTINATION" || "$STATE_HOME_INPUT" == "$DESTINATION/"* ]]; then
        [[ "$STATE_HOME" == "$DESTINATION" || "$STATE_HOME" == "$DESTINATION/"* ]] || die "state home escapes destination through a symbolic-link parent"
    fi
    STATE_DIR="$STATE_HOME/dotfiles/system-uninstall"
    [[ "$STATE_DIR" != "$ROOT" && "$STATE_DIR" != "$ROOT/"* ]] || die "backup root must not be inside the source repository"
    [[ "$STATE_DIR" != "$DESTINATION/projects" && "$STATE_DIR" != "$DESTINATION/projects/"* ]] || die "backup root must not be inside ~/projects"
    [[ ! -L "$STATE_HOME/dotfiles" && ! -L "$STATE_DIR" && ! -L "$STATE_DIR/runs" ]] || die "backup root contains a symbolic link: $STATE_DIR"
    mkdir -p "$STATE_DIR/runs"
    chmod 700 "$STATE_DIR" "$STATE_DIR/runs"
}

acquire_locks() {
    REPO_LOCK="$ROOT/.dotfiles-module.lock"
    STATE_LOCK="$STATE_DIR/execution.lock"
    [[ ! -L "$REPO_LOCK" && ! -L "$STATE_LOCK" ]] || die "refusing symbolic-link lifecycle lock"
    dotfiles_lock_acquire "$REPO_LOCK" 10000 || die "could not acquire repository lifecycle lock"
    REPO_LOCK_HELD=true
    dotfiles_lock_acquire "$STATE_LOCK" 10000 || die "could not acquire system uninstall lock"
    STATE_LOCK_HELD=true
}

new_run() {
    RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
    RUN_DIR="$STATE_DIR/runs/$RUN_ID"
    mkdir "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    LEDGER="$RUN_DIR/ledger.json"
}

snapshot_run() {
    local plan="$1" run_id="$2" manifest destination
    mkdir "$RUN_DIR/manifests" "$RUN_DIR/backup"
    chmod 700 "$RUN_DIR/manifests" "$RUN_DIR/backup"
    cp -p "$plan" "$RUN_DIR/plan.json"
    cp -p "$TMP/leaves.nul" "$RUN_DIR/managed-leaves.nul"
    cp -p "$TMP/dirs.nul" "$RUN_DIR/managed-dirs.nul"
    chmod 600 "$RUN_DIR/plan.json" "$RUN_DIR/managed-leaves.nul" "$RUN_DIR/managed-dirs.nul"
    for manifest in "$ROOT"/modules/*/module.yaml; do
        [[ -f "$manifest" ]] || continue
        destination="$RUN_DIR/manifests/$(basename "$(dirname "$manifest")").yaml"
        cp -p "$manifest" "$destination"
        chmod 600 "$destination"
    done
    jq --arg id "$run_id" --arg backupPath "$RUN_DIR/backup" --argjson startedAt "$(date +%s)" '
        .backupPath=$backupPath
        | . + {id:$id,status:"snapshot",startedAt:$startedAt,error:null,quiesce:{agentTimer:"pending"},restoreStatus:null}
        | .targets |= map(if .type=="leaf" then . + {fingerprint:null,backupStatus:"pending",removeStatus:"pending"} else . + {removeStatus:"pending",originalDirectoryStatus:null,mode:null} end)
      ' "$plan" >"$LEDGER"
    chmod 600 "$LEDGER"
}

target_update() {
    local path="$1" filter="$2" value="$3"
    ledger_apply --arg path "$path" --arg value "$value" "(.targets[] | select(.path==\$path)).$filter=\$value"
}

stat_mode() {
    local target="$1" mode
    mode=$(stat -f '%Lp' "$target" 2>/dev/null || true)
    [[ "$mode" =~ ^[0-7]+$ ]] || mode=$(stat -c '%a' "$target" 2>/dev/null || true)
    printf '%s\n' "$mode"
}

backup_existing_leaves() {
    local path target type backup fingerprint_value plan_status copied_fingerprint
    jq -j '.targets[] | select(.type=="leaf") | .path,"\u0000"' "$LEDGER" >"$TMP/validated-leaves.nul"
    while IFS= read -r -d '' path; do
        validate_relative "$path" leaf || die "managed path became unsafe before backup: $path"
        is_preserved "$path" && die "managed path became preserved before backup: $path"
        target="$DESTINATION/$path"
        type=$(actual_type "$target")
        if [[ "$type" == missing ]]; then
            target_update "$path" fingerprint missing
            target_update "$path" backupStatus original-missing
            continue
        fi
        [[ "$type" == file || "$type" == symlink ]] || die "refusing to back up non-leaf target: $path ($type)"
        backup="$RUN_DIR/backup/$path"
        mkdir -p "$(dirname "$backup")"
        chmod 700 "$(dirname "$backup")"
        cp -pP "$target" "$backup" || die "backup failed for $path"
        fingerprint_value=$(fingerprint "$target")
        copied_fingerprint=$(fingerprint "$backup")
        [[ "$fingerprint_value" == "$copied_fingerprint" ]] || die "backup verification failed for $path"
        plan_status=$(jq -r --arg path "$path" '.targets[] | select(.path==$path) | .status' "$LEDGER")
        target_update "$path" fingerprint "$fingerprint_value"
        target_update "$path" backupStatus "backed-up-$plan_status"
    done <"$TMP/validated-leaves.nul"
}

snapshot_directories() {
    local path target mode status
    jq -j '.targets[] | select(.type=="directory") | .path,"\u0000"' "$LEDGER" >"$TMP/validated-dirs.nul"
    while IFS= read -r -d '' path; do
        target="$DESTINATION/$path"
        if [[ -d "$target" && ! -L "$target" ]]; then status=present; mode=$(stat_mode "$target")
        elif [[ ! -e "$target" && ! -L "$target" ]]; then status=missing; mode=""
        else die "managed directory has unsafe actual type: $path"
        fi
        ledger_apply --arg path "$path" --arg status "$status" --arg mode "$mode" '
          (.targets[] | select(.path==$path)).originalDirectoryStatus=$status
          | (.targets[] | select(.path==$path)).mode=$mode
        '
    done <"$TMP/validated-dirs.nul"
}

preflight_fingerprints() {
    local path expected current
    jq -j '.targets[] | select(.type=="leaf") | .path,"\u0000"' "$LEDGER" >"$TMP/preflight.nul"
    while IFS= read -r -d '' path; do
        validate_relative "$path" leaf || die "managed path became unsafe after backup: $path"
        expected=$(jq -r --arg path "$path" '.targets[] | select(.path==$path) | .fingerprint' "$LEDGER")
        current=$(fingerprint "$DESTINATION/$path")
        [[ "$expected" == "$current" ]] || die "managed target changed after backup: $path"
    done <"$TMP/preflight.nul"
}

quiesce_runtime() {
    local timer="$DESTINATION/bin/agent-timer"
    if [[ -x "$timer" ]]; then
        "$timer" shutdown --reason system-uninstall || die "agent-timer refused to quiesce"
        ledger_apply '.quiesce.agentTimer="stopped"'
    else
        ledger_apply '.quiesce.agentTimer="not-installed"'
    fi
}

remove_one_leaf() {
    local path="$1" target expected current type
    validate_relative "$path" leaf || die "refusing unsafe removal path: $path"
    is_preserved "$path" && die "refusing preserved removal path: $path"
    target="$DESTINATION/$path"
    expected=$(jq -r --arg path "$path" '.targets[] | select(.path==$path) | .fingerprint' "$LEDGER")
    current=$(fingerprint "$target")
    [[ "$expected" == "$current" ]] || die "target changed during removal: $path"
    if [[ "$current" == missing ]]; then
        target_update "$path" removeStatus already-missing
        return
    fi
    type=$(actual_type "$target")
    [[ "$type" == file || "$type" == symlink ]] || die "refusing non-leaf removal: $path"
    "$REMOVE_BIN" -f -- "$target" || die "failed to remove managed leaf: $path"
    [[ ! -e "$target" && ! -L "$target" ]] || die "managed leaf remained after removal: $path"
    target_update "$path" removeStatus removed
}

remove_leaves() {
    local lifecycle="bin/dotfiles-module" self="bin/dotfiles-uninstall" path
    jq -j --arg lifecycle "$lifecycle" --arg self "$self" '
      .targets[] | select(.type=="leaf" and .path!=$lifecycle and .path!=$self) | .path,"\u0000"
    ' "$LEDGER" >"$TMP/remove-first.nul"
    while IFS= read -r -d '' path; do remove_one_leaf "$path"; done <"$TMP/remove-first.nul"
    for path in "$lifecycle" "$self"; do
        if jq -e --arg path "$path" '.targets[] | select(.type=="leaf" and .path==$path)' "$LEDGER" >/dev/null; then
            remove_one_leaf "$path"
        fi
    done
}

remove_empty_directories() {
    local path target content
    jq -j '[.targets[] | select(.type=="directory")] | sort_by(.path | split("/") | length) | reverse[] | .path,"\u0000"' \
        "$LEDGER" >"$TMP/remove-dirs.nul"
    while IFS= read -r -d '' path; do
        validate_relative "$path" directory || die "refusing unsafe managed directory: $path"
        is_preserved "$path" && die "refusing preserved managed directory: $path"
        target="$DESTINATION/$path"
        if [[ ! -e "$target" && ! -L "$target" ]]; then
            target_update "$path" removeStatus already-missing
        elif [[ -d "$target" && ! -L "$target" ]]; then
            if rmdir -- "$target" 2>/dev/null; then
                target_update "$path" removeStatus removed-empty
            else
                content=$(find "$target" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null || true)
                if [[ -n "$content" ]]; then target_update "$path" removeStatus preserved-nonempty
                else die "failed to remove empty managed directory: $path"
                fi
            fi
        else
            die "managed directory changed to unsafe type: $path"
        fi
    done <"$TMP/remove-dirs.nul"
}

execute_uninstall() {
    local json="$1" plan run_id blocker_count
    prepare_private_state
    acquire_locks
    make_temp
    plan="$TMP/execute-plan.json"
    build_plan "$plan"
    new_run
    run_id="$RUN_ID"
    snapshot_run "$plan" "$run_id"
    blocker_count=$(jq '.blockers | length' "$LEDGER")
    [[ "$blocker_count" -eq 0 ]] || die "uninstall plan has $blocker_count safety blocker(s); inspect $LEDGER"
    ledger_apply '.status="backing-up"'
    backup_existing_leaves
    snapshot_directories
    preflight_fingerprints
    ledger_apply '.status="quiescing"'
    quiesce_runtime
    ledger_apply '.status="removing"'
    remove_leaves
    remove_empty_directories
    ledger_apply --argjson at "$(date +%s)" '.status="complete" | .completedAt=$at | .error=null'
    RUN_FINAL=true
    if [[ "$json" == true ]]; then cat "$LEDGER"
    else
        printf 'Dotfiles target state removed.\nBackup and ledger: %s\n' "$RUN_DIR"
        printf 'Source, projects, module state, packages, plugins, sessions, and services were preserved.\n'
        printf 'Restore from the preserved source with: %s restore %s --confirm %q\n' "$PROGRAM" "$run_id" "$RESTORE_CONFIRMATION"
    fi
}

restore_one_leaf() {
    local path="$1" target backup expected current
    validate_relative "$path" leaf || die "unsafe backup ledger path: $path"
    is_preserved "$path" && die "backup ledger path now overlaps preserved data: $path"
    target="$DESTINATION/$path"
    backup="$RUN_DIR/backup/$path"
    expected=$(jq -r --arg path "$path" '.targets[] | select(.path==$path) | .fingerprint' "$LEDGER")
    current=$(fingerprint "$target")
    if [[ "$expected" == missing ]]; then
        [[ "$current" == missing ]] || die "refusing to remove a newly-created originally-missing target during restore: $path"
        return
    fi
    assert_no_symlink_components "$(dirname "$backup")" || die "backup payload has a symbolic-link parent: $path"
    [[ -f "$backup" || -L "$backup" ]] || die "missing backup payload: $path"
    [[ "$(fingerprint "$backup")" == "$expected" ]] || die "backup payload failed fingerprint validation: $path"
    if [[ "$current" == "$expected" ]]; then return; fi
    [[ "$current" == missing ]] || die "refusing to overwrite post-uninstall target during restore: $path"
    mkdir -p "$(dirname "$target")"
    validate_relative "$path" leaf || die "restore parent became unsafe: $path"
    cp -pP "$backup" "$target" || die "failed restoring $path"
    [[ "$(fingerprint "$target")" == "$expected" ]] || die "restored target failed validation: $path"
}

restore_run() {
    local run_id="$1" json="$2" path status source destination mode timer
    [[ "$run_id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]] || die "invalid run id: $run_id"
    RUN_PHASE=restore
    prepare_private_state
    acquire_locks
    make_temp
    RUN_DIR="$STATE_DIR/runs/$run_id"
    [[ ! -L "$RUN_DIR" && ! -L "$RUN_DIR/ledger.json" && ! -L "$RUN_DIR/backup" ]] || die "restore run path contains a symbolic link"
    [[ -d "$RUN_DIR" && -f "$RUN_DIR/ledger.json" ]] || die "unknown uninstall run: $run_id"
    LEDGER="$RUN_DIR/ledger.json"
    chmod 600 "$LEDGER"
    source=$(jq -r '.source' "$LEDGER")
    destination=$(jq -r '.destination' "$LEDGER")
    [[ "$source" == "$ROOT" && "$destination" == "$DESTINATION" ]] || die "run source or destination does not match this invocation"
    prepare_preserved_inventory "$RUN_DIR/manifests"
    ledger_apply --argjson at "$(date +%s)" '.restoreStatus="restoring" | .restoreStartedAt=$at | .restoreError=null'

    jq -j '[.targets[] | select(.type=="directory")] | sort_by(.path | split("/") | length)[] | .path,"\u0000"' \
        "$LEDGER" >"$TMP/restore-dirs.nul"
    while IFS= read -r -d '' path; do
        validate_relative "$path" directory || die "unsafe directory in backup ledger: $path"
        status=$(jq -r --arg path "$path" '.targets[] | select(.path==$path) | .originalDirectoryStatus' "$LEDGER")
        if [[ "$status" == present ]]; then
            if [[ -d "$DESTINATION/$path" && ! -L "$DESTINATION/$path" ]]; then
                : # Preserve mode and contents of a directory created after uninstall.
            elif [[ ! -e "$DESTINATION/$path" && ! -L "$DESTINATION/$path" ]]; then
                mkdir -p "$DESTINATION/$path"
                validate_relative "$path" directory || die "restored directory parent became unsafe: $path"
                mode=$(jq -r --arg path "$path" '.targets[] | select(.path==$path) | .mode' "$LEDGER")
                [[ "$mode" =~ ^[0-7]+$ ]] && chmod "$mode" "$DESTINATION/$path"
            else
                die "refusing to replace post-uninstall path while restoring directory: $path"
            fi
        fi
    done <"$TMP/restore-dirs.nul"

    jq -j '.targets[] | select(.type=="leaf") | .path,"\u0000"' "$LEDGER" >"$TMP/restore-leaves.nul"
    while IFS= read -r -d '' path; do restore_one_leaf "$path"; done <"$TMP/restore-leaves.nul"
    timer="$DESTINATION/bin/agent-timer"
    if [[ -x "$timer" ]]; then
        "$timer" enable || die "targets restored but agent-timer could not be re-enabled"
    fi
    ledger_apply --argjson at "$(date +%s)" '.restoreStatus="complete" | .restoredAt=$at | .restoreError=null'
    command rm -f "$RUN_DIR/failure.txt"
    RUN_FINAL=true
    if [[ "$json" == true ]]; then cat "$LEDGER"; else printf 'Restored managed targets from %s\n' "$RUN_DIR"; fi
}

usage() {
    cat <<EOF
Usage:
  $PROGRAM [plan [--json]]
  $PROGRAM execute --confirm '$CONFIRMATION' [--json]
  $PROGRAM restore RUN_ID --confirm '$RESTORE_CONFIRMATION' [--json]
EOF
}

case "${1:-plan}" in
    plan)
        shift || true
        json=false
        if [[ "${1:-}" == --json ]]; then json=true; shift; fi
        [[ $# -eq 0 ]] || { usage; exit 2; }
        make_temp
        build_plan "$TMP/plan.json"
        if [[ "$json" == true ]]; then cat "$TMP/plan.json"; else show_plan "$TMP/plan.json"; fi
        ;;
    execute)
        shift
        [[ "${1:-}" == --confirm && -n "${2:-}" ]] || die "execution requires --confirm '$CONFIRMATION'"
        [[ "$2" == "$CONFIRMATION" ]] || die "confirmation did not exactly match: $CONFIRMATION"
        shift 2
        json=false
        if [[ "${1:-}" == --json ]]; then json=true; shift; fi
        [[ $# -eq 0 ]] || { usage; exit 2; }
        execute_uninstall "$json"
        ;;
    restore)
        shift
        run_id="${1:-}"; shift || true
        [[ "${1:-}" == --confirm && -n "${2:-}" ]] || die "restore requires --confirm '$RESTORE_CONFIRMATION'"
        [[ "$2" == "$RESTORE_CONFIRMATION" ]] || die "confirmation did not exactly match: $RESTORE_CONFIRMATION"
        shift 2
        json=false
        if [[ "${1:-}" == --json ]]; then json=true; shift; fi
        [[ $# -eq 0 ]] || { usage; exit 2; }
        restore_run "$run_id" "$json"
        ;;
    -h|--help) usage ;;
    *) usage; exit 2 ;;
esac

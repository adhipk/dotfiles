#!/bin/zsh
# man-me: name=setup-yabai-sa
# man-me: category=Window and Display
# man-me: usage=setup-yabai-sa
# man-me: description=Authorize and load yabai's scripting addition for the currently installed binary.
# man-me: tags=yabai scripting addition sudoers spaces bootstrap macos

set -euo pipefail

YABAI_BIN="${YABAI_BIN:-$(command -v yabai || true)}"
SUDOERS_FILE="${YABAI_SUDOERS_FILE:-/private/etc/sudoers.d/yabai}"
SUDO_BIN="${SUDO_BIN:-sudo}"
SHASUM_BIN="${SHASUM_BIN:-/usr/bin/shasum}"
AWK_BIN="${AWK_BIN:-/usr/bin/awk}"
ID_BIN="${ID_BIN:-/usr/bin/id}"
MKTEMP_BIN="${MKTEMP_BIN:-/usr/bin/mktemp}"
RM_BIN="${RM_BIN:-/bin/rm}"
VISUDO_BIN="${VISUDO_BIN:-/usr/sbin/visudo}"
INSTALL_BIN="${INSTALL_BIN:-/usr/bin/install}"
TEMP_RULE=""

cleanup() {
  [[ -z "$TEMP_RULE" ]] || "$RM_BIN" -f "$TEMP_RULE"
}
trap cleanup EXIT

if [[ -z "$YABAI_BIN" || ! -x "$YABAI_BIN" ]]; then
  echo "setup-yabai-sa: yabai is not installed." >&2
  exit 1
fi

YABAI_SHA256=$("$SHASUM_BIN" -a 256 "$YABAI_BIN" | "$AWK_BIN" '{print $1}')
SUDOERS_RULE="$("$ID_BIN" -un) ALL=(root) NOPASSWD: sha256:$YABAI_SHA256 $YABAI_BIN --load-sa"

TEMP_RULE=$("$MKTEMP_BIN" "${TMPDIR:-/tmp}/yabai-sudoers.XXXXXX")
printf '%s\n' "$SUDOERS_RULE" > "$TEMP_RULE"
"$SUDO_BIN" "$VISUDO_BIN" -cf "$TEMP_RULE" >/dev/null
"$SUDO_BIN" "$INSTALL_BIN" -o root -g wheel -m 0440 "$TEMP_RULE" "$SUDOERS_FILE"

if ! "$SUDO_BIN" "$YABAI_BIN" --load-sa; then
  echo "setup-yabai-sa: scripting addition load failed. Complete yabai's SIP setup, reboot, and rerun this command." >&2
  exit 1
fi

"$YABAI_BIN" --restart-service
echo "setup-yabai-sa: scripting addition authorized and loaded."

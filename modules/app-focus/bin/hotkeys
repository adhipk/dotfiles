#!/usr/bin/env bash
# man-me: name=hotkeys
# man-me: category=Hotkeys and Keybindings
# man-me: usage=hotkeys app-focus SLOT APP; hotkeys zen on|off|toggle|status; hotkeys terminal new
# man-me: description=Shared skhd action router for app focus, zen mode, presentation mode, and terminal spawning.
# man-me: tags=hotkeys hotkey keyboard shortcut shortcuts keybinding keybindings skhd zen presentation app-focus terminal

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -r "$SCRIPT_DIR/../lib/config.sh" ]]; then
  DEFAULT_CONFIG_LIB="$SCRIPT_DIR/../lib/config.sh"
else
  DEFAULT_CONFIG_LIB="$HOME/.config/app-focus/config.sh"
fi
APP_FOCUS_CONFIG_LIB="${APP_FOCUS_CONFIG_LIB:-$DEFAULT_CONFIG_LIB}"
if [[ ! -r "$APP_FOCUS_CONFIG_LIB" ]]; then
  printf 'hotkeys: missing app-focus config adapter: %s\n' "$APP_FOCUS_CONFIG_LIB" >&2
  exit 1
fi
# shellcheck source=../lib/config.sh
source "$APP_FOCUS_CONFIG_LIB"

STATE_DIRECTORY=$(app_focus_state_directory)
PRESENTATION_MODE_FILE="$STATE_DIRECTORY/presentation_mode"
ZEN_MODE_FILE="$STATE_DIRECTORY/zen_mode"
ZEN_BLOCKED_SLOTS="${ZEN_BLOCKED_SLOTS:-$(app_focus_config_list '.modes.zen_blocked_slots' '3 4 5')}"
TERMINAL_APP="${TERMINAL_APP:-$(app_focus_config_string '.apps.terminal' 'Ghostty')}"
NOTIFICATION_PATH=$(app_focus_config_string '.integrations.notification_command' '.config/skhd/notify.sh')
APP_FOCUS_NOTIFY_COMMAND="${APP_FOCUS_NOTIFY_COMMAND:-$(app_focus_home_path "$NOTIFICATION_PATH")}"

usage() {
  cat <<'EOF'
Usage:
  hotkeys app-focus SLOT APP
  hotkeys presentation toggle
  hotkeys zen on|off|toggle|status
  hotkeys terminal new
EOF
}

notify() {
  if [[ -x "$APP_FOCUS_NOTIFY_COMMAND" ]]; then
    "$APP_FOCUS_NOTIFY_COMMAND" "$1" "$2" || true
  fi
}

mode_is_on() {
  local state_file="$1"

  [ -f "$state_file" ] && [ "$(cat "$state_file" 2>/dev/null)" = "on" ]
}

set_mode_state() {
  local state_file="$1"
  local label="$2"
  local state="$3"

  case "$state" in
    on|off) ;;
    *)
      printf '%s\n' "Expected mode state to be on or off; got: $state" >&2
      exit 1
      ;;
  esac

  mkdir -p "$(dirname "$state_file")"
  printf '%s\n' "$state" > "$state_file"
  if [ "$state" = "on" ]; then
    notify "skhd" "$label mode on"
  else
    notify "skhd" "$label mode off"
  fi
}

set_presentation_mode() {
  set_mode_state "$PRESENTATION_MODE_FILE" "Presentation" "$1"
}

toggle_presentation_mode() {
  if mode_is_on "$PRESENTATION_MODE_FILE"; then
    set_presentation_mode off
  else
    set_presentation_mode on
  fi
}

set_zen_mode() {
  set_mode_state "$ZEN_MODE_FILE" "Zen" "$1"
}

toggle_zen_mode() {
  if mode_is_on "$ZEN_MODE_FILE"; then
    set_zen_mode off
  else
    set_zen_mode on
  fi
}

print_zen_status() {
  if mode_is_on "$ZEN_MODE_FILE"; then
    printf '%s\n' "on"
  else
    printf '%s\n' "off"
  fi
}

slot_is_zen_blocked() {
  local slot="$1"
  local blocked

  for blocked in $ZEN_BLOCKED_SLOTS; do
    [[ "$slot" == "$blocked" ]] && return 0
  done
  return 1
}

app_focus() {
  local slot="${1:-}"

  if [ -z "$slot" ]; then
    usage >&2
    exit 1
  fi
  shift

  if [ "$#" -eq 0 ]; then
    usage >&2
    exit 1
  fi

  if mode_is_on "$ZEN_MODE_FILE" && slot_is_zen_blocked "$slot"; then
    exit 0
  fi

  "$HOME/.config/skhd/focus_app.sh" "$@"
}

open_terminal_window() {
  local terminal_app="$TERMINAL_APP"
  local current_space
  local current_display
  local before_json="[]"

  current_space=$(yabai -m query --spaces --space | jq -r '.index')
  current_display=$(yabai -m query --displays --display | jq -r '.index')

  # Prevent key-repeat storms from spawning many windows on long key holds.
  local lock_dir="/tmp/open_terminal_window.lock"
  local state_file="/tmp/open_terminal_window.last_ms"
  local cooldown_ms=1200
  local stale_lock_after_s=10

  if ! mkdir "$lock_dir" 2>/dev/null; then
    local lock_mtime now_s
    lock_mtime=$(stat -f '%m' "$lock_dir" 2>/dev/null || printf '0\n')
    now_s=$(date +%s)
    if [[ "$lock_mtime" =~ ^[0-9]+$ ]] && (( now_s - lock_mtime > stale_lock_after_s )); then
      rmdir "$lock_dir" 2>/dev/null || true
      mkdir "$lock_dir" 2>/dev/null || exit 0
    else
      exit 0
    fi
  fi
  trap "rmdir '$lock_dir'" EXIT

  local now_ms last_ms
  now_ms=$(perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000')
  if [ -f "$state_file" ]; then
    last_ms=$(cat "$state_file" 2>/dev/null || echo 0)
    if [[ "$last_ms" =~ ^[0-9]+$ ]] && (( now_ms - last_ms < cooldown_ms )); then
      exit 0
    fi
  fi
  printf '%s\n' "$now_ms" > "$state_file"

  local rule_label="temp_terminal_rule_$$"
  yabai -m rule --add app="^${terminal_app}$" space="$current_space" label="$rule_label"

  before_json=$(yabai -m query --windows | jq -c --arg app "$terminal_app" '[ .[] | select(.app == $app) | .id ]')

  if [ "$terminal_app" = "Ghostty" ]; then
    env -u ZDOTDIR open -n -a "$terminal_app"
  elif [ "$terminal_app" = "iTerm2" ]; then
    /usr/bin/osascript -e 'tell application "iTerm2" to create window with default profile'
  elif [ "$terminal_app" = "Terminal" ]; then
    /usr/bin/osascript -e 'tell application "Terminal" to do script ""'
  elif [ "$terminal_app" = "kitty" ]; then
    /Applications/kitty.app/Contents/MacOS/kitty --single-instance --directory="$PWD" &
  else
    open -n -a "$terminal_app"
  fi

  local win_id=""
  for _ in {1..12}; do
    win_id=$(yabai -m query --windows | jq -r --arg app "$terminal_app" --argjson before "$before_json" '
      [ .[]
        | select(.app == $app)
        | .id
      ] - $before
      | last // empty')
    if [ -n "$win_id" ]; then
      break
    fi
    sleep 0.1
  done

  yabai -m rule --remove "$rule_label" >/dev/null 2>&1 || true

  if [ -n "$win_id" ]; then
    yabai -m window "$win_id" --space "$current_space" >/dev/null 2>&1 || true
    yabai -m display --focus "$current_display" >/dev/null 2>&1 || true
    yabai -m space --focus "$current_space" >/dev/null 2>&1 || true
    yabai -m window --focus "$win_id" >/dev/null 2>&1 || true
  fi
}

main() {
  local group="${1:-}"
  local action="${2:-}"

  case "$group:$action" in
    app-focus:*)
      shift
      app_focus "$@"
      ;;
    presentation:toggle)
      toggle_presentation_mode
      ;;
    zen:on|zen:off)
      set_zen_mode "$action"
      ;;
    zen:toggle)
      toggle_zen_mode
      ;;
    zen:status)
      print_zen_status
      ;;
    terminal:new)
      open_terminal_window
      ;;
    help:|-h:|--help:|:help|:-h|:--help|:)
      usage
      ;;
    *)
      printf '%s\n' "Unknown command: ${group:-<none>} ${action:-<none>}" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"

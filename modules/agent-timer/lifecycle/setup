#!/usr/bin/env bash
set -euo pipefail

: "${DOTFILES_ROOT:?DOTFILES_ROOT is required}"
: "${DOTFILES_MODULE_ID:?DOTFILES_MODULE_ID is required}"
: "${DOTFILES_MODULE_ACTION:?DOTFILES_MODULE_ACTION is required}"

[[ "$DOTFILES_MODULE_ID" == "agent-timer" ]] || {
  printf 'agent-timer setup: unexpected module id: %s\n' "$DOTFILES_MODULE_ID" >&2
  exit 2
}

"$DOTFILES_ROOT/modules/agent-timer/bin/agent-timer" enable


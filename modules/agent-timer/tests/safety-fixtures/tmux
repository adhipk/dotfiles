#!/usr/bin/env bash
set -euo pipefail

log="${FAKE_TMUX_LOG:?FAKE_TMUX_LOG is required}"

render_pane() {
    local format="$1"
    local row="$2"
    local session_id session_name window_id pane_id pane_pid pane_tty pane_command pane_path rendered
    local window_name session_attached

    IFS='|' read -r session_id session_name window_id pane_id pane_pid pane_tty pane_command pane_path <<<"$row"
    window_name="${FAKE_TMUX_WINDOW_NAME:-codex}"
    session_attached="${FAKE_TMUX_SESSION_ATTACHED:-0}"
    rendered="$format"
    rendered="${rendered//'#{session_id}'/$session_id}"
    rendered="${rendered//'#{session_name}'/$session_name}"
    rendered="${rendered//'#{window_id}'/$window_id}"
    rendered="${rendered//'#{window_name}'/$window_name}"
    rendered="${rendered//'#{pane_id}'/$pane_id}"
    rendered="${rendered//'#{pane_pid}'/$pane_pid}"
    rendered="${rendered//'#{pane_tty}'/$pane_tty}"
    rendered="${rendered//'#{pane_current_command}'/$pane_command}"
    rendered="${rendered//'#{pane_current_path}'/$pane_path}"
    rendered="${rendered//'#{pane_start_command}'/$pane_command}"
    rendered="${rendered//'#{pane_active}'/1}"
    rendered="${rendered//'#{pane_dead}'/0}"
    rendered="${rendered//'#{session_attached}'/$session_attached}"
    printf '%s\n' "$rendered"
}

case "${1:-}" in
    display-message)
        printf '%s\n' "${FAKE_TMUX_SNAPSHOT:?FAKE_TMUX_SNAPSHOT is required}"
        ;;
    list-panes)
        format='#{session_name}|#{pane_id}|#{pane_pid}|#{pane_current_command}'
        shift
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -F)
                    [[ $# -ge 2 ]] || exit 2
                    format="$2"
                    shift 2
                    ;;
                *) shift ;;
            esac
        done
        while IFS= read -r row; do
            [[ -n "$row" ]] || continue
            render_pane "$format" "$row"
        done <<<"${FAKE_TMUX_PANES:-}"
        ;;
    has-session)
        exit 0
        ;;
    run-shell)
        shift
        command=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -b) shift ;;
                -t) shift 2 ;;
                *) command="$1"; shift ;;
            esac
        done
        [[ -n "$command" ]] || exit 2
        if [[ -n "${FAKE_TMUX_RUN_SHELL_LOG:-}" ]]; then
            printf '%s\n' "$command" >>"$FAKE_TMUX_RUN_SHELL_LOG"
        fi
        if [[ "${FAKE_TMUX_DROP_RUN_SHELL:-0}" != "1" ]]; then
            if [[ -n "${FAKE_TMUX_RUN_SHELL_STATUS_LOG:-}" ]]; then
                (
                    if /bin/sh -c "$command" </dev/null >/dev/null 2>&1; then
                        status=0
                    else
                        status=$?
                    fi
                    printf '%s\n' "$status" >>"$FAKE_TMUX_RUN_SHELL_STATUS_LOG"
                ) </dev/null >/dev/null 2>&1 &
            else
                /bin/sh -c "$command" </dev/null >/dev/null 2>&1 &
            fi
        fi
        ;;
    send-keys|kill-session)
        printf '%s\n' "$*" >>"$log"
        ;;
    *)
        printf 'unexpected fake tmux command: %s\n' "$*" >&2
        exit 2
        ;;
esac

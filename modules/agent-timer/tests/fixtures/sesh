#!/usr/bin/env bash
set -euo pipefail

case "$*" in
    "list --tmux --json")
        printf '%s\n' "${FAKE_SESH_JSON:-[]}"
        ;;
    picker*)
        printf 'picker\n' >>"${FAKE_SESH_LOG:?FAKE_SESH_LOG is required}"
        ;;
    *)
        printf 'unexpected fake sesh command: %s\n' "$*" >&2
        exit 2
        ;;
esac

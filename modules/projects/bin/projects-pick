#!/usr/bin/env bash
# man-me: name=projects-pick
# man-me: category=Project Spaces
# man-me: usage=projects-pick
# man-me: description=Shortcut wrapper for projects pick.
# man-me: tags=project projects projectdeck picker hyper hotkeys skhd yabai
module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$module_dir/projects" pick "$@"

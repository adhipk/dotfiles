#!/usr/bin/env bash

set -euo pipefail

# This literal keeps the run-onchange checksum aligned with the selected skin.
desired_skin="{{ .preferences.hermes.skin }}"
manager="$HOME/bin/dotfiles-manager"

command -v hermes >/dev/null 2>&1 || exit 0
[[ -x "$manager" ]] || exit 0
hermes profile show dotfiles >/dev/null 2>&1 || exit 0

DOTFILES_MANAGER_SKIN_NAME="$desired_skin" "$manager" configure

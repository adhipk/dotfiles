"""Human-first control panel for dotfiles settings and system inventories."""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import subprocess
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from rich.markup import escape
from textual import events, on
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Container, Horizontal, Vertical
from textual.screen import ModalScreen
from textual.widgets import Button, DataTable, Footer, Input, Label, OptionList, Select, Static
from textual.widgets.option_list import Option


@dataclass(frozen=True)
class Setting:
    key: str
    value: str
    type: str
    description: str
    allowed_values: tuple[str, ...]
    free_text: bool
    data_path: str
    source_file: str

    @property
    def category(self) -> str:
        return self.key.split(".", 1)[0]

    @property
    def label(self) -> str:
        leaf = self.key.rsplit(".", 1)[-1]
        words: list[str] = []
        current = ""
        for char in leaf:
            if char.isupper() and current:
                words.append(current)
                current = char.lower()
            elif char in "-_":
                if current:
                    words.append(current)
                    current = ""
            else:
                current += char
        if current:
            words.append(current)
        return " ".join(words).capitalize()


class BackendError(RuntimeError):
    pass


class SettingsBackend:
    def __init__(self, command: str | None = None, root: Path | None = None) -> None:
        self.command = command or os.environ.get(
            "DOTFILES_MANAGER_SETTINGS_BIN", str(Path.home() / "bin" / "dotfiles-settings")
        )
        self.root = root or Path(
            os.environ.get("DOTFILES_MANAGER_ROOT", str(Path.home() / "dotfiles"))
        )
        self.module_command = os.environ.get(
            "DOTFILES_MANAGER_MODULE_BIN", str(Path.home() / "bin" / "dotfiles-module")
        )
        self.dependencies_command = os.environ.get(
            "DOTFILES_MANAGER_DEPS_BIN", str(Path.home() / "bin" / "dotfiles-deps")
        )
        self.uninstall_command = os.environ.get(
            "DOTFILES_MANAGER_UNINSTALL_BIN", str(Path.home() / "bin" / "dotfiles-uninstall")
        )
        self.shortcut_rebind_command = os.environ.get(
            "DOTFILES_MANAGER_SHORTCUT_REBIND_BIN", str(Path.home() / "bin" / "shortcut-rebind")
        )
        self.yq_command = os.environ.get("DOTFILES_MANAGER_YQ_BIN", "yq")
        self.shortcuts_path = Path(
            os.environ.get(
                "DOTFILES_MANAGER_SHORTCUTS",
                str(self.root / "modules" / "shortcut-guide" / "generated" / "shortcuts.json"),
            )
        )

    def _run(self, *arguments: str) -> dict[str, Any]:
        environment = os.environ.copy()
        environment["DOTFILES_DIR"] = str(self.root)
        result = subprocess.run(
            [self.command, *arguments],
            cwd=self.root,
            env=environment,
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            message = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            raise BackendError(message)
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise BackendError(f"settings backend returned invalid JSON: {error}") from error

    def list_settings(self) -> list[Setting]:
        payload = self._run("list", "--json")
        return [
            Setting(
                key=row["key"],
                value=str(row.get("value", "")),
                type=row["type"],
                description=row["description"],
                allowed_values=tuple(str(value) for value in row.get("allowedValues", [])),
                free_text=bool(row.get("freeText", False)),
                data_path=row.get("dataPath", ""),
                source_file=row.get("sourceFile", ""),
            )
            for row in payload.get("settings", [])
        ]

    def set_setting(self, key: str, value: str) -> dict[str, Any]:
        return self._run("set", key, value, "--json")

    def _run_json_command(self, command: str, *arguments: str) -> Any:
        result = subprocess.run(
            [command, *arguments],
            cwd=self.root,
            env=os.environ.copy(),
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            message = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            raise BackendError(message)
        if not result.stdout.strip():
            message = result.stderr.strip() or f"{Path(command).name} exited with {result.returncode}"
            raise BackendError(message)
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise BackendError(f"{Path(command).name} returned invalid JSON: {error}") from error

    def list_shortcuts(self) -> list[dict[str, Any]]:
        try:
            payload = json.loads(self.shortcuts_path.read_text())
        except (OSError, json.JSONDecodeError) as error:
            raise BackendError(f"could not load shortcut catalog: {error}") from error
        return list(payload.get("shortcuts", []))

    def rebind_shortcut(self, stable_id: str, raw_key: str) -> dict[str, Any]:
        return dict(
            self._run_json_command(
                self.shortcut_rebind_command, stable_id, raw_key, "--json"
            )
        )

    def list_modules(self) -> list[dict[str, Any]]:
        return list(self._run_json_command(self.module_command, "status", "--json"))

    def plan_module_action(self, module_id: str, action: str) -> dict[str, Any]:
        return dict(
            self._run_json_command(self.module_command, "plan", action, module_id, "--json")
        )

    def execute_module_action(self, module_id: str, action: str) -> dict[str, Any]:
        return dict(self._run_json_command(self.module_command, action, module_id, "--json"))

    def dependency_status(self) -> dict[str, Any]:
        return dict(self._run_json_command(self.dependencies_command, "status", "--json"))

    def system_status(self) -> dict[str, Any]:
        return dict(self._run_json_command(self.uninstall_command, "plan", "--json"))

    def list_utilities(self) -> list[dict[str, Any]]:
        utilities: list[dict[str, Any]] = []
        for manifest in sorted((self.root / "modules").glob("*/module.yaml")):
            payload = self._run_json_command(self.yq_command, "-o=json", "-I=0", ".", str(manifest))
            module = str(payload.get("id", manifest.parent.name))
            for action in payload.get("actions", []):
                if not isinstance(action, dict):
                    continue
                command = str(action.get("command", ""))
                arguments = action.get("arguments", [])
                if not command or not isinstance(arguments, list):
                    continue
                resolved = str(Path(command).expanduser()) if command.startswith("~/") else command
                available = Path(resolved).is_file() and os.access(resolved, os.X_OK)
                utilities.append(
                    {
                        "id": str(action.get("id", f"{module}:{len(utilities)}")),
                        "label": str(action.get("label", action.get("id", "Utility"))),
                        "description": str(action.get("description", "")),
                        "command": command,
                        "arguments": [str(value) for value in arguments],
                        "module": module,
                        "state": "ready" if available else "unavailable",
                    }
                )
        return utilities

    def run_utility(self, utility: dict[str, Any]) -> str:
        command = str(utility.get("command", ""))
        arguments = utility.get("arguments", [])
        if not command or not isinstance(arguments, list):
            raise BackendError("utility action has an invalid command contract")
        resolved = str(Path(command).expanduser()) if command.startswith("~/") else command
        if not Path(resolved).is_file() or not os.access(resolved, os.X_OK):
            raise BackendError(f"utility is not installed: {command}")
        result = subprocess.run(
            [resolved, *(str(value) for value in arguments)],
            cwd=self.root,
            env=os.environ.copy(),
            text=True,
            capture_output=True,
            check=False,
            timeout=30,
        )
        if result.returncode != 0:
            message = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            raise BackendError(message)
        return result.stdout.strip()


class EditSettingScreen(ModalScreen[str | None]):
    BINDINGS = [Binding("escape", "cancel", "Cancel", show=False)]

    def __init__(self, setting: Setting) -> None:
        super().__init__()
        self.setting = setting

    def compose(self) -> ComposeResult:
        with Container(id="edit-card"):
            yield Label(f"Edit {self.setting.label}", id="edit-title")
            yield Static(self.setting.description, id="edit-description")
            if self.setting.allowed_values and not self.setting.free_text:
                options = [(value, value) for value in self.setting.allowed_values]
                yield Select(options, value=self.setting.value, allow_blank=False, id="edit-select")
            else:
                input_type = "integer" if self.setting.type == "integer" else "text"
                yield Input(value=self.setting.value, type=input_type, id="edit-input")
                if self.setting.allowed_values:
                    suggestions = "  ".join(self.setting.allowed_values[:8])
                    yield Static(f"Suggestions  {suggestions}", id="edit-suggestions")
            with Horizontal(id="edit-actions"):
                yield Button("Cancel", variant="default", id="cancel")
                yield Button("Apply", variant="primary", id="apply")

    def action_cancel(self) -> None:
        self.dismiss(None)

    @on(Button.Pressed, "#cancel")
    def cancel(self) -> None:
        self.dismiss(None)

    @on(Button.Pressed, "#apply")
    def apply(self) -> None:
        select = self.query_one("#edit-select", Select) if self.query("#edit-select") else None
        if select is not None:
            value = str(select.value)
        else:
            value = self.query_one("#edit-input", Input).value.strip()
        if value:
            self.dismiss(value)


class ModuleActionScreen(ModalScreen[tuple[str, str] | None]):
    BINDINGS = [Binding("escape", "cancel", "Cancel", show=False)]

    def __init__(self, module: dict[str, Any], action: str, plan: dict[str, Any]) -> None:
        super().__init__()
        self.module = module
        self.action = action
        self.plan = plan

    def compose(self) -> ComposeResult:
        module_id = str(self.module.get("id", "module"))
        exclusive = len(self.plan.get("exclusiveTargets", []))
        contributions = len(self.plan.get("contributionTargets", []))
        with Container(id="module-card"):
            yield Label(f"{self.action.title()} {module_id}?", id="module-title")
            yield Static(
                f"{self.module.get('description', '')}\n\n"
                f"This runs the module-owned {self.action} lifecycle, then reconciles "
                f"{exclusive} exclusive target(s) and {contributions} shared contribution(s).",
                id="module-description",
            )
            with Horizontal(id="module-actions"):
                yield Button("Cancel", variant="default", id="module-cancel")
                yield Button(self.action.title(), variant="primary", id="module-confirm")

    def action_cancel(self) -> None:
        self.dismiss(None)

    @on(Button.Pressed, "#module-cancel")
    def cancel(self) -> None:
        self.dismiss(None)

    @on(Button.Pressed, "#module-confirm")
    def confirm(self) -> None:
        self.dismiss((str(self.module["id"]), self.action))


class EditShortcutScreen(ModalScreen[tuple[str, str] | None]):
    BINDINGS = [Binding("escape", "cancel", "Cancel", show=False)]

    def __init__(self, shortcut: dict[str, Any]) -> None:
        super().__init__()
        self.shortcut = shortcut

    def compose(self) -> ComposeResult:
        with Container(id="shortcut-card"):
            yield Label(f"Rebind {self.shortcut.get('title', 'shortcut')}", id="shortcut-title")
            yield Static(
                "Use skhd syntax, for example alt - 1 or shift + alt - h.",
                id="shortcut-description",
            )
            yield Input(value=str(self.shortcut.get("rawKey", "")), id="shortcut-input")
            with Horizontal(id="shortcut-actions"):
                yield Button("Cancel", variant="default", id="shortcut-cancel")
                yield Button("Apply", variant="primary", id="shortcut-apply")

    def action_cancel(self) -> None:
        self.dismiss(None)

    @on(Button.Pressed, "#shortcut-cancel")
    def cancel(self) -> None:
        self.dismiss(None)

    @on(Button.Pressed, "#shortcut-apply")
    def apply(self) -> None:
        value = self.query_one("#shortcut-input", Input).value.strip()
        if value:
            self.dismiss((str(self.shortcut.get("stableId", "")), value))


class DotfilesManagerApp(App[None]):
    TITLE = "Dotfiles"
    SUB_TITLE = "Control panel"
    ENABLE_COMMAND_PALETTE = True
    _theme_override = Path(
        os.environ.get(
            "DOTFILES_MANAGER_THEME", str(Path.home() / ".config" / "dotfiles-manager" / "theme.tcss")
        )
    )
    CSS_PATH = [str(_theme_override)] if _theme_override.is_file() else []
    BINDINGS = [
        Binding("/", "focus_search", "Search"),
        Binding("enter", "edit_selected", "Open"),
        Binding("r", "refresh", "Refresh"),
        Binding("q", "quit", "Quit"),
    ]
    CSS = """
    Screen {
        background: #11111b;

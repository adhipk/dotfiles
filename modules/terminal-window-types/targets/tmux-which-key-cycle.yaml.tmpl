      - name: Cycle terminal
        key: '0'
        command: 'run-shell "$HOME/bin/tmux-session-template cycle #{session_id} terminal #{window_id}"'
      - name: Cycle Codex
        key: '1'
        command: 'run-shell "$HOME/bin/tmux-session-template cycle #{session_id} codex #{window_id}"'
      - name: Cycle Neovim
        key: '2'
        command: 'run-shell "$HOME/bin/tmux-session-template cycle #{session_id} nvim #{window_id}"'
      - name: Cycle Tuxedo
        key: '3'
        command: 'run-shell "$HOME/bin/tmux-session-template cycle #{session_id} tuxedo #{window_id}"'

  - name: save-all
    commands:
      - run-shell $HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh
      - display "#{log_info} Session state saved"
  - name: restore-all
    commands:
      - run-shell $HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh
      - display "#{log_info} Session state restored"

# Sesh/tmux session manager integration.
bindkey -s '\ee' "tmux-session-picker\n"      # Alt+e (existing tmux sessions via sesh)
bindkey -s '\eh' "tmux-sessionizer -s 0\n"    # Alt+h (sesh slot 0)
bindkey -s '\et' "tmux-sessionizer -s 1\n"    # Alt+t (sesh slot 1)
bindkey -s '\en' "tmux-sessionizer -s 2\n"    # Alt+n (sesh slot 2)
bindkey -s '\es' "tmux-sessionizer -s 3\n"    # Alt+s (sesh slot 3)

#!/usr/bin/env bash
# Manage pinned tmux sessions ("hyperspaces") with sesh.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  hyperspace pin <slot> [session-name]
  hyperspace unpin <slot>
  hyperspace connect <slot>
  hyperspace search [query]
  hyperspace list
EOF
}

PIN_FILE="${HYPERSPACE_PIN_FILE:-$HOME/.config/sesh/hyperspaces.json}"
QUERY_FILTER="${HYPERSPACE_QUERY_FILTER:-hyperspace}"
CONFIG_FILE="${HYPERSPACE_CONFIG_FILE:-$HOME/.config/sesh/hyperspace.env}"

if [ -r "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

RAYCAST_DEEPLINK="${RAYCAST_HYPERSPACE_DEEPLINK:-}"

notify() {
  local title="$1"
  local body="$2"

  [[ "${HYPERSPACE_NOTIFY:-1}" == "0" ]] && return 0

  /usr/bin/osascript - "$title" "$body" <<'APPLESCRIPT'
on run argv
  display notification item 2 of argv with title item 1 of argv
end run
APPLESCRIPT
}

require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    notify "Hyperspace" "jq is not installed. Install with: brew install jq"
    exit 1
  fi
}

ensure_database() {
  require_jq
  mkdir -p "$(dirname "$PIN_FILE")"
  if [ ! -f "$PIN_FILE" ]; then
    printf '%s\n' "{}" > "$PIN_FILE"
  fi
}

validate_slot() {
  local slot="$1"
  if [[ ! "$slot" =~ ^[1-9]$ ]]; then
    notify "Hyperspace" "Invalid slot: $slot (use 1-9)."
    exit 1
  fi
}

slot_session() {
  local slot="$1"
  jq -r --arg slot "$slot" '.[$slot] // empty' "$PIN_FILE"
}

set_slot() {
  local slot="$1"
  local session="$2"
  local tmp

  ensure_database
  tmp=$(mktemp)
  jq --arg slot "$slot" --arg session "$session" '.[$slot] = $session' "$PIN_FILE" > "$tmp"
  mv "$tmp" "$PIN_FILE"
}

clear_slot() {
  local slot="$1"
  local tmp

  ensure_database
  tmp=$(mktemp)
  jq --arg slot "$slot" 'del(.[$slot])' "$PIN_FILE" > "$tmp"
  mv "$tmp" "$PIN_FILE"
}

current_tmux_session() {
  if [ -z "${TMUX:+x}" ]; then
    return 1
  fi

  tmux display-message -p '#S' 2>/dev/null || return 1
}

pin() {
  local slot="$1"
  local session="${2:-}"

  validate_slot "$slot"
  if [ -z "$session" ]; then
    session=$(current_tmux_session || true)
  fi

  if [ -z "$session" ]; then
    notify "Hyperspace" "Could not detect active session. Run from a tmux pane or pass a session name."
    exit 1
  fi

  set_slot "$slot" "$session"
  notify "Hyperspace" "Pinned '$session' to slot $slot"
}

unpin() {
  local slot="$1"
  local session

  validate_slot "$slot"
  ensure_database
  session=$(slot_session "$slot")

  if [ -z "$session" ] || [ "$session" = "null" ]; then
    notify "Hyperspace" "Slot $slot is already empty"
    exit 0
  fi

  clear_slot "$slot"
  notify "Hyperspace" "Unpinned '$session' from slot $slot"
}

connect() {
  local slot="$1"
  local session

  validate_slot "$slot"
  ensure_database
  session=$(slot_session "$slot")

  if [ -z "$session" ] || [ "$session" = "null" ]; then
    notify "Hyperspace" "No session pinned to slot $slot"
    exit 0
  fi

  if ! command -v sesh >/dev/null 2>&1; then
    notify "Hyperspace" "sesh is not installed. Install with: brew install sesh"
    exit 1
  fi

  exec sesh connect "$session"
}

search() {
  local query="${1:-$QUERY_FILTER}"
  local selected

  if [ -n "$RAYCAST_DEEPLINK" ]; then
    if command -v open >/dev/null 2>&1; then
      open "$RAYCAST_DEEPLINK"
      exit 0
    fi
  fi

  if ! [ -t 0 ]; then
    if [ -n "$RAYCAST_DEEPLINK" ]; then
      notify "Hyperspace" "Raycast deeplink not configured correctly. Set RAYCAST_HYPERSPACE_DEEPLINK."
    else
      notify "Hyperspace" "No interactive terminal detected. Set RAYCAST_HYPERSPACE_DEEPLINK or run from a terminal."
    fi
    exit 0
  fi

  if ! command -v sesh >/dev/null 2>&1; then
    notify "Hyperspace" "sesh is not installed. Install with: brew install sesh"
    exit 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    notify "Hyperspace" "fzf is required for local fallback picker"
    exit 1
  fi

  selected=$(sesh list -t -z 2>/dev/null | rg -i -- "$query" | fzf --height 40% --reverse --border --prompt="Hyperspace: " || true)

  if [ -z "$selected" ]; then
    exit 0
  fi

  exec sesh connect "$selected"
}

list_pins() {
  ensure_database
  jq -r 'to_entries | sort_by(.key)[] | "\(.key): \(.value // "<empty>")"' "$PIN_FILE"
}

main() {
  local command="${1:-}"
  shift || true

  case "$command" in
    pin)
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      pin "$1" "${2:-}"
      ;;
    unpin)
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      unpin "$1"
      ;;
    connect)
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      connect "$1"
      ;;
    search)
      search "${1:-}"
      ;;
    list)
      list_pins
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"

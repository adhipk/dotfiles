# Ignore runtime files
*.tmp
*.log

# ProjectDeck build output
modules/projects/projectdeck/executable_projectdeck

# Shortcut guide build output
scripts/whichkey/executable_whichkey

# Native control-center SwiftPM output
modules/dotfiles-control-center/.build/

# Ignore local shell secrets
zshrc.secrets

# Chrome extension repositories are declared as chezmoi externals.
/extensions/

# Native release artifacts and extension example build output
/dist/
examples/hello-utility/.build/
examples/hello-utility/.swiftpm/
/test-results/
__pycache__/
*.pyc

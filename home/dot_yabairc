#!/usr/bin/env sh

# Load the scripting addition when SIP allows it. Core tiling still works
# without it, but advanced operations such as creating spaces do not.
SA_LOADED=false
if sudo yabai --load-sa; then
  SA_LOADED=true
  yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
else
  echo "yabai scripting addition unavailable; skipping automatic space creation." >&2
fi

yabai -m signal --remove "hide_scratchpads_on_focus_change" >/dev/null 2>&1 || true
yabai -m signal --remove "hide_scratchpads_on_app_switch" >/dev/null 2>&1 || true
yabai -m signal --remove "hide_scratchpads_on_app_deactivate" >/dev/null 2>&1 || true
yabai -m signal --remove "projects_record_focus" >/dev/null 2>&1 || true
yabai -m signal --remove "app_mru_update" >/dev/null 2>&1 || true
yabai -m signal --remove "tile_pip_on_create" >/dev/null 2>&1 || true
yabai -m signal --remove "tile_pip_on_title_change" >/dev/null 2>&1 || true
yabai -m signal --remove "normalize_pip_on_create" >/dev/null 2>&1 || true
yabai -m signal --remove "normalize_pip_on_title_change" >/dev/null 2>&1 || true
yabai -m signal --add label=projects_record_focus event=window_focused action="$HOME/.config/yabai/projects record-focus"
yabai -m signal --add label=app_mru_update event=window_focused action="$HOME/.config/skhd/app-mru.sh update"
yabai -m signal --add label=tile_pip_on_create event=window_created title="^Picture in Picture$" action="$HOME/.config/yabai/tile-pip-window"
yabai -m signal --add label=tile_pip_on_title_change event=window_title_changed title="^Picture in Picture$" action="$HOME/.config/yabai/tile-pip-window"

yabai -m config debug_output on
# global settings
yabai -m config layout                       bsp
yabai -m config window_placement             second_child

# padding and gaps
BORDER_WIDTH=2.0
BORDER_COLOR=0xff000000
# Keep a minimal inset around the JankyBorders underlay so adjacent overlays
# do not collide.
BORDER_RESERVE=1
BORDER_GAP=$((BORDER_RESERVE * 2))
yabai -m config top_padding                  "$BORDER_RESERVE"
yabai -m config bottom_padding               "$BORDER_RESERVE"
yabai -m config left_padding                 "$BORDER_RESERVE"
yabai -m config right_padding                "$BORDER_RESERVE"
yabai -m config window_gap                   "$BORDER_GAP"
# mouse
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off
yabai -m config mouse_modifier               fn
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap

# window appearance

yabai -m config window_shadow                off
yabai -m config window_opacity               off
yabai -m config active_window_opacity        1.0
yabai -m config normal_window_opacity        1.0
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 on

# float system preferences and other non-tileable apps
yabai -m rule --add app="^System Settings$"  manage=off
yabai -m rule --add app="^Calculator$"       manage=off
yabai -m rule --add app="^Karabiner"         manage=off
yabai -m rule --add app="^Archive Utility$"  manage=off
yabai -m rule --add app="^Finder$" title="^(Copy|Connect|Move|Info|Pref)" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^App Store$"        manage=off
yabai -m rule --add app="^System Information$" manage=off
yabai -m rule --add app="^Keychain Access$"  manage=off
yabai -m rule --add title="^skhd keys$"     manage=off

yabai -m rule --add label="tile_pip_windows" title="^Picture in Picture$" manage=on sticky=off sub-layer=auto

# Scratchpad windows are launched with forced Ghostty titles so yabai can
# classify them before they briefly enter the BSP grid.
eval "$("$HOME/bin/scratchpads" rules)"

"$HOME/.config/yabai/float-prefs" apply-rules || true

# ============================================================
# Fixed Space Order (1-4)
# 1: Ghostty, Browser
# 2: Editor
# 3: Slack, Teams, Outlook
# 4: Empty (no default apps)
# ============================================================

# Ensure at least 4 spaces exist on display 1
SPACE_COUNT=$(yabai -m query --spaces --display 1 | jq 'length')
if [ "$SA_LOADED" = true ] && [ "$SPACE_COUNT" -lt 4 ]; then
  i=$SPACE_COUNT
  while [ "$i" -lt 4 ]; do
    yabai -m space --create
    i=$((i + 1))
  done
fi

# The built-in display has an odd-height work area. Add its one-pixel tiling
# remainder to the reserved top edge instead of leaving it between windows.
yabai -m query --spaces --display 1 | jq -r '.[].index' | while read -r space; do
  yabai -m config --space "$space" top_padding "$((BORDER_RESERVE + 1))"
  yabai -m config --space "$space" bottom_padding "$BORDER_RESERVE"
done

# Label spaces consistently
[ "$SPACE_COUNT" -ge 1 ] && yabai -m space 1 --label "browser"
[ "$SPACE_COUNT" -ge 2 ] && yabai -m space 2 --label "editor"
[ "$SPACE_COUNT" -ge 3 ] && yabai -m space 3 --label "comms"
[ "$SPACE_COUNT" -ge 4 ] && yabai -m space 4 --label "empty"

# No space assignments - windows open in current space by default

# Draw a square underlay so native rounded window corners blend into the
# tiled layout. Subsequent invocations update an existing borders process.
if command -v borders >/dev/null 2>&1; then
  borders style=square width="$BORDER_WIDTH" hidpi=on ax_focus=on active_color="$BORDER_COLOR" inactive_color="$BORDER_COLOR" &
fi

echo "yabai configuration loaded..."

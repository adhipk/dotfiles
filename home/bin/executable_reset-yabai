#!/bin/zsh

set -e

BREW=/opt/homebrew/bin/brew
YABAI=/opt/homebrew/bin/yabai
FORMULA=adhipkashyap/yabai-versions/yabai@7.1.16

"$YABAI" --stop-service || true
sudo "$YABAI" --uninstall-sa || true
"$YABAI" --uninstall-service || true

"$BREW" uninstall --ignore-dependencies yabai 2>/dev/null || true
"$BREW" uninstall --ignore-dependencies yabai@7.1.16 2>/dev/null || true
"$BREW" cleanup yabai@7.1.16 || true
sleep 0.5
"$BREW" install "$FORMULA"
"$BREW" link --overwrite --force yabai@7.1.16
"$BREW" pin yabai@7.1.16

sleep 1

YABAI_SHA256=$(shasum -a 256 "$YABAI" | cut -d " " -f 1)
echo "$(whoami) ALL=(root) NOPASSWD: sha256:$YABAI_SHA256 $YABAI --load-sa" |
  sudo tee /etc/sudoers.d/yabai >/dev/null

sudo "$YABAI" --load-sa
"$YABAI" --install-service
"$YABAI" --start-service

#!/bin/bash
# man-me: name=unescape-string
# man-me: category=Text, Speech, and Clipboard
# man-me: usage=printf 'line\\n' into unescape-string
# man-me: description=sed stdin filter for common escaped string sequences.
# man-me: tags=text stdin escape unescape sed clipboard

# unescape-string.sh
# Convert escaped strings (\n, \", etc.) to actual characters
# Reads from stdin, writes to stdout

sed -e 's/\\n/\n/g' \
    -e 's/\\"/"/g' \
    -e 's/\\\\/\\/g' \
    -e 's/\\t/\t/g' \
    -e 's/\\r/\r/g'

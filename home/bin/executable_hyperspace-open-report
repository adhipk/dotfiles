#!/usr/bin/env bash
# Open a nearly-headless HTML artifact from .hyperspace/ or via localhost server.

set -euo pipefail

PORT="${HYPERSPACE_SERVE_PORT:-4200}"
HOST="${HYPERSPACE_SERVE_HOST:-127.0.0.1}"
PID_FILE="${HYPERSPACE_SERVE_PID_FILE:-$HOME/.local/state/hyperspaces/serve.pid}"
CONFIG_FILE="${HYPERSPACE_CONFIG_FILE:-$HOME/.config/hyperspaces/config.json}"

usage() {
  cat <<EOF
Usage:
  hyperspace-open-report <slug> [--project DIR] [--route SESSION] [--server]

Opens <project>/.hyperspace/<slug>.html in the browser.
With --server (or when hyperspace-serve is running), opens http://${HOST}:${PORT}/<route>/<slug>.
Route defaults to the active session's project id (or projects.<id>.route in config.json).
EOF
}

resolve_project() {
  local dir="${1:-.}"
  cd "$dir"
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
  else
    pwd
  fi
}

project_id_from_path() {
  local root="$1"
  local key configured

  if [ -f "$CONFIG_FILE" ] && command -v jq >/dev/null 2>&1; then
    while IFS= read -r key; do
      [ -z "$key" ] && continue
      configured=$(jq -r --arg k "$key" '.projects[$k].path // empty' "$CONFIG_FILE")
      case "$configured" in
        "$HOME/~/") configured="$HOME" ;;
        "$HOME/~/"*) configured="$HOME/${configured#"$HOME/~/"}" ;;
        "~") configured="$HOME" ;;
        "~/"*) configured="$HOME/${configured#~/}" ;;
      esac
      if [ "$configured" = "$root" ]; then
        printf '%s\n' "$key"
        return 0
      fi
    done < <(jq -r '.projects | keys[]?' "$CONFIG_FILE" 2>/dev/null)
  fi

  basename "$root"
}

session_route() {
  local project="$1"

  if [ -f "$CONFIG_FILE" ] && command -v jq >/dev/null 2>&1; then
    local route
    route=$(jq -r --arg project "$project" '
      .projects[$project].route // empty
    ' "$CONFIG_FILE" 2>/dev/null)
    if [ -n "$route" ] && [ "$route" != "null" ]; then
      printf '%s\n' "$route"
      return 0
    fi
  fi

  printf '%s\n' "$project"
}

serve_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

main() {
  local slug=""
  local project="."
  local route=""
  local use_server=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --project|-p)
        project="${2:?missing directory after --project}"
        shift 2
        ;;
      --route|-r)
        route="${2:?missing route after --route}"
        shift 2
        ;;
      --server)
        use_server=true
        shift
        ;;
      -h|--help|help)
        usage
        exit 0
        ;;
      *)
        if [ -z "$slug" ]; then
          slug="$1"
          shift
        else
          echo "Unexpected argument: $1" >&2
          usage >&2
          exit 1
        fi
        ;;
    esac
  done

  if [ -z "$slug" ]; then
    usage >&2
    exit 1
  fi

  case "$slug" in
    *.html) ;;
    *) slug="${slug}.html" ;;
  esac

  local root
  root=$(resolve_project "$project")
  local artifact="$root/.hyperspace/$slug"

  if [ ! -f "$artifact" ]; then
    echo "Artifact not found: $artifact" >&2
    echo "Create with \$html-artifact or nearly-headless init-project" >&2
    exit 1
  fi

  if [ "$use_server" = false ] && serve_running; then
    use_server=true
  fi

  if [ "$use_server" = true ]; then
    if [ -z "$route" ]; then
      local project_id
      project_id=$(project_id_from_path "$root")
      route=$(session_route "$project_id")
    fi
    local url="http://${HOST}:${PORT}/${route}/${slug}"
    if command -v open >/dev/null 2>&1; then
      exec open "$url"
    fi
    echo "$url"
    exit 0
  fi

  if ! command -v open >/dev/null 2>&1; then
    echo "$artifact"
    exit 0
  fi

  exec open "$artifact"
}

main "$@"

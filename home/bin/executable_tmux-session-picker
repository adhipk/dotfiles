#!/usr/bin/env bash
# Quick picker to switch between existing tmux sessions only.

if ! command -v sesh >/dev/null 2>&1; then
  echo "sesh is not installed. Install it with: brew install sesh" >&2
  exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required for interactive session picker" >&2
  exit 1
fi

selected=$(sesh list -t 2>/dev/null | fzf --height 40% --reverse --border --prompt="Switch to session: ")

if [[ -z "$selected" ]]; then
    exit 0
fi

exec sesh connect "$selected"

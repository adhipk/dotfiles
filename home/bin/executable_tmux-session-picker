#!/usr/bin/env bash
# man-me: name=tmux-session-picker
# man-me: category=Terminal and Sessions
# man-me: usage=tmux-session-picker
# man-me: description=Switch to an existing tmux session with sesh's built-in picker.
# man-me: tags=tmux terminal session sessions sesh picker
# Built-in sesh picker for existing tmux sessions only.

set -euo pipefail

if ! command -v sesh >/dev/null 2>&1; then
  echo "sesh is not installed. Install it with: brew install sesh" >&2
  exit 1
fi

exec sesh picker --icons --hide-duplicates --separator-aware --tmux

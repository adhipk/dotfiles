#!/usr/bin/env bash
# man-me: name=gh-create-repo
# man-me: category=Development and Repo
# man-me: usage=gh-create-repo
# man-me: description=Edit repository creation settings as YAML, then run gh repo create.
# man-me: tags=github gh repo repository create yaml development
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  gh-create-repo

Opens a temporary gh-repo-create.yml using Git-style editor selection. After
you save and quit, the YAML is converted into a gh repo create command and run.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

require_command() {
  local command="$1"

  if ! command -v "$command" >/dev/null 2>&1; then
    echo "gh-create-repo: $command is required." >&2
    echo "Install it with: brew install $command" >&2
    exit 1
  fi
}

require_command gh
require_command yq

resolve_editor() {
  if command -v git >/dev/null 2>&1; then
    git var GIT_EDITOR 2>/dev/null && return 0
  fi

  printf '%s\n' "${VISUAL:-${EDITOR:-nvim}}"
}

open_editor() {
  local editor="$1"
  local file="$2"

  /bin/sh -c "$editor \"\$1\"" gh-create-repo-editor "$file"
}

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/gh-repo-create.XXXXXX")"
tmp="$tmpdir/gh-repo-create.yml"

cleanup() {
  rm -rf "$tmpdir"
}
trap cleanup EXIT

cat >"$tmp" <<'YAML'
# Edit, save, and quit. Empty optional values are ignored.
name: <owner>/<repo>
visibility: private # public | private | internal
description:
add_readme: false
gitignore:
license:
source:
remote:
push: false
YAML

initial_checksum="$(cksum "$tmp")"

editor="$(resolve_editor)"
open_editor "$editor" "$tmp"

if [[ "$(cksum "$tmp")" == "$initial_checksum" ]]; then
  echo "gh-create-repo: unchanged template; canceled."
  exit 0
fi

get() {
  yq -r ".$1 // \"\"" "$tmp"
}

get_bool() {
  local key="$1"
  local value

  value="$(get "$key")"
  case "$value" in
    true|false|"")
      printf '%s\n' "$value"
      ;;
    *)
      echo "gh-create-repo: $key must be true or false." >&2
      exit 1
      ;;
  esac
}

name="$(get name)"
visibility="$(get visibility)"
description="$(get description)"
add_readme="$(get_bool add_readme)"
gitignore="$(get gitignore)"
license="$(get license)"
source_dir="$(get source)"
remote="$(get remote)"
push="$(get_bool push)"

if [[ -z "$name" || "$name" == *"<"* || "$name" == *">"* ]]; then
  echo "gh-create-repo: set name to a repository name, such as my-org/my-repo." >&2
  exit 1
fi

visibility="${visibility:-private}"
case "$visibility" in
  public|private|internal)
    ;;
  *)
    echo "gh-create-repo: visibility must be public, private, or internal." >&2
    exit 1
    ;;
esac

if [[ -n "$source_dir" && ! -d "$source_dir" ]]; then
  echo "gh-create-repo: source must be an existing directory: $source_dir" >&2
  exit 1
fi

if [[ "$push" == "true" && -z "$source_dir" ]]; then
  echo "gh-create-repo: push requires source to be set." >&2
  exit 1
fi

cmd=(gh repo create "$name" "--$visibility")

[[ -n "$description" ]] && cmd+=(--description "$description")
[[ "$add_readme" == "true" ]] && cmd+=(--add-readme)
[[ -n "$gitignore" ]] && cmd+=(--gitignore "$gitignore")
[[ -n "$license" ]] && cmd+=(--license "$license")
[[ -n "$source_dir" ]] && cmd+=("--source=$source_dir")
[[ -n "$remote" ]] && cmd+=("--remote=$remote")
[[ "$push" == "true" ]] && cmd+=(--push)

printf 'Running:\n  '
for index in "${!cmd[@]}"; do
  value="${cmd[$index]}"

  if (( index == 0 )); then
    printf '%q' "$value"
  elif [[ "$value" == --* ]]; then
    printf ' \\\n    %q' "$value"
  else
    printf ' %q' "$value"
  fi
done
printf '\n\n'

"${cmd[@]}"

repo_slug="$name"
ssh_url=""

if repo_data="$(gh repo view "$name" --json nameWithOwner,sshUrl --jq '.nameWithOwner + "\t" + .sshUrl' 2>/dev/null)"; then
  IFS=$'\t' read -r repo_slug ssh_url <<<"$repo_data"
fi

if [[ -z "$ssh_url" ]]; then
  if [[ "$repo_slug" == */* ]]; then
    ssh_url="git@github.com:$repo_slug.git"
  else
    ssh_url="git@github.com:<owner>/$repo_slug.git"
  fi
fi

next_remote="${remote:-origin}"

printf '\nRepository created: %s\n\n' "$repo_slug"
printf 'To connect a local checkout:\n'
printf '  git remote add %q %q\n' "$next_remote" "$ssh_url"
printf '  git branch -M main\n'
printf '  git push -u %q main\n' "$next_remote"

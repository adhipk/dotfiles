#!/usr/bin/env bash
# man-me: name=lucide-icons-excalidraw
# man-me: category=Development and Repo
# man-me: usage=lucide-icons-excalidraw [npm-run-dev-args...]
# man-me: description=Start the external Raycast Lucide Excalidraw picker in dev mode.
# man-me: tags=lucide icons excalidraw raycast npm development

set -euo pipefail

PROJECT_DIR="$HOME/.local/share/raycast-extensions/raycast-lucide-excalidraw"
EXTENSION_DIR="$PROJECT_DIR/projects/raycast-extension"

if [ ! -d "$EXTENSION_DIR" ]; then
    echo "Raycast extension checkout is missing: $PROJECT_DIR" >&2
    echo "Run chezmoi apply or ./bootstrap.sh to sync externals." >&2
    exit 1
fi

cd "$EXTENSION_DIR"
exec npm run dev -- "$@"

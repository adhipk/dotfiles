#!/usr/bin/env bash

set -euo pipefail

EXTENSION_DIR="$HOME/.local/share/raycast-extensions/raycast-lucide-excalidraw"

if [ ! -d "$EXTENSION_DIR" ]; then
    echo "Raycast extension checkout is missing: $EXTENSION_DIR" >&2
    echo "Run chezmoi apply or ./bootstrap.sh to sync externals." >&2
    exit 1
fi

cd "$EXTENSION_DIR"
exec npm run dev -- "$@"

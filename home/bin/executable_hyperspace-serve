#!/usr/bin/env bash
# Compatibility alias. Hyperspace owns the local app server.

set -euo pipefail

PROJECT_DIR="${HYPERSPACE_PROJECT_DIR:-${NEARLY_HEADLESS_PROJECT_DIR:-${HYPERSPACE_PERSONAL_DIR:-$HOME/dotfiles/extensions/nearly-headless}}}"
BIN="${HYPERSPACE_BIN:-$PROJECT_DIR/bin/hyperspace}"

if [ -x "$BIN" ]; then
  exec "$BIN" serve "$@"
fi

exec nearly-headless serve "$@"

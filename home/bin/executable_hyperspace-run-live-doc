#!/usr/bin/env bash
# Run codex exec on a saved live doc (no tmux send-keys).

set -euo pipefail

CONFIG_FILE="${HYPERSPACE_CONFIG_FILE:-$HOME/.config/hyperspaces/config.json}"
LOG_NAME="live-doc-run.log"
PID_NAME="live-doc-run.pid"

usage() {
  cat <<EOF
Usage: hyperspace-run-live-doc <project> [window]

Runs codex exec against .hyperspace/livedoc.html after browser Save.
Uses AGENTS.md in the project — no bootstrap prompt, no tmux injection.
EOF
}

expand_path() {
  local path="$1"
  local home_tilde="${HOME}/~/"
  if [[ "$path" == "$home_tilde"* ]]; then
    printf '%s/%s' "$HOME" "${path#"$home_tilde"}"
    return 0
  fi
  case "$path" in
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${path#~/}" ;;
    *) printf '%s' "$path" ;;
  esac
}

project_path() {
  local project="$1"
  local configured
  if [ -f "$CONFIG_FILE" ] && command -v jq >/dev/null 2>&1; then
    configured=$(jq -r --arg p "$project" '.projects[$project].path // empty' "$CONFIG_FILE")
    if [ -n "$configured" ] && [ "$configured" != "null" ]; then
      expand_path "$configured"
      return 0
    fi
  fi
  if [ -d "$HOME/$project" ]; then
    printf '%s\n' "$HOME/$project"
    return 0
  fi
  return 1
}

provider_for_project() {
  local project="$1"
  local window="${2:-}"
  if [ -f "$CONFIG_FILE" ] && command -v jq >/dev/null 2>&1; then
    jq -r --arg p "$project" --arg w "$window" '
      (if $w != "" then .projects[$p].windows[$w].provider else empty end) //
      (if $w != "" then .defaults[$w].provider else empty end) //
      (.projects[$p].windows[.projects[$p].liveDocWindow].provider) //
      (.projects[$p].windows | to_entries[0].value.provider) //
      .defaults["codex-main"].provider //
      (.defaults | to_entries[0].value.provider) //
      "codex"
    ' "$CONFIG_FILE" 2>/dev/null
    return 0
  fi
  printf '%s\n' "codex"
}

live_doc_window_for_project() {
  local project="$1"
  local requested="${2:-}"

  if [ -n "$requested" ]; then
    printf '%s\n' "$requested"
    return 0
  fi

  if [ -f "$CONFIG_FILE" ] && command -v jq >/dev/null 2>&1; then
    jq -r --arg p "$project" '
      .projects[$p].liveDocWindow //
      (.projects[$p].windows | keys[0]) //
      (if .defaults["codex-main"] then "codex-main" else empty end) //
      (.defaults | keys[0]) //
      "codex-main"
    ' "$CONFIG_FILE" 2>/dev/null
    return 0
  fi

  printf '%s\n' "codex-main"
}

mark_status() {
  local meta="$1"
  local status="$2"
  local window="${3:-}"
  local tmp
  [ -f "$meta" ] || return 0
  tmp=$(mktemp)
  jq --arg status "$status" --arg window "$window" '
    .status = $status
    | if $window != "" then .window = $window else . end
  ' "$meta" >"$tmp"
  mv "$tmp" "$meta"
}

main() {
  local project="${1:-}"
  local requested_window="${2:-}"
  if [ -z "$project" ]; then
    usage >&2
    exit 1
  fi

  local root provider window meta log pid_file prompt codex_args=()
  if ! root=$(project_path "$project"); then
    echo "Unknown project: $project" >&2
    exit 1
  fi
  root=$(cd "$root" && pwd -P)

  window=$(live_doc_window_for_project "$project" "$requested_window")
  provider=$(provider_for_project "$project" "$window")
  meta="$root/.hyperspace/live-doc.json"
  log="$root/.hyperspace/$LOG_NAME"
  pid_file="$root/.hyperspace/$PID_NAME"

  mkdir -p "$root/.hyperspace"

  if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    echo "Live doc run already in progress (pid $(cat "$pid_file"))"
    exit 0
  fi

  mark_status "$meta" "running" "$window"

  prompt=$(printf '%s\n\n%s\n%s\n%s\n\n%s\n%s\n' \
    "Hyperspace live doc run for ${project}, attached to window ${window}." \
    "Read and edit ${root}/.hyperspace/livedoc.html - canvas inside <main class=\"live-doc-canvas\">." \
    "Use the component vocabulary for structure: hs-callout, hs-finding, hs-comparison, hs-option, hs-details (see ~/.config/hyperspaces/components/)." \
    "Execute the saved user intent: edit the canvas with balanced, valid HTML and component tags - not chat. No build step." \
    "When finished, set \"pending\": false and \"status\": \"done\" in ${root}/.hyperspace/live-doc.json." \
    "Do not add run-complete/status narration to livedoc.html unless the user explicitly requested it. If blocked, set \"status\": \"blocked\" and explain in livedoc.html.")

  case "$provider" in
    codex)
      if ! command -v codex >/dev/null 2>&1; then
        echo "codex not found" >&2
        mark_status "$meta" "error" "$window"
        exit 1
      fi
      codex_args=(exec -C "$root" -s workspace-write)
      if [ "${HYPERSPACE_CODEX_YOLO:-}" = "1" ]; then
        codex_args+=(--dangerously-bypass-approvals-and-sandbox)
      fi
      codex_args+=("$prompt")
      (
        codex "${codex_args[@]}"
        ec=$?
        tmp=$(mktemp)
        if [ "$ec" -eq 0 ]; then
          jq --arg window "$window" '.pending = false | .status = "done" | .window = $window' "$meta" >"$tmp" && mv "$tmp" "$meta"
        else
          jq --arg window "$window" '.status = "error" | .window = $window' "$meta" >"$tmp" && mv "$tmp" "$meta"
        fi
        rm -f "$pid_file"
        exit "$ec"
      ) >>"$log" 2>&1 &
      ;;
    claude)
      if ! command -v claude >/dev/null 2>&1; then
        echo "claude not found" >&2
        mark_status "$meta" "error" "$window"
        exit 1
      fi
      (
        claude -p "$prompt" --cwd "$root"
        ec=$?
        tmp=$(mktemp)
        if [ "$ec" -eq 0 ]; then
          jq --arg window "$window" '.pending = false | .status = "done" | .window = $window' "$meta" >"$tmp" && mv "$tmp" "$meta"
        else
          jq --arg window "$window" '.status = "error" | .window = $window' "$meta" >"$tmp" && mv "$tmp" "$meta"
        fi
        rm -f "$pid_file"
        exit "$ec"
      ) >>"$log" 2>&1 &
      ;;
    *)
      echo "Unsupported provider: $provider" >&2
      mark_status "$meta" "error" "$window"
      exit 1
      ;;
  esac

  local child_pid=$!
  echo "$child_pid" >"$pid_file"
  echo "hyperspace live-doc run pid $child_pid window $window -> $log"
}

main "$@"

#!/usr/bin/env bash

set -euo pipefail

STATE_FILE="$HOME/.config/skhd/presentation_mode"

usage() {
  cat <<'EOF'
Usage:
  hotkeys presentation toggle
  hotkeys terminal new
EOF
}

notify() {
  local title="$1"
  local message="$2"

  /usr/bin/osascript - "$title" "$message" <<'APPLESCRIPT'
on run argv
  display notification item 2 of argv with title item 1 of argv
end run
APPLESCRIPT
}

set_presentation_mode() {
  local state="$1"

  mkdir -p "$(dirname "$STATE_FILE")"
  printf '%s\n' "$state" > "$STATE_FILE"
  if [ "$state" = "on" ]; then
    notify "skhd" "Presentation mode on"
  else
    notify "skhd" "Presentation mode off"
  fi
}

toggle_presentation_mode() {
  if [ -f "$STATE_FILE" ] && [ "$(cat "$STATE_FILE" 2>/dev/null)" = "on" ]; then
    set_presentation_mode off
  else
    set_presentation_mode on
  fi
}

open_terminal_window() {
  local terminal_app="${TERMINAL_APP:-Ghostty}"
  local current_space

  current_space=$(yabai -m query --spaces --space | jq -r '.index')

  # Prevent key-repeat storms from spawning many windows on long key holds.
  local lock_dir="/tmp/open_terminal_window.lock"
  local state_file="/tmp/open_terminal_window.last_ms"
  local cooldown_ms=1200

  if ! mkdir "$lock_dir" 2>/dev/null; then
    exit 0
  fi
  trap 'rmdir "$lock_dir"' EXIT

  local now_ms last_ms
  now_ms=$(perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000')
  if [ -f "$state_file" ]; then
    last_ms=$(cat "$state_file" 2>/dev/null || echo 0)
    if [[ "$last_ms" =~ ^[0-9]+$ ]] && (( now_ms - last_ms < cooldown_ms )); then
      exit 0
    fi
  fi
  printf '%s\n' "$now_ms" > "$state_file"

  local rule_label="temp_terminal_rule_$$"
  yabai -m rule --add app="^${terminal_app}$" space="$current_space" label="$rule_label"

  if [ "$terminal_app" = "Ghostty" ]; then
    open -n -a "$terminal_app"
  elif [ "$terminal_app" = "iTerm2" ]; then
    /usr/bin/osascript -e 'tell application "iTerm2" to create window with default profile'
  elif [ "$terminal_app" = "Terminal" ]; then
    /usr/bin/osascript -e 'tell application "Terminal" to do script ""'
  elif [ "$terminal_app" = "kitty" ]; then
    /Applications/kitty.app/Contents/MacOS/kitty --single-instance --directory="$PWD" &
  else
    open -n -a "$terminal_app"
  fi

  local win_id=""
  for _ in {1..12}; do
    win_id=$(yabai -m query --windows | jq -r --arg app "$terminal_app" --argjson space "$current_space" 'map(select(.app==$app and .space==$space)) | max_by(.id) | .id // empty')
    if [ -n "$win_id" ]; then
      break
    fi
    sleep 0.1
  done

  yabai -m rule --remove "$rule_label" >/dev/null 2>&1 || true

  if [ -n "$win_id" ]; then
    yabai -m window --focus "$win_id" >/dev/null 2>&1 || true
  fi
}

main() {
  local group="${1:-}"
  local action="${2:-}"

  case "$group:$action" in
    presentation:toggle)
      toggle_presentation_mode
      ;;
    terminal:new)
      open_terminal_window
      ;;
    help:|:help|:-h|:--help|"")
      usage
      ;;
    *)
      printf '%s\n' "Unknown command: ${group:-<none>} ${action:-<none>}" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"

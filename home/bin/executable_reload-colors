#!/usr/bin/env bash
# man-me: name=reload-colors
# man-me: category=Window and Display
# man-me: usage=reload-colors
# man-me: description=Restart yabai and skhd, then reload tmux if it is running.
# man-me: tags=reload colors yabai skhd tmux hotkeys

# Script to reload all configurations after changing colorscheme
# Usage: reload-colors

set -e

echo "Reloading configurations with new colorscheme..."

# Restart yabai and skhd to pick up any config changes
echo "  ✓ Restarting yabai and skhd..."
yabai --restart-service
skhd --restart-service

# Reload tmux configuration if tmux is running
if command -v tmux &> /dev/null && tmux list-sessions &> /dev/null; then
    echo "  ✓ Reloading tmux..."
    tmux source-file ~/.tmux.conf
    tmux display-message "Config reloaded!"
fi

echo ""
echo "✓ All configurations reloaded!"
echo ""

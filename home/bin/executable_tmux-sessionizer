#!/usr/bin/env bash
# tmux-sessionizer compatibility wrapper backed by sesh.
# Supports the legacy `-s <index>` mode and interactive selection mode.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  tmux-sessionizer
  tmux-sessionizer -s <index>
EOF
}

if ! command -v sesh >/dev/null 2>&1; then
  echo "sesh is not installed. Install it with: brew install sesh" >&2
  exit 1
fi

if [[ "${1:-}" == "-s" ]]; then
  if [[ -z "${2:-}" ]]; then
    usage
    exit 1
  fi
  slot="$2"

  if ! [[ "$slot" =~ ^[0-9]+$ ]]; then
    echo "Invalid slot: $slot" >&2
    exit 1
  fi

  selected="$(sesh list -t -z 2>/dev/null | sed -n "$((slot + 1))p" | sed '/^$/d' | head -n 1 || true)"
  if [[ -z "$selected" ]]; then
    exit 0
  fi
  exec sesh connect "$selected"
  exit 0
fi

if [[ -n "${1:-}" ]]; then
  exec sesh connect "$1"
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required for interactive sesh selection" >&2
  exit 1
fi

selected="$(sesh list -t -z 2>/dev/null | fzf --height 40% --reverse --border --prompt="⚡  " || true)"
if [[ -z "$selected" ]]; then
  exit 0
fi

exec sesh connect "$selected"

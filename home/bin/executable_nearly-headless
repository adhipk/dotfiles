#!/usr/bin/env bash
# Shim into the standalone nearly-headless project.

set -euo pipefail

PROJECT_DIR="${NEARLY_HEADLESS_PROJECT_DIR:-$HOME/.local/share/nearly-headless}"
BIN="${NEARLY_HEADLESS_BIN:-$PROJECT_DIR/bin/nearly-headless}"
NODE_ENTRY="${NEARLY_HEADLESS_NODE_ENTRY:-$PROJECT_DIR/dist/cli.js}"

if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi

if [ -f "$NODE_ENTRY" ]; then
  exec node "$NODE_ENTRY" "$@"
fi

cat >&2 <<EOF
nearly-headless standalone app is not installed.

Expected compiled binary:
  $BIN

This dotfiles repo only wires the command. The app source lives in:
  git@github.com:adhipk/nearly-headless.git

After chezmoi applies externals, run:
  cd $PROJECT_DIR
  pnpm install --frozen-lockfile
  pnpm build
EOF

exit 127

#!/usr/bin/env bash

set -euo pipefail

SCRATCHPAD_LOG_FILE="${SCRATCHPAD_LOG_FILE:-/tmp/scratchpads_${USER:-unknown}.log}"
TMUX_SESSIONIZER="${TMUX_SESSIONIZER_CMD:-$HOME/bin/tmux-sessionizer-zoxide}"
SPOTLIGHT_ZDOTDIR="${SPOTLIGHT_ZDOTDIR:-$HOME/.config/zsh/spotlight}"

usage() {
  cat <<'EOF'
Usage:
  scratchpads open quick
  scratchpads open dev
  scratchpads open spotlight <label> [command...]
  scratchpads close
  scratchpads blur-close
  scratchpads debug
  scratchpads rules
EOF
}

log() {
  local ts
  ts=$(date '+%Y-%m-%dT%H:%M:%S%z')
  printf '%s [%s] %s\n' "$ts" "${0##*/}" "$*" >> "$SCRATCHPAD_LOG_FILE"
}

# skhd mode toggles: bind Escape to close the scratchpad only while one is
# focused (see ~/.skhdrc `:: scratchpad`). f13 enters that mode, f14 leaves it;
# both are captured in either mode so a redundant toggle is a harmless no-op.
SKHD_BIN="${SKHD_BIN:-skhd}"

enter_scratchpad_mode() {
  if command -v "$SKHD_BIN" >/dev/null 2>&1; then
    "$SKHD_BIN" -k 'f13' >/dev/null 2>&1 || true
  fi
}

leave_scratchpad_mode() {
  if command -v "$SKHD_BIN" >/dev/null 2>&1; then
    "$SKHD_BIN" -k 'f14' >/dev/null 2>&1 || true
  fi
}

query_windows_json() {
  local windows_json
  if ! windows_json=$(yabai -m query --windows 2>/dev/null); then
    log "yabai query --windows unavailable"
    return 1
  fi
  printf '%s\n' "$windows_json"
}

query_focused_window_json() {
  local window_json
  if ! window_json=$(yabai -m query --windows --window 2>/dev/null); then
    log "yabai query --windows --window unavailable"
    return 1
  fi
  printf '%s\n' "$window_json"
}

scratchpad_ids() {
  local label="${1:-}"
  local windows_json

  windows_json=$(query_windows_json) || return 1

  if [ -n "$label" ]; then
    printf '%s\n' "$windows_json" | jq -r --arg label "$label" '
      .[]
      | select((.scratchpad // "") == $label)
      | .id'
  else
    printf '%s\n' "$windows_json" | jq -r '
      .[]
      | select((.scratchpad // "") | length > 0)
      | .id'
  fi
}

scratchpad_visible_ids() {
  local label="$1"
  local windows_json

  windows_json=$(query_windows_json) || return 1
  printf '%s\n' "$windows_json" | jq -r --arg label "$label" '
    .[]
    | select((.scratchpad // "") == $label)
    | select(."is-visible" == true)
    | .id'
}

scratchpad_summaries() {
  local label="${1:-}"
  local windows_json

  windows_json=$(query_windows_json) || return 1

  if [ -n "$label" ]; then
    printf '%s\n' "$windows_json" | jq -c --arg label "$label" '
      .[]
      | select((.scratchpad // "") == $label)
      | {id, app, title, scratchpad, is_visible: ."is-visible", has_focus: ."has-focus"}'
  else
    printf '%s\n' "$windows_json" | jq -c '
      .[]
      | select((.scratchpad // "") | length > 0)
      | {id, app, title, scratchpad, is_visible: ."is-visible", has_focus: ."has-focus"}'
  fi
}

window_id_exists() {
  local target_id="$1"
  local windows_json

  windows_json=$(query_windows_json) || return 2

  printf '%s\n' "$windows_json" | jq -e --argjson target_id "$target_id" '
    any(.[]; .id == $target_id)
  ' >/dev/null
}

focused_non_scratchpad_window_id() {
  local focused_json
  local focused_id
  local focused_label

  focused_json=$(query_focused_window_json) || return 1
  focused_id=$(printf '%s\n' "$focused_json" | jq -r '.id // empty')
  focused_label=$(printf '%s\n' "$focused_json" | jq -r '(.scratchpad // "") | select(length > 0)')

  if [ -n "$focused_id" ] && [ -z "$focused_label" ]; then
    printf '%s\n' "$focused_id"
  fi
}

visible_non_scratchpad_window_id() {
  local windows_json

  windows_json=$(query_windows_json) || return 1
  printf '%s\n' "$windows_json" | jq -r '
    [ .[]
      | select(."is-visible" == true)
      | select((.scratchpad // "") | length == 0)
      | .id
    ] | last // empty'
}

restore_focus_after_close() {
  local preferred_id="${1:-}"
  local fallback_id

  if [ -n "$preferred_id" ] && window_id_exists "$preferred_id"; then
    if yabai -m window "$preferred_id" --focus >/dev/null 2>&1; then
      log "restored focus to previous window id=$preferred_id"
      return 0
    fi
  fi

  if yabai -m window --focus recent >/dev/null 2>&1; then
    log "restored focus to recent window"
    return 0
  fi

  fallback_id=$(visible_non_scratchpad_window_id 2>/dev/null || true)
  if [ -n "$fallback_id" ] && yabai -m window "$fallback_id" --focus >/dev/null 2>&1; then
    log "restored focus to visible non-scratchpad window id=$fallback_id"
    return 0
  fi

  log "could not restore focus after scratchpad close"
  return 1
}

close_focused_scratchpad_window() {
  local app="${1:-}"

  if [ "$app" = "Ghostty" ] && [ "$(uname -s)" = "Darwin" ]; then
    if /usr/bin/osascript <<'APPLESCRIPT' >/dev/null 2>&1
tell application "Ghostty"
  if exists front window then
    close window front window
  end if
end tell
APPLESCRIPT
    then
      log "closed focused Ghostty window via AppleScript"
      return 0
    fi

    log "Ghostty AppleScript close failed; falling back to yabai --close"
  fi

  log "closing focused scratchpad window via yabai app=${app:-<unknown>}"
  yabai -m window --close >/dev/null 2>&1 || true
}

close_window_ids() {
  local label="${1:-}"
  local ids="${2:-}"
  local restore_id="${3:-}"
  local id

  if [ -z "$ids" ]; then
    log "close_window_ids label=${label:-<any>} no windows to close"
    return 0
  fi

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    log "closing scratchpad${label:+ label=$label} id=$id"
    if yabai -m window "$id" --focus >/dev/null 2>&1; then
      sleep 0.1
      local focused_id=""
      local focused_app=""
      if query_focused_window_json >/dev/null 2>&1; then
        local focused_json
        focused_json=$(query_focused_window_json)
        focused_id=$(printf '%s\n' "$focused_json" | jq -r '.id // empty')
        focused_app=$(printf '%s\n' "$focused_json" | jq -r '.app // empty')
        log "focused scratchpad candidate id=$focused_id app=${focused_app:-<empty>}"
      fi

      if [ "$focused_id" = "$id" ]; then
        close_focused_scratchpad_window "$focused_app"
      else
        log "focused window id=$focused_id did not match scratchpad id=$id; skipping front-window close"
        yabai -m window "$id" --close >/dev/null 2>&1 || true
      fi
    else
      log "could not focus scratchpad id=$id; trying yabai close by id"
      yabai -m window "$id" --close >/dev/null 2>&1 || true
    fi

    sleep 0.1
    if window_id_exists "$id"; then
      log "scratchpad id=$id still exists after close attempt"
    else
      case $? in
        1)
          log "confirmed scratchpad id=$id closed"
          ;;
        2)
          log "could not verify scratchpad id=$id after close attempt"
          ;;
        *)
          log "close verification returned unexpected status for id=$id"
          ;;
      esac
    fi
  done <<EOF_IDS
$ids
EOF_IDS

  restore_focus_after_close "$restore_id" || true
}

close_all_scratchpads() {
  local ids
  local restore_id

  log "close_all_scratchpads start"
  hide_scratchpad_label "dev_space_prompt"

  if ! ids=$(query_windows_json 2>/dev/null | jq -r '
    .[]
    | select((.scratchpad // "") | length > 0)
    | select((.scratchpad // "") != "dev_space_prompt")
    | .id'); then
    log "close_all_scratchpads could not query yabai"
    return 0
  fi

  if [ -z "$ids" ]; then
    log "close_all_scratchpads no transient scratchpads to close"
    return 0
  fi

  restore_id=$(focused_non_scratchpad_window_id 2>/dev/null || true)
  close_window_ids "" "$ids" "$restore_id"
  leave_scratchpad_mode
  log "close_all_scratchpads done"
}

close_scratchpads_for_label() {
  local label="$1"
  local ids
  local restore_id

  if ! ids=$(scratchpad_ids "$label" 2>/dev/null); then
    log "close_scratchpads_for_label label=$label could not query yabai"
    return 0
  fi

  if [ -z "$ids" ]; then
    log "close_scratchpads_for_label label=$label nothing to close"
    return 0
  fi

  restore_id=$(focused_non_scratchpad_window_id 2>/dev/null || true)
  close_window_ids "$label" "$ids" "$restore_id"
  leave_scratchpad_mode
}

hide_scratchpad_label() {
  local label="$1"
  local visible_ids
  local restore_id

  if ! visible_ids=$(scratchpad_visible_ids "$label" 2>/dev/null); then
    log "hide_scratchpad_label label=$label could not query yabai"
    return 0
  fi

  if [ -z "$visible_ids" ]; then
    log "hide_scratchpad_label label=$label no visible scratchpad"
    return 0
  fi

  restore_id=$(focused_non_scratchpad_window_id 2>/dev/null || true)
  log "hiding scratchpad label=$label"
  yabai -m window --toggle "$label" >/dev/null 2>&1 || true
  restore_focus_after_close "$restore_id" || true
}

toggle_scratchpad_label() {
  local label="$1"
  local profile="$2"
  local ids
  local visible_ids
  local restore_id
  local win_id

  if ! ids=$(scratchpad_ids "$label" 2>/dev/null); then
    log "toggle_scratchpad_label label=$label could not query yabai"
    return 1
  fi

  if [ -z "$ids" ]; then
    log "toggle_scratchpad_label label=$label nothing to toggle"
    return 1
  fi

  visible_ids=$(scratchpad_visible_ids "$label" 2>/dev/null || true)
  restore_id=$(focused_non_scratchpad_window_id 2>/dev/null || true)

  log "toggling scratchpad label=$label"
  yabai -m window --toggle "$label" >/dev/null 2>&1 || true

  if [ -n "$visible_ids" ]; then
    restore_focus_after_close "$restore_id" || true
    return 0
  fi

  sleep 0.1
  win_id=$(scratchpad_ids "$label" 2>/dev/null | head -1 || true)
  if [ -n "$win_id" ]; then
    yabai -m window "$win_id" --grid "$(scratchpad_grid_for_profile "$profile")" >/dev/null 2>&1 || true
    yabai -m window --focus "$win_id" >/dev/null 2>&1 || true
  fi
}

scratchpad_window_title() {
  printf 'scratchpad:%s\n' "$1"
}

scratchpad_profile_for_label() {
  case "$1" in
    quick_terminal)
      printf '%s\n' "bottom"
      ;;
    dev_space_prompt)
      printf '%s\n' "spotlight"
      ;;
    *)
      printf '%s\n' "spotlight"
      ;;
  esac
}

scratchpad_grid_for_profile() {
  case "$1" in
    bottom)
      printf '%s\n' "6:1:0:4:1:2"
      ;;
    spotlight)
      printf '%s\n' "12:12:2:3:8:5"
      ;;
    *)
      printf '%s\n' "12:12:2:3:8:5"
      ;;
  esac
}

spotlight_ghostty_style_args() {
  printf '%s\n' \
    "--theme=TokyoNight Night" \
    "--font-size=15" \
    "--window-padding-x=18" \
    "--window-padding-y=14" \
    "--background-opacity=0.96" \
    "--cursor-color=#7dd3fc" \
    "--selection-background=#164e63"
}

launch_ghostty() {
  local title="$1"
  local initial_command="${2:-}"
  local profile="${3:-}"
  local cwd="$HOME"
  local ghostty_args=(--working-directory="$cwd" --title="$title")
  local style_arg

  if [ -n "$initial_command" ]; then
    ghostty_args+=(--command="$initial_command")
  fi

  if [ "$profile" = "spotlight" ]; then
    while IFS= read -r style_arg; do
      [ -n "$style_arg" ] && ghostty_args+=("$style_arg")
    done <<EOF_STYLE_ARGS
$(spotlight_ghostty_style_args)
EOF_STYLE_ARGS
  fi

  if [ "$(uname -s)" != "Darwin" ] && command -v ghostty >/dev/null 2>&1; then
    log "launching ghostty window via +new-window cwd=$cwd title=$title"
    if ghostty +new-window "${ghostty_args[@]}" >/dev/null 2>&1; then
      return 0
    fi
    log "ghostty +new-window launch failed; falling back"
  fi

  if [ "$(uname -s)" = "Darwin" ]; then
    log "launching Ghostty via open cwd=$cwd title=$title"
    open -n -a Ghostty --args "${ghostty_args[@]}" >/dev/null 2>&1 || {
      log "Ghostty open launch failed"
      return 1
    }
  else
    log "launching Ghostty via open -n -a Ghostty --args --working-directory=$cwd --title=$title"
    open -n -a Ghostty --args "${ghostty_args[@]}" >/dev/null 2>&1 || {
      log "Ghostty launch failed"
      return 1
    }
  fi
}

send_command_to_ghostty_window() {
  local title="$1"
  local command_text="$2"

  [ -n "$command_text" ] || return 0

  log "sending command to Ghostty window title=$title command=$command_text"
  if ! /usr/bin/osascript - "$title" "$command_text" <<'APPLESCRIPT'
on run argv
  set windowTitle to item 1 of argv
  set commandText to item 2 of argv

  tell application "Ghostty"
    activate
    repeat with win in windows
      if name of win is windowTitle then
        activate window win
        set term to terminal 1 of selected tab of win
        input text commandText to term
        send key "enter" to term
        focus term
        return
      end if
    end repeat
  end tell
end run
APPLESCRIPT
  then
    log "failed to send command to Ghostty window title=$title"
    return 1
  fi
}

center_grid_for_label() {
  scratchpad_grid_for_profile "$(scratchpad_profile_for_label "$1")"
}

print_rule_for_label() {
  local label="$1"
  local profile
  local title
  local grid

  profile=$(scratchpad_profile_for_label "$label")
  title=$(scratchpad_window_title "$label")
  grid=$(scratchpad_grid_for_profile "$profile")

  printf 'yabai -m rule --remove "scratchpad_%s" >/dev/null 2>&1 || true\n' "$label"
  printf 'yabai -m rule --add label="scratchpad_%s" app="^Ghostty$" title="^%s$" scratchpad="%s" grid="%s"\n' "$label" "$title" "$label" "$grid"
}

print_static_rules() {
  print_rule_for_label "quick_terminal"
  print_rule_for_label "dev_space_prompt"
}

ghostty_window_ids_json() {
  local windows_json
  windows_json=$(query_windows_json) || return 1
  printf '%s\n' "$windows_json" | jq -c '[ .[] | select(.app == "Ghostty") | .id ]'
}

ghostty_window_id_for_title() {
  local title="$1"
  local windows_json

  windows_json=$(query_windows_json) || return 1
  printf '%s\n' "$windows_json" | jq -r --arg title "$title" '
    [ .[]
      | select(.app == "Ghostty")
      | select(.title == $title)
      | .id
    ] | last // empty'
}

new_ghostty_window_id() {
  local before_json="${1:-[]}"
  local windows_json="$2"

  printf '%s\n' "$windows_json" | jq -r --argjson before "$before_json" '
    [ .[]
      | select(.app == "Ghostty")
      | .id
    ] - $before
    | last // empty'
}

window_scratchpad_label() {
  local target_id="$1"
  local windows_json

  windows_json=$(query_windows_json) || return 1
  printf '%s\n' "$windows_json" | jq -r --argjson target_id "$target_id" '
    .[]
    | select(.id == $target_id)
    | (.scratchpad // "")'
}

open_scratchpad() {
  local label="$1"
  local profile="${2:-}"
  shift
  if [ $# -gt 0 ]; then
    shift
  fi

  if [ -z "$profile" ]; then
    profile=$(scratchpad_profile_for_label "$label")
  fi

  if [ "$profile" != "bottom" ] && [ "$profile" != "spotlight" ]; then
    printf '%s\n' "Unknown scratchpad profile: $profile" >&2
    return 1
  fi

  open_scratchpad_with_profile "$label" "$profile" "$@"
}

open_scratchpad_with_profile() {
  local label="$1"
  local profile="$2"
  shift
  shift

  local existing_ids
  local before_json="[]"
  local windows_json
  local win_id
  local title
  local command_text=""
  local initial_command=""

  log "open label=$label profile=$profile args=$*"

  if existing_ids=$(scratchpad_ids "$label" 2>/dev/null); then
    if [ -n "$existing_ids" ]; then
      if [ "$label" = "dev_space_prompt" ]; then
        log "existing persistent scratchpad label=$label found; toggling visibility"
        toggle_scratchpad_label "$label" "$profile"
      else
        log "existing scratchpad label=$label found; closing instead of spawning a duplicate"
        close_scratchpads_for_label "$label"
      fi
      return 0
    fi
  else
    log "open label=$label could not inspect existing scratchpads"
  fi

  if windows_json=$(ghostty_window_ids_json 2>/dev/null); then
    before_json="$windows_json"
  fi

  title=$(scratchpad_window_title "$label")

  if [ "$label" = "dev_space_prompt" ]; then
    log "launching dev scratchpad with spotlight zshrc"
    initial_command="direct:$HOME/bin/spotlight-zsh"
    command_text="exec env SPOTLIGHT_ZDOTDIR=\"$SPOTLIGHT_ZDOTDIR\" $HOME/bin/spotlight-zsh"
  else
    log "launching quick scratchpad"
    command_text="${*:-}"
  fi

  if win_id=$(ghostty_window_id_for_title "$title" 2>/dev/null); then
    if [ -n "$win_id" ]; then
      log "found existing Ghostty window with scratchpad title label=$label win_id=$win_id"
      yabai -m window "$win_id" --scratchpad "$label" >/dev/null 2>&1 || true
      yabai -m window "$win_id" --grid "$(scratchpad_grid_for_profile "$profile")" >/dev/null 2>&1 || true
      yabai -m window --focus "$win_id" >/dev/null 2>&1 || true
      enter_scratchpad_mode
      send_command_to_ghostty_window "$title" "$command_text" || true
      return 0
    fi
  fi

  launch_ghostty "$title" "$initial_command" "$profile"

  for _ in {1..30}; do
    if ! windows_json=$(query_windows_json 2>/dev/null); then
      sleep 0.1
      continue
    fi

    win_id=$(new_ghostty_window_id "$before_json" "$windows_json")
    if [ -n "$win_id" ]; then
      break
    fi
    sleep 0.1
  done

  if [ -n "$win_id" ]; then
    local assigned_label
    assigned_label=$(window_scratchpad_label "$win_id" 2>/dev/null || true)
    if [ "$assigned_label" = "$label" ]; then
      log "static rule assigned label=$label to win_id=$win_id"
    else
      log "fallback assigning label=$label to win_id=$win_id current_label=${assigned_label:-<empty>}"
      yabai -m window "$win_id" --scratchpad "$label" >/dev/null 2>&1 || true
    fi
    yabai -m window "$win_id" --grid "$(scratchpad_grid_for_profile "$profile")" >/dev/null 2>&1 || true
    yabai -m window --focus "$win_id" >/dev/null 2>&1 || true
    enter_scratchpad_mode
    send_command_to_ghostty_window "$title" "$command_text" || true
  else
    log "failed to locate the new Ghostty window for label=$label"
  fi
}

close_scratchpads_if_blurred() {
  local focused_json
  local focused_label
  local focused_id

  sleep 0.1
  if ! focused_json=$(query_focused_window_json 2>/dev/null); then
    log "blur-close could not query focused window"
    return 0
  fi

  focused_id=$(printf '%s\n' "$focused_json" | jq -r '.id // empty')
  focused_label=$(printf '%s\n' "$focused_json" | jq -r '(.scratchpad // "") | select(length > 0)')
  log "blur-close focused_id=${focused_id:-<empty>} focused_label=${focused_label:-<empty>}"

  if [ -n "$focused_label" ]; then
    log "blur-close ignored because the focused window is still a scratchpad"
    # A scratchpad holds focus -> arm Escape-to-close for it.
    enter_scratchpad_mode
    return 0
  fi

  hide_scratchpad_label "dev_space_prompt"
  close_scratchpads_for_label "quick_terminal"
  # Focus left every scratchpad -> Escape goes back to behaving normally.
  leave_scratchpad_mode
}

debug_state() {
  {
    printf 'log_file=%s\n' "$SCRATCHPAD_LOG_FILE"
    printf 'tmux_sessionizer=%s\n' "$TMUX_SESSIONIZER"
    printf 'spotlight_zdotdir=%s\n' "$SPOTLIGHT_ZDOTDIR"
    printf '\nfocused_window:\n'
    if query_focused_window_json >/dev/null 2>&1; then
      query_focused_window_json | jq '{id, app, title, scratchpad, is_visible: ."is-visible", has_focus: ."has-focus"}'
    else
      printf '(unavailable)\n'
    fi
    printf '\nscratchpads:\n'
    if scratchpad_output=$(scratchpad_summaries 2>/dev/null); then
      if [ -n "$scratchpad_output" ]; then
        printf '%s\n' "$scratchpad_output"
      else
        printf '(none)\n'
      fi
    else
      printf '(unavailable)\n'
    fi
  } | tee -a "$SCRATCHPAD_LOG_FILE"
}

main() {
  local group="${1:-}"
  local action="${2:-}"

  case "$group:$action" in
    open:quick)
      open_scratchpad "quick_terminal" "bottom"
      ;;
    open:dev)
      open_scratchpad "dev_space_prompt" "spotlight"
      ;;
    open:spotlight)
      label="${3:-}"
      shift 3 || true
      if [ -z "$label" ]; then
        printf '%s\n' "Usage: scratchpads open spotlight <label> [command...]" >&2
        exit 1
      fi
      open_scratchpad "$label" "spotlight" "$@"
      ;;
    close:)
      close_all_scratchpads
      ;;
    blur-close:)
      close_scratchpads_if_blurred
      ;;
    debug:)
      debug_state
      ;;
    rules:)
      print_static_rules
      ;;
    :|help:|:help|:-h|:--help)
      usage
      ;;
    *)
      printf '%s\n' "Unknown command: ${group:-<none>} ${action:-<none>}" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"

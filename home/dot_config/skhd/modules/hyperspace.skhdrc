# Experimental hyperspace keybindings.
# This module is intentionally not loaded by home/dot_skhdrc.
#
# To try it again, append this file to an active skhd config or move the
# bindings into a generated module loader once skhd configuration is modular.

# -- Hyperspaces (sesh sessions) --
# Caps Lock held as hyper: ctrl + alt + cmd (existing Karabiner mapping)
:: hyper_pinned @ : osascript -e 'display notification "Press 1-9 for hyperspace slot" with title "Hyperspace"'
ctrl + alt + cmd + shift - 0x18 ; hyper_pinned  # hyper + '+'
hyper_pinned < 1 : ~/.config/skhd/modules/hyperspace/hyperspace pin 1; skhd -k "escape"
hyper_pinned < 2 : ~/.config/skhd/modules/hyperspace/hyperspace pin 2; skhd -k "escape"
hyper_pinned < 3 : ~/.config/skhd/modules/hyperspace/hyperspace pin 3; skhd -k "escape"
hyper_pinned < 4 : ~/.config/skhd/modules/hyperspace/hyperspace pin 4; skhd -k "escape"
hyper_pinned < 5 : ~/.config/skhd/modules/hyperspace/hyperspace pin 5; skhd -k "escape"
hyper_pinned < 6 : ~/.config/skhd/modules/hyperspace/hyperspace pin 6; skhd -k "escape"
hyper_pinned < 7 : ~/.config/skhd/modules/hyperspace/hyperspace pin 7; skhd -k "escape"
hyper_pinned < 8 : ~/.config/skhd/modules/hyperspace/hyperspace pin 8; skhd -k "escape"
hyper_pinned < 9 : ~/.config/skhd/modules/hyperspace/hyperspace pin 9; skhd -k "escape"
hyper_pinned < escape ; default

:: hyper_unpin @ : osascript -e 'display notification "Press 1-9 to unpin hyperspace" with title "Hyperspace"'
ctrl + alt + cmd - 0x1B ; hyper_unpin  # hyper + '-'
hyper_unpin < 1 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 1; skhd -k "escape"
hyper_unpin < 2 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 2; skhd -k "escape"
hyper_unpin < 3 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 3; skhd -k "escape"
hyper_unpin < 4 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 4; skhd -k "escape"
hyper_unpin < 5 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 5; skhd -k "escape"
hyper_unpin < 6 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 6; skhd -k "escape"
hyper_unpin < 7 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 7; skhd -k "escape"
hyper_unpin < 8 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 8; skhd -k "escape"
hyper_unpin < 9 : ~/.config/skhd/modules/hyperspace/hyperspace unpin 9; skhd -k "escape"
hyper_unpin < escape ; default

ctrl + alt + cmd - 1 : ~/.config/skhd/modules/hyperspace/hyperspace connect 1
ctrl + alt + cmd - 2 : ~/.config/skhd/modules/hyperspace/hyperspace connect 2
ctrl + alt + cmd - 3 : ~/.config/skhd/modules/hyperspace/hyperspace connect 3
ctrl + alt + cmd - 4 : ~/.config/skhd/modules/hyperspace/hyperspace connect 4
ctrl + alt + cmd - 5 : ~/.config/skhd/modules/hyperspace/hyperspace connect 5
ctrl + alt + cmd - 6 : ~/.config/skhd/modules/hyperspace/hyperspace connect 6
ctrl + alt + cmd - 7 : ~/.config/skhd/modules/hyperspace/hyperspace connect 7
ctrl + alt + cmd - 8 : ~/.config/skhd/modules/hyperspace/hyperspace connect 8
ctrl + alt + cmd - 9 : ~/.config/skhd/modules/hyperspace/hyperspace connect 9
ctrl + alt + cmd - space : ~/.config/skhd/modules/hyperspace/hyperspace search

# -- Spotlight scratchpad --
ctrl + alt + cmd - n : ~/.config/skhd/modules/hyperspace/open_spotlight_scratchpad

# Lightweight zsh configuration for the spotlight terminal.

SPOTLIGHT_SHELL="${SPOTLIGHT_SHELL:-1}"
SPOTLIGHT_ZDOTDIR_ACTIVE="${ZDOTDIR:-$HOME}"
unset ZDOTDIR SPOTLIGHT_SHELL

export PATH="$HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export EDITOR="${EDITOR:-nvim}"

HISTFILE="$SPOTLIGHT_ZDOTDIR_ACTIVE/.zsh_history"
HISTSIZE=500
SAVEHIST=500

setopt autocd
setopt no_beep
setopt hist_ignore_dups
setopt share_history

autoload -Uz colors
colors

PROMPT='%F{cyan}spotlight%f %1~ %# '
RPROMPT=''

alias python=python3

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

[ -f "$HOME/.zshrc.spotlight.local" ] && source "$HOME/.zshrc.spotlight.local"

# man-me: name=daemon
# man-me: category=Terminal and Sessions
# man-me: usage=daemon NAME COMMAND [ARG ...]
# man-me: description=Run a command with nohup, write /tmp logs, and create a tmux log-tail session.
# man-me: tags=tmux terminal daemon background log logs nohup
daemon() {
  local logfile="${1:-daemon}"
  shift

  nohup "$@" > "/tmp/${logfile}.log" 2>&1 < /dev/null &
  echo $! > "/tmp/${logfile}.pid"

  echo "Started PID $(cat /tmp/${logfile}.pid)"
  echo "Logs: /tmp/${logfile}.log"

  # Create tmux session to tail the log
  local session_name="daemon-${logfile}"

  if tmux has-session -t "$session_name" 2>/dev/null; then
    echo "Tmux session '$session_name' already exists"
    echo "Attach with: tmux attach -t $session_name"
  else
    tmux new-session -d -s "$session_name" "tail -f /tmp/${logfile}.log"
    echo "Created tmux session '$session_name' tailing logs"
    echo "Attach with: tmux attach -t $session_name"
  fi
}
 
# man-me: name=tms
# man-me: category=Terminal and Sessions
# man-me: usage=tms [SESSION] [DIRECTORY]
# man-me: description=Create a detached tmux session without switching to it.
# man-me: tags=tmux terminal session sessions
# Create a tmux session in background without switching to it
tms() {
  local session_name="${1:-$(basename $(pwd))}"
  local directory="${2:-$(pwd)}"

  if tmux has-session -t "$session_name" 2>/dev/null; then
    echo "Session '$session_name' already exists"
    return 1
  fi

  tmux new-session -d -s "$session_name" -c "$directory"
  echo "Created session '$session_name' in $directory"
  echo "Switch with: Alt+F or tmux attach -t $session_name"
}

# man-me: name=svg-png
# man-me: category=Text, Speech, and Clipboard
# man-me: usage=svg-png <file.svg> [size]
# man-me: description=Render an SVG thumbnail PNG with qlmanage.
# man-me: tags=svg png image convert qlmanage clipboard
svg-png() {
  local file="${1:-}"
  local size="${2:-256}"

  if [[ -z "$file" || "$file" == "-h" || "$file" == "--help" ]]; then
    echo "Usage: svg-png <file.svg> [size]" >&2
    return 2
  fi

  if [[ ! -f "$file" ]]; then
    echo "svg-png: file not found: $file" >&2
    return 1
  fi

  if [[ "$size" != <-> ]] || (( size < 1 )); then
    echo "svg-png: size must be a positive integer" >&2
    return 2
  fi

  qlmanage -t -s "$size" -o . "$file"
}

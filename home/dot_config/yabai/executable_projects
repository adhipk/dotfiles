#!/usr/bin/env bash

set -euo pipefail

PROJECTS_FILE="${PROJECTS_FILE:-$HOME/.config/yabai/projects.json}"
PROJECT_SLOT_RE='^[1-5]$'
SPACE_SLOT_RE='^[1-9]$'
PROJECT_ID_RE='^[a-z0-9][a-z0-9_-]*$'

usage() {
  cat <<'EOF'
Usage:
  projects create <id> [--name NAME] [--slot N]
      Create a project and optionally bind it to Hyper+N (1-5).
  projects delete <id>
  projects hibernate [SESSION]
      Save the whole projects graph as a session, clear active controls, hide project apps, and focus Home.
  projects restore-session <SESSION|latest> [--force] [--no-focus]
      Restore a hibernated projects graph.
  projects sessions [--json]
  projects list [--json]
  projects adopt [--project ID] [--project-slot N]
      Adopt the current space into a project and assign the next free Alt+Shift slot (1-9).
      Requires project context (Hyper+1-5) or --project / --project-slot.
  projects change-space --project ID
  projects detach
  projects set-space-slot <1-9>
      Move or swap the current space to a specific Alt+Shift shortcut.
  projects clear-space-slot <1-9>
  projects focus-project <1-5>
  projects focus-space <1-9>
  projects cycle next|prev
  projects show
  projects status
  projects pick
      ProjectDeck UI (falls back to macOS dialog if not built).
  projects menu-json [--menu NAME] [--project ID]
  projects pick-exec <line>
  projects pick-sub <line>
  projects new [id] [--name NAME]
      Create a project on the next free Hyper slot and adopt the current space.
  projects record-focus
EOF
}

notify() {
  [[ "${PROJECTS_NOTIFY:-1}" == "0" ]] && return 0
  "$HOME/.config/skhd/notify.sh" "$1" "$2" || true
}

notify_success() {
  if [[ "${PROJECTS_NOTIFY_SUCCESS:-0}" == "1" ]]; then
    notify "$1" "$2"
  fi
  return 0
}

die() {
  echo "projects: $1" >&2
  notify "Projects" "$1"
  exit 1
}

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is not installed"
}

require_tools() {
  require_jq
  command -v yabai >/dev/null 2>&1 || die "yabai is not installed"
}

pick_line_label() {
  local line="$1"
  local label
  label=$(printf '%s' "$line" | cut -d: -f4-)
  if [[ -n "$label" ]]; then
    printf '%s' "$label"
  else
    printf '%s' "$line"
  fi
}

osascript_choose() {
  local title="$1" prompt="$2"
  shift 2
  local items_file selected

  [[ $# -gt 0 ]] || return 1
  items_file=$(mktemp "${TMPDIR:-/tmp}/projects-pick.XXXXXX")
  printf '%s\n' "$@" >"$items_file"

  selected=$(/usr/bin/osascript - "$title" "$prompt" "$items_file" <<'APPLESCRIPT'
on run argv
  set dialogTitle to item 1 of argv
  set dialogPrompt to item 2 of argv
  set itemsPath to item 3 of argv
  set rawText to read POSIX file itemsPath as «class utf8»
  set theItems to paragraphs of rawText
  if (count of theItems) is 0 then return ""
  try
    set picked to choose from list theItems with title dialogTitle with prompt dialogPrompt OK button name "OK" cancel button name "Cancel"
    if picked is false then return ""
    return item 1 of picked
  on error
    return ""
  end try
end run
APPLESCRIPT
  ) || true

  rm -f "$items_file"
  [[ -n "$selected" && "$selected" != "false" ]] || return 1
  printf '%s' "$selected"
}

osascript_confirm() {
  local title="$1" message="$2" confirm_button="${3:-OK}"

  [[ "${PROJECTS_CONFIRM:-1}" == "0" ]] && return 0
  local result
  result=$(/usr/bin/osascript - "$title" "$message" "$confirm_button" <<'APPLESCRIPT'
on run argv
  set dialogTitle to item 1 of argv
  set dialogMessage to item 2 of argv
  set confirmName to item 3 of argv
  try
    set clicked to button returned of (display alert dialogTitle message dialogMessage as warning buttons {"Cancel", confirmName} default button "Cancel" cancel button "Cancel")
    return clicked = confirmName
  on error number -128
    return false
  end try
end run
APPLESCRIPT
  ) || return 1
  [[ "$result" == "true" ]]
}

osascript_prompt() {
  local title="$1" prompt="$2" default="${3:-}"
  local result

  result=$(/usr/bin/osascript - "$title" "$prompt" "$default" <<'APPLESCRIPT'
on run argv
  set dialogTitle to item 1 of argv
  set dialogPrompt to item 2 of argv
  set defaultAnswer to item 3 of argv
  try
    if defaultAnswer is "" then
      set response to display dialog dialogPrompt with title dialogTitle default answer ""
    else
      set response to display dialog dialogPrompt with title dialogTitle default answer defaultAnswer
    end if
    return text returned of response
  on error number -128
    return ""
  on error
    return ""
  end try
end run
APPLESCRIPT
  ) || true

  [[ -n "$result" ]] || return 1
  printf '%s' "$result"
}

dialog_menu() {
  local title="$1" prompt="$2"
  shift 2
  local -a labels=() lines=("$@")
  local line label selected i

  for line in "${lines[@]}"; do
    labels+=("$(pick_line_label "$line")")
  done

  selected=$(osascript_choose "$title" "$prompt" "${labels[@]}") || return 1

  for i in "${!labels[@]}"; do
    if [[ "${labels[$i]}" == "$selected" ]]; then
      printf '%s\n' "${lines[$i]}"
      return 0
    fi
  done
  return 1
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g; s/-+/-/g'
}

validate_project_id() {
  local id="$1"
  [[ "$id" =~ $PROJECT_ID_RE ]] || die "invalid project id: $id"
}

validate_project_slot() {
  [[ "$1" =~ $PROJECT_SLOT_RE ]] || die "invalid project slot: $1 (use 1-5)"
}

validate_space_slot() {
  [[ "$1" =~ $SPACE_SLOT_RE ]] || die "invalid space slot: $1 (use 1-9)"
}

ensure_store() {
  local dir
  dir=$(dirname "$PROJECTS_FILE")
  mkdir -p "$dir"

  if [[ ! -f "$PROJECTS_FILE" ]] || [[ ! -s "$PROJECTS_FILE" ]]; then
    printf '%s\n' '{"project_slots":{"1":null,"2":null,"3":null,"4":null,"5":null},"last_project":null,"projects":{}}' >"$PROJECTS_FILE"
  fi
}

STORE_CACHE=""

invalidate_store() {
  STORE_CACHE=""
}

store_json() {
  if [[ -n "$STORE_CACHE" ]]; then
    printf '%s' "$STORE_CACHE"
    return 0
  fi
  ensure_store
  STORE_CACHE=$(jq -c '.' "$PROJECTS_FILE")
  printf '%s' "$STORE_CACHE"
}

write_json() {
  local tmp
  tmp=$(mktemp "${PROJECTS_FILE}.XXXXXX")
  cat >"$tmp"
  mv "$tmp" "$PROJECTS_FILE"
  invalidate_store
}

read_store() {
  store_json
}

update_store() {
  local result
  if ! result=$(store_json | jq -c "$@"); then
    die "failed to update projects store"
  fi
  printf '%s' "$result" | write_json
}

set_last_project() {
  local project_id="$1"
  [[ -n "$project_id" ]] || return 0
  update_store --arg id "$project_id" '.last_project = $id'
}

last_project_id() {
  store_json | jq -r '.last_project // empty'
}

context_project_id() {
  local id
  id=$(active_project_id 2>/dev/null || true)
  [[ -n "$id" ]] && printf '%s\n' "$id" && return 0
  id=$(last_project_id)
  [[ -n "$id" && "$id" != "null" ]] \
    && project_exists "$id" \
    && ! project_is_suspended "$id" \
    && printf '%s\n' "$id"
}

first_empty_project_slot() {
  store_json | jq -r '
    .project_slots
    | to_entries
    | map(select(.value == null or .value == ""))
    | .[0].key // empty
  '
}

project_hyper_slot() {
  local project_id="$1"
  store_json | jq -r --arg id "$project_id" '
    .project_slots
    | to_entries[]
    | select(.value == $id)
    | .key
  ' | head -n 1
}

project_hyper_slots_json() {
  local project_id="$1"
  store_json | jq -c --arg id "$project_id" '
    .project_slots
    | to_entries
    | map(select(.value == $id) | .key)
  '
}

project_is_suspended() {
  local project_id="$1"
  read_store | jq -e --arg id "$project_id" '(.projects[$id].suspended // false) == true' >/dev/null
}

focus_project_id() {
  local project_id="$1"
  local slot uuid

  validate_project_id "$project_id"
  project_exists "$project_id" || die "project not found: $project_id"
  project_is_suspended "$project_id" && die "project $project_id is suspended; run: projects restore $project_id"

  slot=$(project_hyper_slot "$project_id")
  if [[ -n "$slot" ]]; then
    focus_project_slot "$slot"
    return 0
  fi

  uuid=$(store_json | jq -r --arg id "$project_id" '.projects[$id].last_space // empty')
  if [[ -z "$uuid" || "$uuid" == "null" ]] || ! space_exists "$uuid"; then
    uuid=$(ordered_project_spaces "$project_id" | head -n 1)
  fi
  [[ -n "$uuid" ]] || die "project $project_id has no spaces"

  focus_space_uuid "$uuid"
  update_store --arg id "$project_id" --arg uuid "$uuid" '.projects[$id].last_space = $uuid'
  set_last_project "$project_id"
}

prompt_project_name() {
  local query

  if [[ -n "${PROJECTS_PICK_NAME:-}" ]]; then
    printf '%s\n' "$(slugify "$PROJECTS_PICK_NAME")"
    return 0
  fi

  query=$(osascript_prompt "New Project" "Project name:" "") || return 1
  [[ -n "$query" ]] || return 1
  slugify "$query"
}

pick_header_text() {
  local active context cur_uuid cur_project space_slot index parts=()

  active=$(active_project_id 2>/dev/null || true)
  context=$(context_project_id 2>/dev/null || true)
  cur_uuid=$(current_space_uuid 2>/dev/null || true)

  if [[ -n "$active" ]]; then
    space_slot=$(space_slot_for_uuid "$active" "$cur_uuid" 2>/dev/null || true)
    index=$(space_index_for_uuid "$cur_uuid" 2>/dev/null || true)
    parts+=("Active: $active")
    [[ -n "$index" ]] && parts+=("space $index")
    [[ -n "$space_slot" ]] && parts+=("Alt+Shift+$space_slot")
  elif [[ -n "$context" ]]; then
    parts+=("Context: $context")
    parts+=("current space not adopted")
  else
    parts+=("No project context")
  fi

  local IFS=' · '
  printf '%s' "${parts[*]}"
}

build_pick_lines() {
  local store active context cur_uuid cur_project project_id slot_num space_count marker label

  store=$(store_json)
  active=$(active_project_id 2>/dev/null || true)
  context=$(context_project_id 2>/dev/null || true)
  cur_uuid=$(current_space_uuid 2>/dev/null || true)
  cur_project=$(project_id_for_space "$cur_uuid" 2>/dev/null || true)

  printf '%s\n' "ACTION:new::＋ Create project and adopt current space"
  if [[ -n "$cur_uuid" && -z "$cur_project" ]]; then
    printf '%s\n' "ACTION:adopt::↳ Add current space to project…"
  fi
  if [[ -n "${active:-$context}" ]]; then
    printf '%s\n' "ACTION:spaces:${active:-$context}:◇ Spaces · detach · delete…"
  fi
  if [[ -n "$cur_project" ]]; then
    printf '%s\n' "ACTION:detach::− Remove current space from project"
  fi
  printf '%s\n' "SEP:::"

  for slot_num in 1 2 3 4 5; do
    project_id=$(printf '%s' "$store" | jq -r --arg slot "$slot_num" '.project_slots[$slot] // empty')
    if [[ -n "$project_id" && "$project_id" != "null" ]]; then
      space_count=$(printf '%s' "$store" | jq -r --arg id "$project_id" '.projects[$id].spaces | length')
      marker="  "
      if [[ "$project_id" == "$active" ]]; then
        marker="● "
      elif [[ "$project_id" == "$context" && -z "$active" ]]; then
        marker="◦ "
      fi
      label=$(printf '%s' "$store" | jq -r --arg id "$project_id" '.projects[$id].name // $id')
      printf 'PROJECT:%s:%s:%s%s · Hyper%s · %s space(s)\n' \
        "$project_id" "$slot_num" "$marker" "$label" "$slot_num" "$space_count"
    else
      printf 'SLOT::%s:  (empty Hyper%s)\n' "$slot_num" "$slot_num"
    fi
  done
}

build_space_pick_lines() {
  local project_id="$1"
  local cur_uuid slot_num uuid index label marker name

  cur_uuid=$(current_space_uuid 2>/dev/null || true)
  for slot_num in 1 2 3 4 5 6 7 8 9; do
    uuid=$(store_json | jq -r --arg id "$project_id" --arg slot "$slot_num" '.projects[$id].space_slots[$slot] // empty')
    [[ -z "$uuid" || "$uuid" == "null" ]] && continue
    index=$(space_index_for_uuid "$uuid" 2>/dev/null || true)
    label=$(space_label_for_uuid "$uuid" 2>/dev/null || true)
    marker="  "
    [[ "$uuid" == "$cur_uuid" ]] && marker="● "
    printf 'SPACE:%s::%sAlt+Shift+%s · space %s' "$slot_num" "$marker" "$slot_num" "${index:-?}"
    [[ -n "$label" && "$label" != "null" ]] && printf ' · %s' "$label"
    printf '\n'
    printf 'DETACH:%s:%s:  ✕ Remove · Alt+Shift+%s · space %s\n' \
      "$project_id" "$slot_num" "$slot_num" "${index:-?}"
  done
  name=$(store_json | jq -r --arg id "$project_id" '.projects[$id].name // $id')
  printf 'DELETE:%s::✕ Delete project "%s"\n' "$project_id" "$name"
}

cmd_new() {
  local id="${1:-}"
  local name="" slot

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --foreground)
        shift
        ;;
      --name)
        name="${2:-}"
        shift 2
        ;;
      *)
        if [[ -z "$id" ]]; then
          id="$1"
        fi
        shift
        ;;
    esac
  done

  require_tools

  if [[ -z "$id" ]] && projectdeck_bin >/dev/null 2>&1; then
    PROJECTS_PICK_MENU=create launch_projectdeck
  fi

  if [[ -z "$id" ]]; then
    id=$(prompt_project_name || true)
    [[ -n "$id" ]] || return 0
  else
    id=$(slugify "$id")
  fi

  [[ -z "$name" ]] && name="$id"

  slot=$(first_empty_project_slot)
  [[ -n "$slot" ]] || die "all Hyper slots (1-5) are full"

  if project_exists "$id"; then
    die "project already exists: $id"
  fi

  create_project "$id" "$name"
  assign_project_slot "$slot" "$id"
  adopt_space "$id" "" false
  notify "Projects" "Created $name on Hyper+$slot"
}

cmd_status() {
  local active context header

  require_tools
  active=$(active_project_id 2>/dev/null || true)
  context=$(context_project_id 2>/dev/null || true)
  header=$(pick_header_text)
  printf '%s\n' "$header"
}

projectdeck_bin() {
  local candidate
  for candidate in \
    "${PROJECTDECK_BIN:-}" \
    "$HOME/.config/yabai/projectdeck"
  do
    [[ -n "$candidate" && -x "$candidate" ]] && {
      printf '%s' "$candidate"
      return 0
    }
  done
  return 1
}

launch_projectdeck() {
  local deck
  deck=$(projectdeck_bin || true)
  [[ -n "$deck" ]] || die "projectdeck not installed — run: scripts/build-projectdeck.sh"
  export PROJECTS_BIN="${PROJECTS_BIN:-$HOME/.config/yabai/projects}"
  exec -a projectdeck "$deck"
}

menu_item_json() {
  local line="$1" section="$2" active="${3:-false}"
  local label
  label=$(pick_line_label "$line")
  jq -nc \
    --arg line "$line" \
    --arg label "$label" \
    --arg section "$section" \
    --argjson active "$active" \
    '{line: $line, label: $label, section: $section, active: $active}'
}

cmd_menu_json() {
  local menu="main" project_id="" active=""
  local -a items=()
  local line kind id slot section is_active store

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --menu)
        menu="${2:-main}"
        shift 2
        ;;
      --project)
        project_id="${2:-}"
        shift 2
        ;;
      *)
        die "unknown menu-json argument: $1"
        ;;
    esac
  done

  require_tools
  active=$(active_project_id 2>/dev/null || true)
  store=$(store_json)

  case "$menu" in
    main)
      while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        [[ "$line" == SEP:* ]] && continue
        kind=$(printf '%s' "$line" | cut -d: -f1)
        case "$kind" in
          ACTION) items+=("$(menu_item_json "$line" "actions" false)") ;;
          PROJECT)
            id=$(printf '%s' "$line" | cut -d: -f2)
            is_active=false
            [[ "$id" == "$active" ]] && is_active=true
            items+=("$(menu_item_json "$line" "project" "$is_active")")
            ;;
          SLOT) items+=("$(menu_item_json "$line" "slot" false)") ;;
        esac
      done < <(build_pick_lines)
      ;;
    adopt)
      while IFS= read -r project_id; do
        [[ -n "$project_id" ]] || continue
        line="ADOPT:${project_id}::$(printf '%s' "$store" | jq -r --arg id "$project_id" '.projects[$id].name // $id')"
        items+=("$(menu_item_json "$line" "project" false)")
      done < <(printf '%s' "$store" | jq -r '.projects | keys[]')
      ;;
    spaces:*)
      project_id="${menu#spaces:}"
      [[ -n "$project_id" ]] || die "spaces menu requires project id"
      while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        kind=$(printf '%s' "$line" | cut -d: -f1)
        slot=$(printf '%s' "$line" | cut -d: -f2)
        is_active=false
        case "$kind" in
          SPACE)
            uuid=$(store_json | jq -r --arg id "$project_id" --arg slot "$slot" '.projects[$id].space_slots[$slot] // empty')
            [[ -n "$uuid" && "$uuid" == "$(current_space_uuid 2>/dev/null || true)" ]] && is_active=true
            items+=("$(menu_item_json "$line" "space" "$is_active")")
            ;;
          DETACH|DELETE)
            items+=("$(menu_item_json "$line" "danger" false)")
            ;;
        esac
      done < <(build_space_pick_lines "$project_id")
      ;;
    create)
      :
      ;;
    *)
      die "unknown menu: $menu"
      ;;
  esac

  jq -nc \
    --arg header "$(pick_header_text)" \
    --argjson items "$(if ((${#items[@]})); then printf '%s\n' "${items[@]}" | jq -s '.'; else printf '[]'; fi)" \
    '{header: $header, items: $items}'
}

cmd_pick_sub() {
  local line="$1"
  local kind id slot

  [[ -n "$line" ]] || return 0
  kind=$(printf '%s' "$line" | cut -d: -f1)
  id=$(printf '%s' "$line" | cut -d: -f2)
  slot=$(printf '%s' "$line" | cut -d: -f3)

  case "$kind" in
    ACTION)
      case "$id" in
        adopt) PROJECTS_PICK_MENU=adopt launch_projectdeck ;;
        spaces) PROJECTS_PICK_MENU="spaces:${slot}" launch_projectdeck ;;
        *) die "unsupported pick sub-menu: $line" ;;
      esac
      ;;
    *)
      die "unsupported pick sub-menu: $line"
      ;;
  esac
}

cmd_pick_adopt_menu() {
  if projectdeck_bin >/dev/null 2>&1; then
    PROJECTS_PICK_MENU=adopt launch_projectdeck
  fi

  local store project_id lines=() selected

  store=$(store_json)
  while IFS= read -r project_id; do
    [[ -n "$project_id" ]] || continue
    lines+=("ADOPT:$project_id::$(printf '%s' "$store" | jq -r --arg id "$project_id" '.projects[$id].name // $id')")
  done < <(printf '%s' "$store" | jq -r '.projects | keys[]')

  ((${#lines[@]} == 0)) && die "no projects — create one first"

  selected=$(dialog_menu "$(pick_header_text)" "Adopt to:" "${lines[@]}") || return 0
  [[ -n "$selected" ]] || return 0

  project_id=$(printf '%s' "$selected" | cut -d: -f2)
  adopt_space "$project_id" "" true
  notify "Projects" "Adopted into $project_id"
}

cmd_pick_spaces_menu() {
  local project_id="${1:-}"

  [[ -n "$project_id" ]] || project_id=$(context_project_id || true)
  [[ -n "$project_id" ]] || die "no project context"

  if projectdeck_bin >/dev/null 2>&1; then
    PROJECTS_PICK_MENU="spaces:${project_id}" launch_projectdeck
  fi

  local lines=() selected slot

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    lines+=("$line")
  done < <(build_space_pick_lines "$project_id")

  ((${#lines[@]} == 0)) && die "project $project_id has no space shortcuts"

  selected=$(dialog_menu "$(pick_header_text)" "Choose a space:" "${lines[@]}") || return 0
  [[ -n "$selected" ]] || return 0

  cmd_pick_execute "$selected"
}

cmd_pick_execute() {
  local line="$1"
  local kind id slot

  kind=$(printf '%s' "$line" | cut -d: -f1)
  id=$(printf '%s' "$line" | cut -d: -f2)
  slot=$(printf '%s' "$line" | cut -d: -f3)

  case "$kind" in
    ACTION)
      case "$id" in
        new) cmd_new ;;
        adopt) cmd_pick_sub "$line" ;;
        spaces) cmd_pick_sub "$line" ;;
        detach) detach_space ;;
      esac
      ;;
    ADOPT)
      adopt_space "$id" "" true
      notify_success "Projects" "Adopted into $id"
      ;;
    SPACE)
      focus_space_slot "$slot"
      ;;
    DETACH)
      detach_space_by_slot "$id" "$slot"
      ;;
    DELETE)
      confirm_delete_project "$id"
      ;;
    PROJECT)
      focus_project_id "$id"
      ;;
    SLOT)
      if [[ -n "$slot" ]]; then
        id=$(prompt_project_name || true)
        [[ -n "$id" ]] || return 0
        if project_exists "$id"; then
          assign_project_slot "$slot" "$id"
          adopt_space "$id" "" false
          notify "Projects" "Assigned $id to Hyper+$slot"
        else
          create_project "$id" "$id"
          assign_project_slot "$slot" "$id"
          adopt_space "$id" "" false
          notify "Projects" "Created $id on Hyper+$slot"
        fi
      fi
      ;;
  esac
}

cmd_pick() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --foreground)
        shift
        ;;
      *)
        die "unknown pick argument: $1"
        ;;
    esac
  done

  require_tools

  if projectdeck_bin >/dev/null 2>&1; then
    PROJECTS_PICK_MENU="${PROJECTS_PICK_MENU:-main}"
    launch_projectdeck
  fi

  local lines=() selected

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    [[ "$line" == SEP:* ]] && continue
    lines+=("$line")
  done < <(build_pick_lines)

  selected=$(dialog_menu "Projects" "$(pick_header_text)" "${lines[@]}") || return 0
  [[ -n "$selected" ]] || return 0
  cmd_pick_execute "$selected"
}

current_space_json() {
  yabai -m query --spaces --space
}

current_space_uuid() {
  current_space_json | jq -r '.uuid // empty'
}

space_json_for_uuid() {
  local uuid="$1"
  yabai -m query --spaces | jq -c --arg uuid "$uuid" '.[] | select(.uuid == $uuid)'
}

space_exists() {
  local uuid="$1"
  [[ -n "$(space_json_for_uuid "$uuid")" ]]
}

space_index_for_uuid() {
  local uuid="$1"
  yabai -m query --spaces | jq -r --arg uuid "$uuid" '.[] | select(.uuid == $uuid) | .index // empty'
}

space_label_for_uuid() {
  local uuid="$1"
  yabai -m query --spaces | jq -r --arg uuid "$uuid" '.[] | select(.uuid == $uuid) | .label // ""'
}

focus_space_uuid() {
  local uuid="$1"
  local index current_uuid

  index=$(space_index_for_uuid "$uuid")
  [[ -n "$index" ]] || die "space no longer exists"

  current_uuid=$(current_space_uuid)
  if [[ "$current_uuid" == "$uuid" ]]; then
    return 0
  fi

  yabai -m space --focus "$index"
}

project_label_for_space() {
  local project_id="$1"
  local space_slot="${2:-}"
  local name

  name=$(read_store | jq -r --arg id "$project_id" '.projects[$id].name // $id')
  if [[ -n "$space_slot" ]]; then
    printf '%s · %s' "$name" "$space_slot"
  else
    printf '%s' "$name"
  fi
}

clear_space_label() {
  local uuid="$1"
  local index

  [[ -n "$uuid" ]] || return 0
  command -v yabai >/dev/null 2>&1 || return 0
  index=$(space_index_for_uuid "$uuid" 2>/dev/null || true)
  [[ -n "$index" ]] || return 0
  yabai -m space "$index" --label "" >/dev/null 2>&1 || true
}

refresh_space_label() {
  local uuid="$1"
  local project_id="$2"
  local space_slot="${3:-}"
  local index label

  index=$(space_index_for_uuid "$uuid") || return 0
  label=$(project_label_for_space "$project_id" "$space_slot")
  yabai -m space "$index" --label "$label" >/dev/null 2>&1 || true
}

project_id_for_space() {
  local uuid="$1"
  local include_suspended="${2:-false}"
  read_store | jq -r --arg uuid "$uuid" --arg include_suspended "$include_suspended" '
    .projects
    | to_entries[]
    | select(
        ($include_suspended == "true" or ((.value.suspended // false) | not))
        and (
          any(.value.spaces // []; . == $uuid)
          or any([.value.space_slots // {} | .[]]; . == $uuid)
        )
      )
    | .key
    | @text
    ' | head -n 1
}

active_project_id() {
  local uuid
  uuid=$(current_space_uuid)
  [[ -n "$uuid" ]] || return 1
  project_id_for_space "$uuid"
}

project_exists() {
  local id="$1"
  read_store | jq -e --arg id "$id" '.projects[$id] != null' >/dev/null
}

ensure_project() {
  local id="$1"
  local name="${2:-$1}"

  validate_project_id "$id"
  ensure_store

  if ! project_exists "$id"; then
    update_store --arg id "$id" --arg name "$name" '
      .projects[$id] = {
        id: $id,
        name: $name,
        last_space: null,
        spaces: [],
        space_slots: {}
      }
    '
  fi
}

create_project() {
  local id="$1"
  local name="${2:-$1}"

  validate_project_id "$id"
  if project_exists "$id"; then
    die "project already exists: $id"
  fi

  ensure_project "$id" "$name"
  set_last_project "$id"
  notify_success "Projects" "Created project $name"
}

adopt_space() {
  local project_id="${1:-}"
  local project_slot="${2:-}"
  local allow_move="${3:-false}"
  local uuid name existing

  uuid=$(current_space_uuid)
  [[ -n "$uuid" ]] || die "could not read current space"

  if [[ -n "$project_slot" ]]; then
    validate_project_slot "$project_slot"
    if [[ -z "$project_id" ]]; then
      project_id=$(read_store | jq -r --arg slot "$project_slot" '.project_slots[$slot] // empty')
      if [[ -z "$project_id" || "$project_id" == "null" ]]; then
        die "project slot $project_slot is empty — run: projects create <id> --slot $project_slot"
      fi
    fi
  elif [[ -z "$project_id" ]]; then
    project_id=$(context_project_id || true)
    if [[ -z "$project_id" ]]; then
      die "no project context — focus one with Hyper+1-5 or run: projects create <id> --slot N"
    fi
  fi

  validate_project_id "$project_id"
  ensure_project "$project_id" "$project_id"

  existing=$(project_id_for_space "$uuid")
  if [[ -n "$existing" && "$existing" == "$project_id" ]]; then
    update_store --arg id "$project_id" --arg uuid "$uuid" '.projects[$id].last_space = $uuid'
    set_last_project "$project_id"
    return 0
  fi

  if [[ -n "$existing" && "$existing" != "$project_id" ]]; then
    if [[ "$allow_move" == true ]]; then
      remove_space_from_project "$existing" "$uuid"
    else
      die "space already belongs to project $existing (use projects change-space --project ID)"
    fi
  fi

  update_store --arg id "$project_id" --arg uuid "$uuid" '
    .projects[$id].spaces = ((.projects[$id].spaces // []) + [$uuid] | unique)
    | .projects[$id].last_space = $uuid
  '

  local space_slot project_name
  space_slot=$(append_space_slot "$project_id" "$uuid" || true)
  refresh_space_label "$uuid" "$project_id" "$space_slot"
  set_last_project "$project_id"

  project_name=$(store_json | jq -r --arg id "$project_id" '.projects[$id].name')
  if [[ -n "$space_slot" ]]; then
    notify_success "Projects" "Adopted into $project_name (Alt+Shift+$space_slot)"
  elif [[ -z "$(space_slot_for_uuid "$project_id" "$uuid")" ]]; then
    notify_success "Projects" "Adopted into $project_name (no shortcut slots left)"
  fi
}

change_space_project() {
  local project_id="$1"
  validate_project_id "$project_id"
  adopt_space "$project_id" "" true
}

clear_project_space_labels() {
  local id="$1"
  local uuid

  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    clear_space_label "$uuid"
  done < <(read_store | jq -r --arg id "$id" '
    [(.projects[$id].spaces // []), (.projects[$id].space_slots // {} | .[])]
    | flatten
    | map(select(. != null and . != ""))
    | unique
    | .[]
  ')
}

confirm_delete_project() {
  local id="$1"
  local name

  validate_project_id "$id"
  project_exists "$id" || die "project not found: $id"
  name=$(store_json | jq -r --arg id "$id" '.projects[$id].name // $id')
  osascript_confirm "Delete project?" \
    "Delete \"$name\" and remove it from all Hyper slots. Space labels will be cleared." \
    "Delete" || return 0
  delete_project "$id"
}

delete_project() {
  local id="$1"
  validate_project_id "$id"
  project_exists "$id" || die "project not found: $id"

  clear_project_space_labels "$id"
  update_store --arg id "$id" '
    del(.projects[$id])
    | .project_slots |= with_entries(if .value == $id then .value = null else . end)
    | if .last_project == $id then .last_project = null else . end
  '
  notify_success "Projects" "Deleted project $id"
}

rename_project() {
  local old_id="$1"
  local new_id="$2"
  validate_project_id "$old_id"
  validate_project_id "$new_id"
  project_exists "$old_id" || die "project not found: $old_id"
  project_exists "$new_id" && die "project already exists: $new_id"

  update_store --arg old "$old_id" --arg new "$new_id" '
    .projects[$new] = (.projects[$old] | .id = $new)
    | del(.projects[$old])
    | .project_slots |= with_entries(if .value == $old then .value = $new else . end)
  '
  notify_success "Projects" "Renamed $old_id to $new_id"
}

remove_space_from_project() {
  local project_id="$1"
  local uuid="$2"

  update_store --arg id "$project_id" --arg uuid "$uuid" '
    .projects[$id].spaces = ((.projects[$id].spaces // []) | map(select(. != $uuid)))
    | .projects[$id].space_slots = (
        .projects[$id].space_slots // {}
        | with_entries(if .value == $uuid then .value = null else . end)
      )
    | if .projects[$id].last_space == $uuid then .projects[$id].last_space = ((.projects[$id].spaces // []) | last // null) else . end
  '

  clear_space_label "$uuid"
}

detach_space_by_slot() {
  local project_id="$1"
  local slot="$2"
  local uuid name

  validate_project_id "$project_id"
  validate_space_slot "$slot"
  project_exists "$project_id" || die "project not found: $project_id"
  uuid=$(store_json | jq -r --arg id "$project_id" --arg slot "$slot" '.projects[$id].space_slots[$slot] // empty')
  [[ -n "$uuid" && "$uuid" != "null" ]] || die "no space on Alt+Shift+$slot"
  name=$(store_json | jq -r --arg id "$project_id" '.projects[$id].name // $id')
  osascript_confirm "Remove space?" \
    "Remove Alt+Shift+$slot from \"$name\"? The yabai space label will be cleared." \
    "Remove" || return 0
  remove_space_from_project "$project_id" "$uuid"
  notify_success "Projects" "Removed Alt+Shift+$slot from $name"
}

detach_space() {
  local uuid project_id name
  uuid=$(current_space_uuid)
  [[ -n "$uuid" ]] || die "could not read current space"
  project_id=$(project_id_for_space "$uuid")
  [[ -n "$project_id" ]] || die "current space is not in a project"
  name=$(store_json | jq -r --arg id "$project_id" '.projects[$id].name // $id')
  remove_space_from_project "$project_id" "$uuid"
  notify_success "Projects" "Detached space from $name"
}

cmd_remove_space() {
  local uuid="${1:-}"
  [[ -n "$uuid" ]] || uuid=$(current_space_uuid)
  [[ -n "$uuid" ]] || die "could not read space uuid"

  local project_id
  project_id=$(project_id_for_space "$uuid")
  [[ -n "$project_id" ]] || die "space is not in a project"
  remove_space_from_project "$project_id" "$uuid"
  notify_success "Projects" "Removed space from $project_id"
}

assign_project_slot() {
  local slot="$1"
  local project_id="$2"
  validate_project_slot "$slot"
  validate_project_id "$project_id"
  ensure_project "$project_id" "$project_id"

  update_store --arg slot "$slot" --arg id "$project_id" '.project_slots[$slot] = $id'
  set_last_project "$project_id"
  notify_success "Projects" "Project $project_id assigned to slot $slot"
}

clear_project_slot() {
  local slot="$1"
  validate_project_slot "$slot"
  update_store --arg slot "$slot" '.project_slots[$slot] = null'
  notify_success "Projects" "Cleared project slot $slot"
}

space_slot_for_uuid() {
  local project_id="$1"
  local uuid="$2"
  read_store | jq -r --arg id "$project_id" --arg uuid "$uuid" '
    .projects[$id].space_slots // {}
    | to_entries[]
    | select(.value == $uuid)
    | .key
    ' | head -n 1
}

next_free_space_slot() {
  local project_id="$1"
  read_store | jq -r --arg id "$project_id" '
    (.projects[$id].space_slots // {}) as $slots
    | [range(1; 10) | tostring]
    | map(select(($slots[.] // "") == ""))
    | .[0] // empty
  '
}

append_space_slot() {
  local project_id="$1"
  local uuid="$2"
  local slot existing_slot

  existing_slot=$(space_slot_for_uuid "$project_id" "$uuid")
  if [[ -n "$existing_slot" ]]; then
    printf '%s\n' "$existing_slot"
    return 0
  fi

  slot=$(next_free_space_slot "$project_id")
  [[ -n "$slot" ]] || return 1

  update_store --arg id "$project_id" --arg slot "$slot" --arg uuid "$uuid" '
    .projects[$id].space_slots[$slot] = $uuid
  '
  printf '%s\n' "$slot"
}

set_space_slot() {
  local slot="$1"
  local project_id uuid current_slot other_uuid

  validate_space_slot "$slot"
  project_id=$(context_project_id || true)
  [[ -n "$project_id" ]] || die "no project context; focus a project with Hyper+1-5"

  uuid=$(current_space_uuid)
  [[ -n "$uuid" ]] || die "could not read current space"

  existing=$(project_id_for_space "$uuid")
  if [[ -z "$existing" ]]; then
    adopt_space "$project_id" "" false
  elif [[ "$existing" != "$project_id" ]]; then
    die "space belongs to project $existing"
  fi

  other_uuid=$(read_store | jq -r --arg id "$project_id" --arg slot "$slot" '.projects[$id].space_slots[$slot] // empty')
  current_slot=$(space_slot_for_uuid "$project_id" "$uuid")

  if [[ -n "$other_uuid" && "$other_uuid" != "null" && "$other_uuid" != "$uuid" ]]; then
    if [[ -n "$current_slot" ]]; then
      update_store --arg id "$project_id" --arg slot "$slot" --arg uuid "$uuid" --arg current "$current_slot" --arg other "$other_uuid" '
        .projects[$id].space_slots[$slot] = $uuid
        | .projects[$id].space_slots[$current] = $other
      '
      refresh_space_label "$other_uuid" "$project_id" "$current_slot"
    else
      update_store --arg id "$project_id" --arg slot "$slot" --arg uuid "$uuid" --arg other "$other_uuid" '
        .projects[$id].space_slots[$slot] = $uuid
        | .projects[$id].space_slots |= with_entries(if .value == $other and .key != $slot then .value = null else . end)
      '
      refresh_space_label "$other_uuid" "$project_id" ""
    fi
  else
    if [[ -n "$current_slot" && "$current_slot" != "$slot" ]]; then
      update_store --arg id "$project_id" --arg slot "$slot" --arg uuid "$uuid" --arg current "$current_slot" '
        .projects[$id].space_slots[$slot] = $uuid
        | del(.projects[$id].space_slots[$current])
      '
    else
      update_store --arg id "$project_id" --arg slot "$slot" --arg uuid "$uuid" '
        .projects[$id].space_slots[$slot] = $uuid
      '
    fi
  fi

  refresh_space_label "$uuid" "$project_id" "$slot"
  set_last_project "$project_id"
  notify_success "Projects" "Space shortcut set to $slot"
}

swap_space_slot() {
  set_space_slot "$1"
}

clear_space_slot() {
  local slot="$1"
  local project_id uuid

  validate_space_slot "$slot"
  project_id=$(context_project_id || true)
  [[ -n "$project_id" ]] || die "no project context; focus a project with Hyper+1-5"

  uuid=$(read_store | jq -r --arg id "$project_id" --arg slot "$slot" '.projects[$id].space_slots[$slot] // empty')
  update_store --arg id "$project_id" --arg slot "$slot" 'del(.projects[$id].space_slots[$slot])'

  if [[ -n "$uuid" && "$uuid" != "null" ]]; then
    refresh_space_label "$uuid" "$project_id" ""
  fi
  set_last_project "$project_id"
  notify_success "Projects" "Cleared space slot $slot"
}

ordered_project_spaces() {
  local project_id="$1"
  read_store | jq -r --arg id "$project_id" '
    def slots:
      (.projects[$id].space_slots // {})
      | to_entries
      | map(select(.value != null and .value != ""))
      | sort_by(.key | tonumber);
    def slotted: slots | map(.value);
    def unslotted:
      (.projects[$id].spaces // [])
      | map(select((slotted | index(.) == null)));
    (slots | map(.value)), unslotted
    | add
    | unique
    | .[]
  '
}

focus_project_slot() {
  local slot="$1"
  local project_id uuid

  validate_project_slot "$slot"
  project_id=$(read_store | jq -r --arg slot "$slot" '.project_slots[$slot] // empty')
  [[ -n "$project_id" && "$project_id" != "null" ]] || die "project slot $slot is empty"

  uuid=$(read_store | jq -r --arg id "$project_id" '.projects[$id].last_space // empty')
  if [[ -z "$uuid" || "$uuid" == "null" ]] || ! space_exists "$uuid"; then
    uuid=$(ordered_project_spaces "$project_id" | head -n 1)
  fi
  [[ -n "$uuid" ]] || die "project $project_id has no spaces"

  focus_space_uuid "$uuid"
  update_store --arg id "$project_id" --arg uuid "$uuid" '.projects[$id].last_space = $uuid'
  set_last_project "$project_id"
}

focus_space_slot() {
  local slot="$1"
  local project_id uuid

  validate_space_slot "$slot"
  project_id=$(context_project_id || true)
  [[ -n "$project_id" ]] || die "no project context; focus a project with Hyper+1-5"

  uuid=$(read_store | jq -r --arg id "$project_id" --arg slot "$slot" '.projects[$id].space_slots[$slot] // empty')
  [[ -n "$uuid" && "$uuid" != "null" ]] || die "space slot $slot is empty in $project_id"

  focus_space_uuid "$uuid"
  update_store --arg id "$project_id" --arg uuid "$uuid" '.projects[$id].last_space = $uuid'
  set_last_project "$project_id"
}

cycle_project_spaces() {
  local direction="$1"
  local project_id spaces current_uuid index next_uuid

  project_id=$(context_project_id || true)
  [[ -n "$project_id" ]] || die "no project context; focus a project with Hyper+1-5"

  current_uuid=$(current_space_uuid)
  spaces=()
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    spaces+=("$line")
  done < <(ordered_project_spaces "$project_id")

  ((${#spaces[@]} == 0)) && die "project has no spaces"
  if ((${#spaces[@]} == 1)); then
    focus_space_uuid "${spaces[0]}"
    update_store --arg id "$project_id" --arg uuid "${spaces[0]}" '.projects[$id].last_space = $uuid'
    set_last_project "$project_id"
    return 0
  fi

  index=0
  local i
  for i in "${!spaces[@]}"; do
    if [[ "${spaces[$i]}" == "$current_uuid" ]]; then
      index=$i
      break
    fi
  done

  if [[ "$direction" == "next" ]]; then
    next_uuid="${spaces[$(( (index + 1) % ${#spaces[@]} ))]}"
  else
    next_uuid="${spaces[$(( (index - 1 + ${#spaces[@]}) % ${#spaces[@]} ))]}"
  fi

  focus_space_uuid "$next_uuid"
  update_store --arg id "$project_id" --arg uuid "$next_uuid" '.projects[$id].last_space = $uuid'
  set_last_project "$project_id"
}

record_focus() {
  local uuid project_id
  uuid=$(current_space_uuid)
  [[ -n "$uuid" ]] || exit 0
  project_id=$(project_id_for_space "$uuid")
  [[ -n "$project_id" ]] || exit 0
  update_store --arg id "$project_id" --arg uuid "$uuid" '.projects[$id].last_space = $uuid'
  set_last_project "$project_id"
}

cmd_get() {
  local id="${1:-}"
  if [[ -z "$id" ]]; then
    id=$(context_project_id || true)
    [[ -n "$id" ]] || die "no project context"
  fi
  project_exists "$id" || die "project not found: $id"
  read_store | jq --arg id "$id" '.projects[$id]'
}

cmd_list_json() {
  read_store | jq '
    {
      project_slots: .project_slots,
      last_project: .last_project,
      projects: (.projects | to_entries | map({
        id: .key,
        name: .value.name,
        space_count: (.value.spaces | length),
        last_space: .value.last_space,
        space_slots: .value.space_slots
      }))
    }
  '
}

cmd_list() {
  local store active_id project_id uuid index label slot_num
  store=$(read_store)
  active_id=$(active_project_id 2>/dev/null || true)

  printf '%s\n' "Project shortcuts (Hyper+1..5):"
  for slot_num in 1 2 3 4 5; do
    project_id=$(printf '%s' "$store" | jq -r --arg slot "$slot_num" '.project_slots[$slot] // empty')
    if [[ -n "$project_id" && "$project_id" != "null" ]]; then
      printf '  %s: %s\n' "$slot_num" "$project_id"
    else
      printf '  %s: (empty)\n' "$slot_num"
    fi
  done

  printf '%s\n' ""
  printf '%s' "$store" | jq -r '.projects | keys[]' | while read -r project_id; do
    [[ -n "$project_id" ]] || continue
    if [[ "$project_id" == "$active_id" ]]; then
      printf '%s (active)\n' "$project_id"
    else
      printf '%s\n' "$project_id"
    fi

    for slot_num in 1 2 3 4 5 6 7 8 9; do
      uuid=$(printf '%s' "$store" | jq -r --arg id "$project_id" --arg slot "$slot_num" '.projects[$id].space_slots[$slot] // empty')
      [[ -z "$uuid" || "$uuid" == "null" ]] && continue
      if command -v yabai >/dev/null 2>&1; then
        index=$(space_index_for_uuid "$uuid")
        label=$(space_label_for_uuid "$uuid")
        printf '  Alt+Shift+%s → space %s' "$slot_num" "$index"
        [[ -n "$label" && "$label" != "null" ]] && printf ' (%s)' "$label"
        printf '\n'
      else
        printf '  Alt+Shift+%s → %s\n' "$slot_num" "$uuid"
      fi
    done
    printf '\n'
  done
}

cmd_show() {
  local message="" project_id uuid index label slot
  local store
  store=$(read_store)

  local slot_num
  for slot_num in 1 2 3 4 5; do
    project_id=$(printf '%s' "$store" | jq -r --arg slot "$slot_num" '.project_slots[$slot] // empty')
    if [[ -n "$project_id" && "$project_id" != "null" ]]; then
      message="${message}P${slot_num}: ${project_id}\n"
    fi
  done

  project_id=$(active_project_id || true)
  if [[ -n "$project_id" ]]; then
    message="${message}\nActive: ${project_id}\n"
    local space_num
    for space_num in 1 2 3 4 5 6 7 8 9; do
      uuid=$(printf '%s' "$store" | jq -r --arg id "$project_id" --arg slot "$space_num" '.projects[$id].space_slots[$slot] // empty')
      if [[ -n "$uuid" && "$uuid" != "null" ]]; then
        index=$(space_index_for_uuid "$uuid")
        label=$(space_label_for_uuid "$uuid")
        message="${message}${space_num}: space ${index}"
        [[ -n "$label" ]] && message="${message} (${label})"
        message="${message}\n"
      fi
    done
  fi

  if [[ -z "$message" ]]; then
    notify "Projects" "No projects configured"
    return 0
  fi

  message=$(printf '%b' "$message" | sed '/^$/d')
  notify "Projects" "$message"
}

cmd_active() {
  active_project_id || true
}

main() {
  local command="${1:-}"
  shift || true

  case "$command" in
    create)
      local id="${1:-}"
      local name=""
      local slot=""
      shift || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --name)
            name="${2:-}"
            shift 2
            ;;
          --slot)
            slot="${2:-}"
            shift 2
            ;;
          *)
            die "unknown create argument: $1"
            ;;
        esac
      done
      [[ -n "$id" ]] || die "create requires a project id"
      [[ -z "$name" ]] && name="$id"
      require_jq
      id=$(slugify "$id")
      create_project "$id" "$name"
      if [[ -n "$slot" ]]; then
        require_tools
        assign_project_slot "$slot" "$id"
      fi
      ;;
    adopt)
      local project_id="" project_slot=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --project)
            project_id="$(slugify "${2:-}")"
            shift 2
            ;;
          --project-slot)
            project_slot="${2:-}"
            shift 2
            ;;
          *)
            die "unknown adopt argument: $1"
            ;;
        esac
      done
      require_tools
      adopt_space "$project_id" "$project_slot" false
      ;;
    change-space)
      local project_id=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --project)
            project_id="$(slugify "${2:-}")"
            shift 2
            ;;
          *)
            die "unknown change-space argument: $1"
            ;;
        esac
      done
      [[ -n "$project_id" ]] || die "change-space requires --project ID"
      require_tools
      change_space_project "$project_id"
      ;;
    get)
      require_tools
      cmd_get "${1:-}"
      ;;
    list)
      ensure_store
      require_jq
      if [[ "${1:-}" == "--json" ]]; then
        cmd_list_json
      else
        require_tools
        cmd_list
      fi
      ;;
    show)
      require_tools
      cmd_show
      ;;
    status)
      require_tools
      cmd_status
      ;;
    pick)
      cmd_pick "$@"
      ;;
    pick-exec)
      [[ -n "${1:-}" ]] || die "pick-exec requires a menu line"
      require_tools
      cmd_pick_execute "$1"
      ;;
    pick-sub)
      [[ -n "${1:-}" ]] || die "pick-sub requires a menu line"
      require_tools
      cmd_pick_sub "$1"
      ;;
    menu-json)
      cmd_menu_json "$@"
      ;;
    new)
      cmd_new "$@"
      ;;
    active)
      require_tools
      cmd_active
      ;;
    rename)
      [[ $# -eq 2 ]] || die "rename requires <id> <new-id>"
      require_tools
      rename_project "$(slugify "$1")" "$(slugify "$2")"
      ;;
    delete)
      [[ -n "${1:-}" ]] || die "delete requires <id>"
      require_jq
      confirm_delete_project "$(slugify "$1")"
      ;;
    remove-space)
      require_tools
      cmd_remove_space "${1:-}"
      ;;
    detach)
      require_tools
      detach_space
      ;;
    assign-project-slot)
      [[ $# -eq 2 ]] || die "assign-project-slot requires <1-5> <id>"
      require_tools
      assign_project_slot "$1" "$(slugify "$2")"
      ;;
    clear-project-slot)
      [[ -n "${1:-}" ]] || die "clear-project-slot requires <1-5>"
      ensure_store
      clear_project_slot "$1"
      ;;
    set-space-slot|swap-space-slot)
      [[ -n "${1:-}" ]] || die "set-space-slot requires <1-9>"
      require_tools
      set_space_slot "$1"
      ;;
    clear-space-slot)
      [[ -n "${1:-}" ]] || die "clear-space-slot requires <1-9>"
      require_tools
      clear_space_slot "$1"
      ;;
    focus-project)
      [[ -n "${1:-}" ]] || die "focus-project requires <1-5>"
      require_tools
      focus_project_slot "$1"
      ;;
    focus-space)
      [[ -n "${1:-}" ]] || die "focus-space requires <1-9>"
      require_tools
      focus_space_slot "$1"
      ;;
    cycle)
      [[ -n "${1:-}" ]] || die "cycle requires next|prev"
      require_tools
      cycle_project_spaces "$1"
      ;;
    record-focus)
      require_tools
      record_focus
      ;;
    help|-h|--help|"")
      usage
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"

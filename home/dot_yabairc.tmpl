#!/usr/bin/env sh

yabai -m signal --remove "space_display_load_sa" >/dev/null 2>&1 || true
{{ if .modules.spaceDisplay.enabled }}{{ includeTemplate "../modules/space-display/targets/yabairc-scripting-addition.tmpl" . | trim }}{{ end }}

yabai -m signal --remove "hide_scratchpads_on_focus_change" >/dev/null 2>&1 || true
yabai -m signal --remove "hide_scratchpads_on_app_switch" >/dev/null 2>&1 || true
yabai -m signal --remove "hide_scratchpads_on_app_deactivate" >/dev/null 2>&1 || true
yabai -m signal --remove "projects_record_focus" >/dev/null 2>&1 || true
yabai -m signal --remove "app_mru_update" >/dev/null 2>&1 || true
yabai -m signal --remove "tile_pip_on_create" >/dev/null 2>&1 || true
yabai -m signal --remove "tile_pip_on_title_change" >/dev/null 2>&1 || true
yabai -m signal --remove "normalize_pip_on_create" >/dev/null 2>&1 || true
yabai -m signal --remove "normalize_pip_on_title_change" >/dev/null 2>&1 || true
yabai -m rule --remove "tile_pip_windows" >/dev/null 2>&1 || true
# Project contexts are dormant; the removal above cleans up any signal left by
# an older config without reinstalling it.
{{ if .modules.appFocus.enabled }}{{ includeTemplate "../modules/app-focus/targets/yabai-signals.sh.tmpl" . | trim }}{{ end }}
{{ if .modules.appearancePip.enabled }}{{ includeTemplate "../modules/appearance-pip/targets/yabairc-signals.tmpl" . | trim }}{{ end }}

yabai -m config debug_output on

# Always remove rules owned by the optional window-layout module before
# conditionally mounting it. This reconciles a disabled module and leaves the
# parent renderable after its source folder is removed.
for label in \
  window_layout_system_settings \
  window_layout_calculator \
  window_layout_karabiner \
  window_layout_archive_utility \
  window_layout_finder_dialogs \
  window_layout_activity_monitor \
  window_layout_app_store \
  window_layout_system_information \
  window_layout_keychain_access \
  window_layout_shortcut_guide; do
  yabai -m rule --remove "$label" >/dev/null 2>&1 || true
done
yabai -m rule --list 2>/dev/null \
  | jq -r '.[] | select(.label | startswith("float_pref_")) | .label' \
  | while read -r label; do
      [ -n "$label" ] || continue
      yabai -m rule --remove "$label" >/dev/null 2>&1 || true
    done

{{ if .modules.windowLayout.enabled }}{{ includeTemplate "../modules/window-layout/targets/yabairc.tmpl" . | trim }}{{ end }}

{{ if .modules.appearancePip.enabled }}{{ includeTemplate "../modules/appearance-pip/targets/yabairc-style.tmpl" . | trim }}{{ end }}

# Always clear current and historical scratchpad rules before optionally
# mounting the module. This also reconciles a disable before source removal.
yabai -m rule --remove "scratchpad_terminal" >/dev/null 2>&1 || true
yabai -m rule --remove "scratchpad_quick_terminal" >/dev/null 2>&1 || true
yabai -m rule --remove "scratchpad_codex_dotfiles" >/dev/null 2>&1 || true
yabai -m rule --remove "scratchpad_projects_tmux" >/dev/null 2>&1 || true
{{ if .modules.scratchpads.enabled }}{{ includeTemplate "../modules/scratchpads/targets/yabairc.tmpl" . | trim }}{{ end }}

{{ if .modules.windowLayout.enabled }}{{ includeTemplate "../modules/window-layout/targets/yabairc-restore.tmpl" . | trim }}{{ end }}

{{ if .modules.spaceDisplay.enabled }}{{ includeTemplate "../modules/space-display/targets/yabairc-spaces.tmpl" . | trim }}{{ end }}

{{ if .modules.appearancePip.enabled }}{{ includeTemplate "../modules/appearance-pip/targets/yabairc-display-padding.tmpl" . | trim }}{{ end }}

{{ if .modules.appearancePip.enabled }}{{ includeTemplate "../modules/appearance-pip/targets/yabairc-launch.tmpl" . | trim }}{{ end }}

echo "yabai configuration loaded..."

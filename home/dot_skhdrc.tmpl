# -- Ghostty management (right Command) --
# Keep left Command application-local. These right-Command chords only emit
# synthetic function keys while Ghostty is focused; every other app receives
# the original chord unchanged.
{{ if .modules.terminalWindowTypes.enabled }}# dotfiles-owner: terminal-window-types
{{ includeTemplate "../modules/terminal-window-types/targets/skhdrc.tmpl" . }}
# dotfiles-owner: root
{{ end }}
rcmd - s [
    "Ghostty" : skhd -k "f18"  # Open tmux session picker
    * ~
]

rcmd - space [
    "Ghostty" : skhd -k "f19"  # Search tmux commands with Telescope
    * ~
]

{{ if .modules.tmuxSessions.enabled }}# dotfiles-owner: tmux-sessions
rcmd - h [
    "Ghostty" : skhd -k "f20"  # Open centralized tmux hub
    * ~
]
# dotfiles-owner: root
{{ end }}

# ============================================================
# Screenshots (Fn+Shift)
# Fn owns transient scratchpads; its shifted digit layer forwards to the
# native macOS screenshot shortcuts without colliding with project switching.
# ============================================================

fn + shift - 1 : skhd -k "cmd + shift - 3"         # Save full-screen screenshot
fn + shift - 2 : skhd -k "ctrl + cmd + shift - 3"  # Copy full-screen screenshot
fn + shift - 3 : skhd -k "cmd + shift - 4"         # Save selection screenshot
fn + shift - 4 : skhd -k "ctrl + cmd + shift - 4"  # Copy selection screenshot

# ============================================================
# Restart yabai + skhd
# ============================================================

alt - r : yabai --restart-service; skhd --restart-service


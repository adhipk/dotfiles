[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"
    [".tmux/plugins/tpm".pull]
        args = ["--ff-only"]

{{- range .chromeExtensions }}
[".local/share/chrome-extensions/{{ .name }}"]
    type = "git-repo"
    url = "{{ .url }}"
    refreshPeriod = "{{ .refreshPeriod }}"
    [".local/share/chrome-extensions/{{ .name }}".pull]
        args = ["--ff-only"]
{{ end -}}

{{- range .externalProjects }}
["{{ .path }}"]
    type = "git-repo"
    url = "{{ .url }}"
    refreshPeriod = "{{ .refreshPeriod }}"
    ["{{ .path }}".pull]
        args = ["--ff-only"]
{{ end -}}

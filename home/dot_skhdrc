# ============================================================
# Window Management (ctrl + opt + <key>) — BSP tiling
# Caps Lock can be held as ctrl + opt + cmd via Karabiner-Elements.
# ============================================================

# -- Cycle through windows on current desktop --
alt - tab : yabai -m window --focus stack.next || yabai -m window --focus stack.first
shift + alt - tab : yabai -m window --focus stack.prev || yabai -m window --focus stack.last

# -- Set window to 50% split --
ctrl + alt - left  : ~/.config/skhd/snap_window.sh left
ctrl + alt - right : ~/.config/skhd/snap_window.sh right
ctrl + alt - h : ~/.config/skhd/snap_window.sh left
ctrl + alt - k : ~/.config/skhd/snap_window.sh right

# -- Swap windows --
ctrl + alt + shift - left  : yabai -m window --swap west
ctrl + alt + shift - right : yabai -m window --swap east
ctrl + alt + shift - up    : yabai -m window --swap north
ctrl + alt + shift - down  : yabai -m window --swap south
ctrl + alt + shift - h : yabai -m window --swap west
ctrl + alt + shift - k : yabai -m window --swap east
ctrl + alt + shift - u : yabai -m window --swap north
ctrl + alt + shift - j : yabai -m window --swap south

# -- Resize window incrementally --
ctrl + alt + cmd - left  : yabai -m window --resize left:-100:0 || yabai -m window --resize right:-100:0
ctrl + alt + cmd - right : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0
ctrl + alt + cmd - up    : yabai -m window --resize top:0:-100 || yabai -m window --resize bottom:0:-100
ctrl + alt + cmd - down  : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
ctrl + alt + cmd - h : yabai -m window --resize left:-100:0 || yabai -m window --resize right:-100:0
ctrl + alt + cmd - k : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0
ctrl + alt + cmd - u : yabai -m window --resize top:0:-100 || yabai -m window --resize bottom:0:-100
ctrl + alt + cmd - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100

# -- Fullscreen --
ctrl + alt - return : yabai -m window --toggle zoom-fullscreen

# -- Toggle split direction --
ctrl + alt - s : yabai -m window --toggle split

# -- Balance tree --
ctrl + alt - b : yabai -m space --balance

# -- Rotate tree --
ctrl + alt - o : yabai -m space --rotate 90

# -- Mirror tree --
ctrl + alt - x : yabai -m space --mirror x-axis
ctrl + alt - y : yabai -m space --mirror y-axis

# -- Toggle float + center (remembered per app/title) --
ctrl + alt - f : ~/.config/yabai/float-prefs toggle

# -- Stack windows --
ctrl + alt - d : yabai -m window --stack west
ctrl + alt - g : yabai -m space --layout $(yabai -m query --spaces --space | jq -r '.type' | grep -q 'bsp' && echo 'stack' || echo 'bsp')

# ============================================================
# Space management
# ============================================================

# -- Move window to different display (alt + cmd) --
# Capture window ID before moving to maintain focus
alt + cmd - 0x21 : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display prev; \
                   yabai -m display --focus prev; \
                   yabai -m window --focus "$win"  # alt+cmd+[

alt + cmd - 0x1E : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display next; \
                   yabai -m display --focus next; \
                   yabai -m window --focus "$win"  # alt+cmd+]

alt + cmd - left : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display 1; \
                   yabai -m display --focus 1; \
                   yabai -m window --focus "$win"  # alt+cmd+left

alt + cmd - right : win=$(yabai -m query --windows --window | jq -r '.id'); \
                    yabai -m window --display 2; \
                    yabai -m display --focus 2; \
                    yabai -m window --focus "$win"  # alt+cmd+right

# -- Projects: space shortcuts in active project (alt+shift) --
:: space_slot_mode @ : ~/.config/skhd/notify.sh "Space Shortcut" "Press 1-9 for Alt+Shift slot"
alt + shift - 0x18 ; space_slot_mode  # alt+shift+=
space_slot_mode < 1 : ~/.config/yabai/projects set-space-slot 1; skhd -k "escape"
space_slot_mode < 2 : ~/.config/yabai/projects set-space-slot 2; skhd -k "escape"
space_slot_mode < 3 : ~/.config/yabai/projects set-space-slot 3; skhd -k "escape"
space_slot_mode < 4 : ~/.config/yabai/projects set-space-slot 4; skhd -k "escape"
space_slot_mode < 5 : ~/.config/yabai/projects set-space-slot 5; skhd -k "escape"
space_slot_mode < 6 : ~/.config/yabai/projects set-space-slot 6; skhd -k "escape"
space_slot_mode < 7 : ~/.config/yabai/projects set-space-slot 7; skhd -k "escape"
space_slot_mode < 8 : ~/.config/yabai/projects set-space-slot 8; skhd -k "escape"
space_slot_mode < 9 : ~/.config/yabai/projects set-space-slot 9; skhd -k "escape"
space_slot_mode < escape ; default

:: clear_space_slot_mode @ : ~/.config/skhd/notify.sh "Clear Space Shortcut" "Press 1-9 to clear"
alt + shift - 0x1B ; clear_space_slot_mode  # alt+shift+-
clear_space_slot_mode < 1 : ~/.config/yabai/projects clear-space-slot 1; skhd -k "escape"
clear_space_slot_mode < 2 : ~/.config/yabai/projects clear-space-slot 2; skhd -k "escape"
clear_space_slot_mode < 3 : ~/.config/yabai/projects clear-space-slot 3; skhd -k "escape"
clear_space_slot_mode < 4 : ~/.config/yabai/projects clear-space-slot 4; skhd -k "escape"
clear_space_slot_mode < 5 : ~/.config/yabai/projects clear-space-slot 5; skhd -k "escape"
clear_space_slot_mode < 6 : ~/.config/yabai/projects clear-space-slot 6; skhd -k "escape"
clear_space_slot_mode < 7 : ~/.config/yabai/projects clear-space-slot 7; skhd -k "escape"
clear_space_slot_mode < 8 : ~/.config/yabai/projects clear-space-slot 8; skhd -k "escape"
clear_space_slot_mode < 9 : ~/.config/yabai/projects clear-space-slot 9; skhd -k "escape"
clear_space_slot_mode < escape ; default

alt + shift - h : ~/.config/yabai/projects cycle prev
alt + shift - k : ~/.config/yabai/projects cycle next

alt + shift - 1 : ~/.config/yabai/projects focus-space 1
alt + shift - 2 : ~/.config/yabai/projects focus-space 2
alt + shift - 3 : ~/.config/yabai/projects focus-space 3
alt + shift - 4 : ~/.config/yabai/projects focus-space 4
alt + shift - 5 : ~/.config/yabai/projects focus-space 5
alt + shift - 6 : ~/.config/yabai/projects focus-space 6
alt + shift - 7 : ~/.config/yabai/projects focus-space 7
alt + shift - 8 : ~/.config/yabai/projects focus-space 8
alt + shift - 9 : ~/.config/yabai/projects focus-space 9

alt + shift - 0x2C : ~/.config/yabai/projects show  # alt+shift+/

# -- Projects: hyper layer (ctrl+alt+cmd, caps hold) --
ctrl + alt + cmd - 1 : ~/.config/yabai/projects focus-project 1
ctrl + alt + cmd - 2 : ~/.config/yabai/projects focus-project 2
ctrl + alt + cmd - 3 : ~/.config/yabai/projects focus-project 3
ctrl + alt + cmd - 4 : ~/.config/yabai/projects focus-project 4
ctrl + alt + cmd - 5 : ~/.config/yabai/projects focus-project 5

ctrl + alt + cmd + shift - 1 : ~/.config/yabai/projects adopt --project-slot 1
ctrl + alt + cmd + shift - 2 : ~/.config/yabai/projects adopt --project-slot 2
ctrl + alt + cmd + shift - 3 : ~/.config/yabai/projects adopt --project-slot 3
ctrl + alt + cmd + shift - 4 : ~/.config/yabai/projects adopt --project-slot 4
ctrl + alt + cmd + shift - 5 : ~/.config/yabai/projects adopt --project-slot 5

ctrl + alt + cmd - a : ~/.config/yabai/projects adopt
ctrl + alt + cmd - 0x21 : ~/.config/yabai/projects cycle prev  # hyper+[
ctrl + alt + cmd - 0x1E : ~/.config/yabai/projects cycle next  # hyper+]
ctrl + alt + cmd - e : ~/.config/yabai/projects pick
ctrl + alt + cmd - p : ~/.config/yabai/projects pick
ctrl + alt + cmd - n : ~/.config/yabai/projects new
ctrl + alt + cmd + shift - 0x33 : ~/.config/yabai/projects detach  # hyper+shift+backspace

# -- Move window to new desktop --
ctrl + alt - n : app=$(yabai -m query --windows --window | jq -r '.app') && \
                 yabai -m space --create && \
                 idx=$(yabai -m query --spaces --display | jq 'map(select(."is-visible" == false)) | last | .index') && \
                 yabai -m window --space "$idx" && \
                 yabai -m space --focus "$idx" && \
                 yabai -m space --label "$app" && \
                 ~/.config/yabai/close_empty_spaces.sh

# -- Create new desktop and focus it --
alt - n : yabai -m space --create && \
          idx=$(yabai -m query --spaces --display | jq 'map(select(."is-visible" == false)) | last | .index') && \
          yabai -m space --focus "$idx"

# -- Close all empty desktops --
alt - k : ~/.config/yabai/close_empty_spaces.sh

# ============================================================
# App Focus (alt)
# ============================================================

alt - 0x32 : ~/.config/skhd/focus_app.sh "Ghostty"  # alt + backtick
alt - 1 : ~/bin/hotkeys app-focus 1 "@browser"
alt - 2 : ~/bin/hotkeys app-focus 2 "@editor"
alt - 3 : ~/bin/hotkeys app-focus 3 "Microsoft Teams"
alt - 4 : ~/bin/hotkeys app-focus 4 "Slack"
alt - 0x2A : ~/bin/hotkeys presentation toggle  # alt + backslash
alt + shift - 0x2A : ~/bin/hotkeys zen toggle  # alt+shift+backslash

alt + shift - 0x32 : ~/.config/skhd/focus_app.sh "Ghostty"  # alt + tilde

# ============================================================
# Window close / minimize
# ============================================================

ctrl + alt - w : yabai -m window --close
ctrl + alt - z : yabai -m window --minimize


# ============================================================
# Restart yabai + skhd
# ============================================================

alt - r : yabai --restart-service; skhd --restart-service

# ============================================================

# ============================================================
# Which-key cheat sheet (opt + /)
# ============================================================

alt - 0x2C : ~/.config/skhd/show_keys.sh

# ============================================================
# Window Management (ctrl + opt + <key>) — BSP tiling
# Caps Lock can be held as ctrl + opt + cmd via Karabiner-Elements.
# ============================================================

# -- Cycle through windows on current desktop --
alt - tab : yabai -m window --focus stack.next || yabai -m window --focus stack.first
shift + alt - tab : yabai -m window --focus stack.prev || yabai -m window --focus stack.last

# -- Set window to 50% split --
ctrl + alt - left  : ~/.config/skhd/snap_window.sh left
ctrl + alt - right : ~/.config/skhd/snap_window.sh right
ctrl + alt - h : ~/.config/skhd/snap_window.sh left
ctrl + alt - k : ~/.config/skhd/snap_window.sh right

# -- Swap windows --
ctrl + alt + shift - left  : yabai -m window --swap west
ctrl + alt + shift - right : yabai -m window --swap east
ctrl + alt + shift - up    : yabai -m window --swap north
ctrl + alt + shift - down  : yabai -m window --swap south
ctrl + alt + shift - h : yabai -m window --swap west
ctrl + alt + shift - k : yabai -m window --swap east
ctrl + alt + shift - u : yabai -m window --swap north
ctrl + alt + shift - j : yabai -m window --swap south

# -- Resize window incrementally --
ctrl + alt + cmd - left  : yabai -m window --resize left:-100:0 || yabai -m window --resize right:-100:0
ctrl + alt + cmd - right : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0
ctrl + alt + cmd - up    : yabai -m window --resize top:0:-100 || yabai -m window --resize bottom:0:-100
ctrl + alt + cmd - down  : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
ctrl + alt + cmd - h : yabai -m window --resize left:-100:0 || yabai -m window --resize right:-100:0
ctrl + alt + cmd - k : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0
ctrl + alt + cmd - u : yabai -m window --resize top:0:-100 || yabai -m window --resize bottom:0:-100
ctrl + alt + cmd - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100

# -- Fullscreen --
ctrl + alt - return : yabai -m window --toggle zoom-fullscreen

# -- Toggle split direction --
ctrl + alt - s : yabai -m window --toggle split

# -- Balance tree --
ctrl + alt - b : yabai -m space --balance

# -- Rotate tree --
ctrl + alt - o : yabai -m space --rotate 90

# -- Mirror tree --
ctrl + alt - x : yabai -m space --mirror x-axis
ctrl + alt - y : yabai -m space --mirror y-axis

# -- Toggle float + center --
ctrl + alt - f : yabai -m window --toggle float; \
                yabai -m window --grid 6:6:1:1:4:4

# -- Stack windows --
ctrl + alt - d : yabai -m window --stack west
ctrl + alt - g : yabai -m space --layout $(yabai -m query --spaces --space | jq -r '.type' | grep -q 'bsp' && echo 'stack' || echo 'bsp')

# ============================================================
# Space management
# ============================================================

# -- Move window to different display (alt + cmd) --
# Capture window ID before moving to maintain focus
alt + cmd - 0x21 : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display prev; \
                   yabai -m display --focus prev; \
                   yabai -m window --focus "$win"  # alt+cmd+[

alt + cmd - 0x1E : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display next; \
                   yabai -m display --focus next; \
                   yabai -m window --focus "$win"  # alt+cmd+]

alt + cmd - left : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display 1; \
                   yabai -m display --focus 1; \
                   yabai -m window --focus "$win"  # alt+cmd+left

alt + cmd - right : win=$(yabai -m query --windows --window | jq -r '.id'); \
                    yabai -m window --display 2; \
                    yabai -m display --focus 2; \
                    yabai -m window --focus "$win"  # alt+cmd+right

# -- Space Bookmarking (yabai spaces) --
# -- Jump to bookmarked space (alt+shift+number) --
alt + shift - 1 : ~/.config/yabai/bookmarks jump 1
alt + shift - 2 : ~/.config/yabai/bookmarks jump 2
alt + shift - 3 : ~/.config/yabai/bookmarks jump 3
alt + shift - 4 : ~/.config/yabai/bookmarks jump 4
alt + shift - 5 : ~/.config/yabai/bookmarks jump 5

# -- Show pinned bookmarks notification (alt+shift+/) --
alt + shift - 0x2C : ~/.config/yabai/bookmarks show  # alt+shift+/

# -- Focus prev/next space --
alt + shift - h : yabai -m space --focus prev
alt + shift - k : yabai -m space --focus next

# -- Move window to space --
ctrl + alt + shift - 1 : yabai -m window --space 1
ctrl + alt + shift - 2 : yabai -m window --space 2
ctrl + alt + shift - 3 : yabai -m window --space 3
ctrl + alt + shift - 4 : yabai -m window --space 4
ctrl + alt + shift - 5 : yabai -m window --space 5

# -- Move window to new desktop --
ctrl + alt - n : app=$(yabai -m query --windows --window | jq -r '.app') && \
                 yabai -m space --create && \
                 idx=$(yabai -m query --spaces --display | jq 'map(select(."is-visible" == false)) | last | .index') && \
                 yabai -m window --space "$idx" && \
                 yabai -m space --focus "$idx" && \
                 yabai -m space --label "$app" && \
                 ~/.config/yabai/close_empty_spaces.sh

# -- Create new desktop and focus it --
alt - n : yabai -m space --create && \
          idx=$(yabai -m query --spaces --display | jq 'map(select(."is-visible" == false)) | last | .index') && \
          yabai -m space --focus "$idx"

# -- Close all empty desktops --
alt - k : ~/.config/yabai/close_empty_spaces.sh

# ============================================================
# App Focus (alt)
# ============================================================

alt - 0x32 : ~/.config/skhd/focus_app.sh "Ghostty"  # alt + backtick
alt - 1 : ~/.config/skhd/focus_app.sh "@browser"
alt - 2 : ~/.config/skhd/focus_app.sh "@editor"
alt - 3 : ~/.config/skhd/focus_app.sh "Microsoft Teams"
alt - 4 : ~/.config/skhd/focus_app.sh "Slack"
alt - 0x2A : ~/bin/hotkeys presentation toggle  # alt + backslash

alt + shift - 0x32 : ~/.config/skhd/focus_app.sh "Ghostty"  # alt + tilde

# ============================================================
# Window close / minimize
# ============================================================

ctrl + alt - w : yabai -m window --close
ctrl + alt - z : yabai -m window --minimize


# ============================================================
# Restart yabai + skhd
# ============================================================

alt - r : yabai --restart-service; skhd --restart-service

# ============================================================

# ============================================================
# Which-key cheat sheet (opt + /)
# ============================================================

alt - 0x2C : ~/.config/skhd/show_keys.sh

# ============================================================
# Hyperspace (hyper = ctrl + alt + cmd via Karabiner)
# ============================================================

:: hyper_pinned @ : osascript -e 'display notification "Press 1-9 for hyperspace slot" with title "Hyperspace"'
ctrl + alt + cmd + shift - 0x18 ; hyper_pinned
hyper_pinned < 1 : hyperspace pin 1; skhd -k "escape"
hyper_pinned < 2 : hyperspace pin 2; skhd -k "escape"
hyper_pinned < 3 : hyperspace pin 3; skhd -k "escape"
hyper_pinned < 4 : hyperspace pin 4; skhd -k "escape"
hyper_pinned < 5 : hyperspace pin 5; skhd -k "escape"
hyper_pinned < 6 : hyperspace pin 6; skhd -k "escape"
hyper_pinned < 7 : hyperspace pin 7; skhd -k "escape"
hyper_pinned < 8 : hyperspace pin 8; skhd -k "escape"
hyper_pinned < 9 : hyperspace pin 9; skhd -k "escape"
hyper_pinned < escape ; default

:: hyper_unpin @ : osascript -e 'display notification "Press 1-9 to unpin hyperspace" with title "Hyperspace"'
ctrl + alt + cmd - 0x1B ; hyper_unpin
hyper_unpin < 1 : hyperspace unpin 1; skhd -k "escape"
hyper_unpin < 2 : hyperspace unpin 2; skhd -k "escape"
hyper_unpin < 3 : hyperspace unpin 3; skhd -k "escape"
hyper_unpin < 4 : hyperspace unpin 4; skhd -k "escape"
hyper_unpin < 5 : hyperspace unpin 5; skhd -k "escape"
hyper_unpin < 6 : hyperspace unpin 6; skhd -k "escape"
hyper_unpin < 7 : hyperspace unpin 7; skhd -k "escape"
hyper_unpin < 8 : hyperspace unpin 8; skhd -k "escape"
hyper_unpin < 9 : hyperspace unpin 9; skhd -k "escape"
hyper_unpin < escape ; default

ctrl + alt + cmd - 1 : hyperspace connect 1
ctrl + alt + cmd - 2 : hyperspace connect 2
ctrl + alt + cmd - 3 : hyperspace connect 3
ctrl + alt + cmd - 4 : hyperspace connect 4
ctrl + alt + cmd - 5 : hyperspace connect 5
ctrl + alt + cmd - 6 : hyperspace connect 6
ctrl + alt + cmd - 7 : hyperspace connect 7
ctrl + alt + cmd - 8 : hyperspace connect 8
ctrl + alt + cmd - 9 : hyperspace connect 9
ctrl + alt + cmd - space : hyperspace search
ctrl + alt + cmd - n : ~/.config/skhd/modules/hyperspace/open_spotlight_scratchpad

# ============================================================
# Global Option layer — app focus, spaces, windows, and HUD controls.
# Hyper (ctrl+opt+cmd) is deliberately reserved and has no active bindings.
# ============================================================

# -- Cycle through windows on current desktop --
alt - tab : yabai -m window --focus stack.next || yabai -m window --focus stack.first
shift + alt - tab : yabai -m window --focus stack.prev || yabai -m window --focus stack.last

# -- Set window to 50% split --
ctrl + alt - left  : ~/.config/skhd/snap_window.sh left
ctrl + alt - right : ~/.config/skhd/snap_window.sh right
ctrl + alt - h : ~/.config/skhd/snap_window.sh left
ctrl + alt - k : ~/.config/skhd/snap_window.sh right

# -- Swap windows --
ctrl + alt + shift - left  : yabai -m window --swap west
ctrl + alt + shift - right : yabai -m window --swap east
ctrl + alt + shift - up    : yabai -m window --swap north
ctrl + alt + shift - down  : yabai -m window --swap south
ctrl + alt + shift - h : yabai -m window --swap west
ctrl + alt + shift - k : yabai -m window --swap east
ctrl + alt + shift - u : yabai -m window --swap north
ctrl + alt + shift - j : yabai -m window --swap south

# -- Resize window incrementally (Option+Shift) --
alt + shift - left  : yabai -m window --resize left:-100:0 || yabai -m window --resize right:-100:0
alt + shift - right : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0
alt + shift - up    : yabai -m window --resize top:0:-100 || yabai -m window --resize bottom:0:-100
alt + shift - down  : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
alt + shift - h : yabai -m window --resize left:-100:0 || yabai -m window --resize right:-100:0
alt + shift - k : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0
alt + shift - u : yabai -m window --resize top:0:-100 || yabai -m window --resize bottom:0:-100
alt + shift - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100

# -- Fullscreen --
ctrl + alt - return : yabai -m window --toggle zoom-fullscreen

# -- Toggle split direction --
ctrl + alt - s : yabai -m window --toggle split

# -- Balance tree --
ctrl + alt - b : yabai -m space --balance

# -- Rotate tree --
ctrl + alt - o : yabai -m space --rotate 90

# -- Mirror tree --
ctrl + alt - x : yabai -m space --mirror x-axis
ctrl + alt - y : yabai -m space --mirror y-axis

# -- Toggle float + center (remembered per app/title) --
ctrl + alt - f : ~/.config/yabai/float-prefs toggle

# -- Stack windows --
ctrl + alt - d : yabai -m window --stack west
ctrl + alt - g : yabai -m space --layout $(yabai -m query --spaces --space | jq -r '.type' | grep -q 'bsp' && echo 'stack' || echo 'bsp')

# ============================================================
# Space management
# ============================================================

# -- Move window to previous/next display (Option+Shift+[ / ]) --
# Capture window ID before moving to maintain focus
alt + shift - 0x21 : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display prev; \
                   yabai -m display --focus prev; \
                   yabai -m window --focus "$win"  # alt+shift+[

alt + shift - 0x1E : win=$(yabai -m query --windows --window | jq -r '.id'); \
                   yabai -m window --display next; \
                   yabai -m display --focus next; \
                   yabai -m window --focus "$win"  # alt+shift+]

# ProjectDeck and system-wide project-context shortcuts are intentionally
# dormant. The projects CLI and manual ProjectDeck build remain available.

# -- Move window to new desktop --
ctrl + alt - n : ~/.config/yabai/create-space move-window

# -- Create new desktop, moving the focused non-scratchpad window if present --
alt - n : ~/.config/yabai/create-space auto

# -- Close all empty desktops --
alt - k : ~/.config/yabai/close_empty_spaces.sh

# ============================================================
# App Focus (alt)
# ============================================================

alt - 0x32 : ~/.config/skhd/focus_app.sh "Ghostty"  # alt + backtick
alt - 1 : ~/bin/hotkeys app-focus 1 "@browser"
# alt - 2 : ~/bin/hotkeys app-focus 2 "Codex"
alt - 3 : ~/bin/hotkeys app-focus 2 "@editor"
alt - 4 : ~/bin/hotkeys app-focus 3 "Microsoft Teams"
alt - 5 : ~/bin/hotkeys app-focus 4 "Slack"

fn - 0x2B : ~/bin/scratchpads open codex  # fn + comma
fn - 1 : ~/bin/scratchpads open projects  # fn + 1
alt - 0x2A : ~/bin/hotkeys presentation toggle  # alt + backslash
alt + shift - 0x2A : ~/bin/hotkeys zen toggle  # alt+shift+backslash

alt + shift - 0x32 : ~/bin/hotkeys terminal new  # alt + shift + backtick

# -- Ghostty management (right Command) --
# Keep left Command application-local. These right-Command chords only emit
# synthetic function keys while Ghostty is focused; every other app receives
# the original chord unchanged.
rcmd - d [
    "Ghostty" : skhd -k "f16"  # Duplicate current tmux window
    * ~
]

rcmd - r [
    "Ghostty" : skhd -k "f17"  # Rename current tmux window
    * ~
]

rcmd - s [
    "Ghostty" : skhd -k "f18"  # Open tmux session picker
    * ~
]

rcmd - space [
    "Ghostty" : skhd -k "f19"  # Open tmux command center
    * ~
]

# ============================================================
# Fn is reserved for transient scratchpads. Use native Cmd+Shift+3/4 for
# screenshots rather than duplicating them on this layer.
# ============================================================

# ============================================================
# Window close / minimize
# ============================================================

ctrl + alt - w : yabai -m window --close
ctrl + alt - z : yabai -m window --minimize


# ============================================================
# Restart yabai + skhd
# ============================================================

alt - r : yabai --restart-service; skhd --restart-service

# ============================================================

# ============================================================
# Interactive shortcut guide (opt + /)
# ============================================================

alt - 0x2C : ~/.config/skhd/show_keys.sh

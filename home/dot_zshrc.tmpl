# Daily-driver zsh configuration
# Rendered by chezmoi as a Go template: literal double curly braces must be
# escaped or they will break rendering.
# man-me: name=y
# man-me: category=Terminal and Sessions
# man-me: usage=y [ARG ...]
# man-me: description=Run Yazi and cd the parent shell to Yazi's final directory.
# man-me: tags=yazi shell terminal cd file-manager
typeset -U path fpath
path=("$HOME/.local/bin" "/opt/homebrew/opt/openjdk/bin" $path)
export PATH
export EDITOR={{ .preferences.terminalEditor }}
export MANPAGER="sh -c 'col -bx | bat --paging=always -l man -p'"

# Keep secrets and machine-specific env out of the repo.
[ -f "$HOME/.zshrc.secrets" ] && source "$HOME/.zshrc.secrets"

# Zsh plugins
[ -r "$HOME/.config/zsh/zshrc.commands" ] && source "$HOME/.config/zsh/zshrc.commands"
ANTIGEN_ZSH=""
for antigen_zsh in "$HOME/antigen.zsh" /opt/homebrew/share/antigen/antigen.zsh /usr/local/share/antigen/antigen.zsh; do
    if [ -r "$antigen_zsh" ]; then
        ANTIGEN_ZSH="$antigen_zsh"
        break
    fi
done
unset antigen_zsh

if [ -n "$ANTIGEN_ZSH" ]; then
    source "$ANTIGEN_ZSH"
    antigen bundle zsh-users/zsh-autosuggestions
    antigen bundle zsh-users/zsh-completions
    antigen bundle zsh-users/zsh-history-substring-search
    antigen bundle zsh-users/zsh-syntax-highlighting
    antigen apply
else
    print -u2 "zsh: antigen not found; skipping zsh plugins"
fi
unset ANTIGEN_ZSH

# Starship prompt
export STARSHIP_CONFIG="$HOME/.config/starship.toml"
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

if (( $+widgets[history-substring-search-up] )); then
    bindkey '^[[A' history-substring-search-up # or '\eOA'
    bindkey '^[[B' history-substring-search-down # or '\eOB'
    HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
fi

# Word movement. Ghostty/macOS may emit either Meta-b/f or CSI sequences.
bindkey '\eb' backward-word
bindkey '\ef' forward-word
bindkey '\e[1;3D' backward-word
bindkey '\e[1;3C' forward-word
bindkey '\e[1;9D' backward-word
bindkey '\e[1;9C' forward-word
bindkey '\e[3D' backward-word
bindkey '\e[3C' forward-word

# Docker completions
fpath=("$HOME/.docker/completions" $fpath)
autoload -Uz compinit
compinit
[ -r "$HOME/.config/zsh/acli-completions" ] && source "$HOME/.config/zsh/acli-completions"

# Basic aliases
alias python=python3

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
path=("$BUN_INSTALL/bin" $path)
alias ports='sudo lsof -i -n -P | grep LISTEN'
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Keep Yazi in sync if you drop to a shell from inside Yazi.
if [[ -n "$YAZI_ID" ]]; then
	function _yazi_cd() {
		ya emit cd "$PWD"
	}
	autoload -Uz add-zsh-hook
	add-zsh-hook zshexit _yazi_cd
fi
if command -v mise >/dev/null 2>&1; then
	eval "$(mise activate zsh)"
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion


if [ -x /opt/homebrew/bin/terraform ]; then
	autoload -U +X bashcompinit && bashcompinit
	complete -o nospace -C /opt/homebrew/bin/terraform terraform
fi

# vapi
export VAPI_INSTALL="$HOME/.vapi"
path=("$VAPI_INSTALL/bin" $path)
export MANPATH=""$HOME/.vapi"/share/man:$MANPATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
path=("$PNPM_HOME" $path)
# pnpm end

# Optional sesh/tmux session-manager bindings are rendered by the
# tmux-sessions module. The guard keeps shell startup valid after disable or
# physical removal.
[ -r "$HOME/.config/zsh/tmux-sessions.zsh" ] && source "$HOME/.config/zsh/tmux-sessions.zsh"

# Tmux aliases
alias ta='tmux attach -t'
alias tad='tmux attach -d -t'
alias ts='tmux new-session -s'
alias tl='tmux list-sessions'
alias tksv='tmux kill-server'
alias tkss='tmux kill-session -t'

path=("$HOME/bin" $path)
alias roigin="origin"

if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init zsh)"
fi

# Some tools assign PATH directly after zsh's unique-array setup.
typeset -U path fpath

# tmux integration - send save-buffer command
keybind = cmd+s=text:\x01\x73

# tmux Yazi launchers - send prefix + b/B
keybind = cmd+b=text:\x01\x62
keybind = cmd+shift+b=text:\x01\x42

# tmux scratchpad window switching - send prefix + target
keybind = cmd+backquote=text:\x01\x30
keybind = cmd+digit_1=text:\x01\x31
keybind = cmd+1=text:\x01\x31
keybind = cmd+digit_2=text:\x01\x32
keybind = cmd+2=text:\x01\x32

# Distinguish Ctrl+Shift+0/1/2 from Ctrl+0/1/2 for tmux type creation.
keybind = ctrl+shift+digit_0=csi:48;6u
keybind = ctrl+shift+0=csi:48;6u
keybind = ctrl+shift+digit_1=csi:49;6u
keybind = ctrl+shift+1=csi:49;6u
keybind = ctrl+shift+digit_2=csi:50;6u
keybind = ctrl+shift+2=csi:50;6u

# aesthetics
# theme = Cyberpunk Scarlet Protocol
background-blur = false
background-opacity = 0.86
background=#000000
macos-titlebar-style = hidden

# typography
font-size=16
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1

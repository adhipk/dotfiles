#!/bin/bash
# man-me: name=mark
# man-me: category=Development and Repo
# man-me: usage=commands/mark <text>
# man-me: description=Append a quick note to ~/notes/marks.md from the repository-local command.
# man-me: tags=notes mark command repo utility

# 1. Check if an argument was actually provided
if [ -z "$1" ]; then
  echo "Usage: mark <text>"
  exit 1
fi

# 2. Use quotes around variables to handle spaces/special chars
# 3. Ensure the directory exists before writing
mkdir -p ~/notes
echo "$1" >> ~/notes/marks.md
